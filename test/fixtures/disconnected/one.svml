<svml version="1">
  <import from="../../../stdlib/speech-assemble.svk"/>
  <import from="../../../stdlib/speech-locator.svk"/>
  <import from="../../../stdlib/ranking-column.svk"/>
  <import from="../../../stdlib/film.svk"/>

  <script>
    <segment id="main">@pick Alpha @/pick gap @pick omega @/pick.</segment>
  </script>

  <video id="avatar" src="../presentation/long.mp4"/>
  <audio id="voice-audio" src="../presentation/long.mp4"/>
  <image id="icon" src="../collision/left/image.png"/>
  <alignment id="alignment" src="./alignment.json"/>

  <speech-assemble id="speech" fps="30">
    <segment id="main" script={script.segment.main} visual={avatar} audio={voice-audio} sourceWindow="0s .. 3s"/>
  </speech-assemble>
  <speech-locator id="location" script={script} basis={speech.production} evidence={alignment}/>

  <ranking-column id="ranking" z="1">
    <item id="picked" rank="1" image={icon} during={script.selection.pick}/>
  </ranking-column>

  <film id="film" basis={speech.production} semantic={location.map}>
    <track ref={ranking.track}/>
  </film>
</svml>
