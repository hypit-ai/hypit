<kernel
  name="artifact-film"
  abi="1"
  root="true"
  implementation="./artifact-film.mjs"
>
  <port name="image" direction="input" type="Image" cardinality="one"/>
  <port name="basis" direction="input" type="TemporalBasisProduction" cardinality="one"/>
  <port name="semantic" direction="input" type="CompleteSemanticMap" cardinality="one"/>
  <port name="document" direction="output" type="HyperframesDocument" cardinality="one"/>
</kernel>
