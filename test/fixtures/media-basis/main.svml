<svml version="1">
  <import from="../../../stdlib/media-basis.svk"/>
  <import from="../../../stdlib/speech-locator.svk"/>
  <import from="../../../stdlib/film.svk"/>

  <script><segment id="main">Hello.</segment></script>
  <video id="visual" src="../collision/avatar.mp4"/>
  <audio id="audio" src="../collision/avatar.mp4"/>
  <timing id="timing" src="../artifacts/alignment.json"/>

  <media-basis id="program" visual={visual} audio={audio} duration="1s"/>
  <speech-locator id="location" script={script} basis={program.production} evidence={timing}/>
  <film id="film" basis={program.production} semantic={location.map}/>
</svml>
