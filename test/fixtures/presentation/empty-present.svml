<svml version="1">
  <import from="../../../stdlib/speech-assemble.svk"/>
  <import from="../../../stdlib/speech-locator.svk"/>
  <import from="../../../stdlib/media-track.svk"/>
  <import from="../../../stdlib/film.svk"/>

  <script>
    <segment id="main">
      One @pop! two three.
    </segment>
  </script>

  <video id="long-video" src="./long.mp4"/>
  <audio id="voice-audio" src="./long.mp4"/>
  <timing id="timing" src="./alignment.json"/>

  <speech-assemble id="speech" fps="30">
    <segment id="main" script={script.segment.main} visual={long-video} audio={voice-audio} sourceWindow="0s .. 3s"/>
  </speech-assemble>
  <speech-locator id="location" script={script} basis={speech.production} evidence={timing}/>

  <media-track id="aroll" z="200">
    <item id="host" source={long-video} during="full">
      <present id="outside" during="end+1s .. end+2s" z="230"/>
    </item>
  </media-track>

  <film id="presentation" basis={speech.production} semantic={location.map}>
    <track ref={aroll.track}/>
  </film>
</svml>
