<svml version="1">
  <import from="../../../stdlib/speech-assemble.svk"/>
  <import from="../../../stdlib/speech-locator.svk"/>
  <import from="../../../stdlib/broll-track.svk"/>
  <import from="../../../stdlib/film.svk"/>

  <script>
    <segment id="main">
      @left Left @/left and @right right @/right.
    </segment>
  </script>

  <video id="avatar" src="./avatar.mp4"/>
  <audio id="voice-audio" src="./avatar.mp4"/>
  <timing id="timing" src="./alignment.json"/>
  <image id="left-image" src="./left/image.png"/>
  <image id="right-image" src="./right/image.png"/>

  <speech-assemble id="speech" fps="30">
    <segment id="main" script={script.segment.main} visual={avatar} audio={voice-audio} sourceWindow="0s .. 2s"/>
  </speech-assemble>

  <speech-locator id="location" script={script} basis={speech.production} evidence={timing}/>

  <broll-track id="broll" z="100">
    <item id="left" source={left-image} during={script.selection.left}/>
    <item id="right" source={right-image} during={script.selection.right}/>
    <transition from="left" to="right" kind="crossfade" duration="200ms"/>
  </broll-track>

  <film id="collision" basis={speech.production} semantic={location.map}>
    <track ref={broll.track}/>
  </film>
</svml>
