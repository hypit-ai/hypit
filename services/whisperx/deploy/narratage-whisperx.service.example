[Unit]
Description=SVML WhisperX alignment service
After=network.target

[Service]
Type=simple
User=narratage
WorkingDirectory=/opt/narratage
Environment=NARRATAGE_WHISPERX_PORT=8765
Environment=NARRATAGE_WHISPERX_MODEL=small
Environment=NARRATAGE_WHISPERX_DEVICE=cpu
Environment=NARRATAGE_WHISPERX_COMPUTE=int8
Environment=NARRATAGE_WHISPERX_BATCH_SIZE=8
Environment=NARRATAGE_WHISPERX_INPUT_ROOTS=/tmp
Environment=NARRATAGE_WHISPERX_NLTK_DATA=/var/cache/narratage/whisperx/nltk_data
Environment=OMP_NUM_THREADS=2
Environment=TORCH_FORCE_NO_WEIGHTS_ONLY_LOAD=1
Environment=HTTP_PROXY=
Environment=HTTPS_PROXY=
Environment=ALL_PROXY=
ExecStartPre=/opt/narratage/services/whisperx/.venv/bin/narratage-whisperx-check
ExecStart=/opt/narratage/services/whisperx/.venv/bin/narratage-whisperx-service
Restart=on-failure
RestartSec=5
TimeoutStopSec=30

[Install]
WantedBy=multi-user.target
