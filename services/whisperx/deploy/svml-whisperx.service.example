[Unit]
Description=SVML WhisperX alignment service
After=network.target

[Service]
Type=simple
User=svml
WorkingDirectory=/opt/svml
Environment=SVML_WHISPERX_PORT=8765
Environment=SVML_WHISPERX_MODEL=small
Environment=SVML_WHISPERX_DEVICE=cpu
Environment=SVML_WHISPERX_COMPUTE=int8
Environment=SVML_WHISPERX_BATCH_SIZE=8
Environment=SVML_WHISPERX_INPUT_ROOTS=/tmp
Environment=SVML_WHISPERX_NLTK_DATA=/var/cache/svml/whisperx/nltk_data
Environment=OMP_NUM_THREADS=2
Environment=TORCH_FORCE_NO_WEIGHTS_ONLY_LOAD=1
Environment=HTTP_PROXY=
Environment=HTTPS_PROXY=
Environment=ALL_PROXY=
ExecStartPre=/opt/svml/services/whisperx/.venv/bin/svml-whisperx-check
ExecStart=/opt/svml/services/whisperx/.venv/bin/svml-whisperx-service
Restart=on-failure
RestartSec=5
TimeoutStopSec=30

[Install]
WantedBy=multi-user.target
