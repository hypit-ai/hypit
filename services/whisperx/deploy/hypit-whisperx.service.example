[Unit]
Description=SVML WhisperX alignment service
After=network.target

[Service]
Type=simple
User=hypit
WorkingDirectory=/opt/hypit
Environment=HYPIT_WHISPERX_PORT=8765
Environment=HYPIT_WHISPERX_MODEL=small
Environment=HYPIT_WHISPERX_DEVICE=cpu
Environment=HYPIT_WHISPERX_COMPUTE=int8
Environment=HYPIT_WHISPERX_BATCH_SIZE=8
Environment=HYPIT_WHISPERX_INPUT_ROOTS=/tmp
Environment=HYPIT_WHISPERX_NLTK_DATA=/var/cache/hypit/whisperx/nltk_data
Environment=OMP_NUM_THREADS=2
Environment=TORCH_FORCE_NO_WEIGHTS_ONLY_LOAD=1
Environment=HTTP_PROXY=
Environment=HTTPS_PROXY=
Environment=ALL_PROXY=
ExecStartPre=/opt/hypit/services/whisperx/.venv/bin/hypit-whisperx-check
ExecStart=/opt/hypit/services/whisperx/.venv/bin/hypit-whisperx-service
Restart=on-failure
RestartSec=5
TimeoutStopSec=30

[Install]
WantedBy=multi-user.target
