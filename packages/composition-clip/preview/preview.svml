<?svml using="@hypit/markup@1"?>
<svml>
  <import as="media" from="@hypit/media@1"/>
  <import as="time" from="@hypit/timeline-author@1"/>
  <import as="space" from="@hypit/spatial@1"/>
  <import as="visual" from="@hypit/visual-track@1"/>
  <import as="film" from="@hypit/film@1"/>
  <import as="nest" from="@hypit/composition-clip@1"/>
  <import as="html" from="@hypit/html-video@1"/>
  <import as="recipes" source="./recipes.svs"/>

  <media:WorkingPicture id="working-picture" color-primaries="bt709"
    color-transfer="srgb" reference-white-nits="100"/>
  <space:Canvas id="canvas" width="640" height="360"/>
  <space:Frame id="full" within={canvas.bounds} left="0%" top="0%" right="100%" bottom="100%"/>
  <space:Extent id="picture-size" width="640" height="360"/>
  <media:Image id="picture" src="../../visual-track/preview/rounded.png"/>
  <time:Clock id="clock" frame-rate="30"/>

  <time:Timeline id="child-time" clock={clock} end="1s"/>
  <visual:Track id="child-picture" timeline={child-time.timeline}>
    <visual:Clip id="picture" image={picture} picture="srgb" extent={picture-size}
      during={child-time.window} frame={full} fit="cover"/>
  </visual:Track>
  <film:Film id="child" canvas={canvas.canvas} timeline={child-time.timeline}
    appearance={recipes.film.child} picture={working-picture}>
    <film:Track id="child-picture" source={child-picture.visual}/>
  </film:Film>

  <time:Timeline id="program" clock={clock} end="2s">
    <time:Window id="chapter" from="start" until="end"/>
  </time:Timeline>
  <nest:Occurrence id="chapter-use" timeline={program.timeline}
    source={child.composition} during={program.chapter}/>
  <nest:Visual id="chapter-picture" timeline={program.timeline}
    picture={working-picture} occurrence={chapter-use.occurrence} frame={full}/>
  <nest:Audio id="chapter-sound" timeline={program.timeline}
    occurrence={chapter-use.occurrence} gain="1" fade-in="0f" fade-out="0f"/>
  <film:Film id="main" canvas={canvas.canvas} timeline={program.timeline}
    appearance={recipes.film.parent} picture={working-picture}>
    <film:Track id="chapter" source={chapter-picture.visual}/>
    <film:Track source={chapter-sound.audio}/>
  </film:Film>
  <html:Video id="final" composition={main.composition}/>
</svml>
