{
  "name": "@hypit/media-asset",
  "version": "0.1.0",
  "description": "Portable author documents for media accepted into a Hypit project",
  "license": "SEE LICENSE IN LICENSE",
  "type": "module",
  "exports": {
    ".": {
      "hypit-source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./node": {
      "hypit-source": "./src/node/index.ts",
      "types": "./dist/node/index.d.ts",
      "import": "./dist/node/index.js"
    },
    "./service": {
      "hypit-source": "./src/service/index.ts",
      "types": "./dist/service/index.d.ts",
      "import": "./dist/service/index.js"
    },
    "./service/node": {
      "hypit-source": "./src/service/node/index.ts",
      "types": "./dist/service/node/index.d.ts",
      "import": "./dist/service/node/index.js"
    }
  },
  "files": ["dist", "README.md"],
  "scripts": {
    "build": "tsc -p tsconfig.build.json"
  },
  "dependencies": {
    "@hypit/media": "workspace:^0.1.0",
    "@hypit/temporal": "workspace:^0.1.0"
  }
