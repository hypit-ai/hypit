{
  "name": "@hypit/nle-studio",
  "version": "0.1.0",
  "description": "NLE Product Session backend and browser client for Hypit",
  "license": "SEE LICENSE IN LICENSE",
  "type": "module",
  "bin": {
    "hypit-nle-studio": "./dist/server.js"
  },
  "exports": {
    ".": {
      "hypit-source": "./src/host.ts",
      "types": "./dist/host.d.ts",
      "import": "./dist/host.js"
    },
    "./protocol": {
      "hypit-source": "./src/protocol.ts",
      "types": "./dist/protocol.d.ts",
      "import": "./dist/protocol.js"
    },
    "./node": {
      "hypit-source": "./src/node-adapter.ts",
      "types": "./dist/node-adapter.d.ts",
      "import": "./dist/node-adapter.js"
    }
  },
  "files": ["dist", "README.md"],
  "scripts": {
    "build": "tsc -p tsconfig.build.json && tsc -p tsconfig.browser.json --noEmit && vite build",
    "start": "node dist/server.js"
  },
  "dependencies": {
    "@hypit/application": "workspace:^0.1.0",
    "@hypit/media": "workspace:^0.1.0",
    "@hypit/media-asset": "workspace:^0.1.0",
    "@hypit/media-local": "workspace:^0.1.0",
    "@hypit/nle": "workspace:^0.1.0",
    "@hypit/project": "workspace:^0.1.0",
    "@hypit/temporal": "workspace:^0.1.0",
    "@base-ui/react": "^1.9.0",
    "@fontsource-variable/hanken-grotesk": "^5.3.0",
    "lucide-react": "^0.468.0",
    "motion": "^12.23.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "vite": "^7.1.0"
  }
}
