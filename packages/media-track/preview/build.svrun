<?svml using="@hypit/run-markup@1"?>

<svrun version="1">
  <author source="./preview.svml"/>
  <import from="@hypit/stand-in@1" as="stand-in"/>
  <import from="@hypit/semantic-take-estimate@1" as="estimate"/>
  <target output="final.video"/>
  <fragment id="take-card" using="stand-in:timed-card">
    <input name="canvas" from="vertical"/>
    <input name="duration" value="8"/>
    <input name="clock" from="clock"/>
  </fragment>
  <fragment id="motion-a-card" using="stand-in:timed-card">
    <input name="canvas" from="vertical"/>
    <input name="duration" value="5"/>
    <input name="clock" from="clock"/>
  </fragment>
  <fragment id="motion-b-card" using="stand-in:timed-card">
    <input name="canvas" from="vertical"/>
    <input name="duration" value="5"/>
    <input name="clock" from="clock"/>
  </fragment>
  <satisfy output="take.video" candidate="take-card.video"/>
  <satisfy output="motion-a.video" candidate="motion-a-card.video"/>
  <satisfy output="motion-b.video" candidate="motion-b-card.video"/>
  <fragment id="take-timing" using="estimate:semantic-take">
    <input name="narrative" from="story"/>
    <input name="segment" from="story.segment.showcase"/>
    <input name="media" from="take-preview-media.media"/>
    <input name="policy" from="showcase-estimated.policy"/>
  </fragment>
  <satisfy output="showcase-semantic.take" candidate="take-timing.take"/>
</svrun>
