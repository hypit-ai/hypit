module prompt from "@hypit/prompt"

prompt.Template "camera-reference-v1" {
  separator: paragraph

  fixed "subject" {
    text: "Use @image1 as the subject and preserve the subject's identity, outfit, and physical features."
  }

  fixed "transfer" {
    text: <<PROMPT
Replicate @video1's camera framing, lens choice, camera height, movement, and photographic rhythm, applying that camera language to the subject from @image1 in a coherent setting.
    PROMPT
  }

  fixed "exclude" {
    text: <<PROMPT
Do not copy @video1's subject pose or body action. Let the subject move naturally for the transferred camera treatment.
    PROMPT
  }

  slot "direction" {
    required: false
    label: "ADDITIONAL DIRECTION:"
  }
}
