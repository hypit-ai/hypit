module prompt from "@hypit/prompt@1"

prompt.Template "motion-reference-v1" {
  separator: paragraph

  fixed "subject" {
    text: "Use @image1 as the subject and preserve the subject's identity, outfit, and physical features."
  }

  fixed "transfer" {
    text: <<PROMPT
Replicate the body motion, gestures, and pose dynamics from @video1 exactly. The subject from @image1 performs that motion in their own setting.
    PROMPT
  }

  fixed "exclude" {
    text: <<PROMPT
Do not copy @video1's camera framing or lens. Let the camera move naturally to capture the transferred action.
    PROMPT
  }

  slot "direction" {
    required: false
    label: "ADDITIONAL DIRECTION:"
  }
}
