{
  "name": "@hypit/hypit",
  "version": "0.1.0",
  "description": "Federated, modular, local-first video production system",
  "license": "SEE LICENSE IN LICENSE",
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=24.0.0"
  },
  "bin": {
    "hypit": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "hypit-source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./audio/program": {
      "hypit-source": "./src/audio-program.ts",
      "types": "./dist/audio-program.d.ts",
      "import": "./dist/audio-program.js"
    },
    "./application": {
      "hypit-source": "./src/application.ts",
      "types": "./dist/application.d.ts",
      "import": "./dist/application.js"
    },
    "./application/node": {
      "hypit-source": "./src/application-node.ts",
      "types": "./dist/application-node.d.ts",
      "import": "./dist/application-node.js"
    },
    "./execution": {
      "hypit-source": "./src/execution.ts",
      "types": "./dist/execution.d.ts",
      "import": "./dist/execution.js"
    },
    "./execution/node": {
      "hypit-source": "./src/execution-node.ts",
      "types": "./dist/execution-node.d.ts",
      "import": "./dist/execution-node.js"
    },
    "./media": {
      "hypit-source": "./src/media.ts",
      "types": "./dist/media.d.ts",
      "import": "./dist/media.js"
    },
    "./media/asset": {
      "hypit-source": "./src/media-asset.ts",
      "types": "./dist/media-asset.d.ts",
      "import": "./dist/media-asset.js"
    },
    "./media/asset/node": {
      "hypit-source": "./src/media-asset-node.ts",
      "types": "./dist/media-asset-node.d.ts",
      "import": "./dist/media-asset-node.js"
    },
    "./media/asset/service": {
      "hypit-source": "./src/media-asset-service.ts",
      "types": "./dist/media-asset-service.d.ts",
      "import": "./dist/media-asset-service.js"
    },
    "./media/asset/service/node": {
      "hypit-source": "./src/media-asset-service-node.ts",
      "types": "./dist/media-asset-service-node.d.ts",
      "import": "./dist/media-asset-service-node.js"
    },
    "./media/local": {
      "hypit-source": "./src/media-local.ts",
      "types": "./dist/media-local.d.ts",
      "import": "./dist/media-local.js"
    },
    "./html/program": {
      "hypit-source": "./src/html-program.ts",
      "types": "./dist/html-program.d.ts",
      "import": "./dist/html-program.js"
    },
    "./html/render/local": {
      "hypit-source": "./src/html-render-local.ts",
      "types": "./dist/html-render-local.d.ts",
      "import": "./dist/html-render-local.js"
    },
    "./html/render/chromium": {
      "hypit-source": "./src/html-chromium-local.ts",
      "types": "./dist/html-chromium-local.d.ts",
      "import": "./dist/html-chromium-local.js"
    },
    "./html/render/electron": {
      "hypit-source": "./src/html-electron-local.ts",
      "types": "./dist/html-electron-local.d.ts",
      "import": "./dist/html-electron-local.js"
    },
    "./html/video": {
      "hypit-source": "./src/html-video.ts",
      "types": "./dist/html-video.d.ts",
      "import": "./dist/html-video.js"
    },
    "./html/video/local": {
      "hypit-source": "./src/html-video-local.ts",
      "types": "./dist/html-video-local.d.ts",
      "import": "./dist/html-video-local.js"
    },
    "./nle": {
      "hypit-source": "./src/nle.ts",
      "types": "./dist/nle.d.ts",
      "import": "./dist/nle.js"
    },
    "./nle/view": {
      "hypit-source": "./src/nle-view.ts",
      "types": "./dist/nle-view.d.ts",
      "import": "./dist/nle-view.js"
    },
    "./nle/surface": {
      "hypit-source": "./src/nle-surface.ts",
      "types": "./dist/nle-surface.d.ts",
      "import": "./dist/nle-surface.js"
    },
    "./nle/delivery": {
      "hypit-source": "./src/nle-delivery.ts",
      "types": "./dist/nle-delivery.d.ts",
      "import": "./dist/nle-delivery.js"
    },
    "./project": {
      "hypit-source": "./src/project.ts",
      "types": "./dist/project.d.ts",
      "import": "./dist/project.js"
    },
    "./project/node": {
      "hypit-source": "./src/project-node.ts",
      "types": "./dist/project-node.d.ts",
      "import": "./dist/project-node.js"
    }
  },
  "files": [
    "dist",
    "runtime/hypihub-windows-credential.ps1",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "pnpm -r run build && pnpm run build:root",
    "build:root": "tsc -p tsconfig.build.json",
    "check": "tsc -p tsconfig.json --noEmit",
    "application": "node dist/cli.js host start",
    "studio": "node dist/cli.js nle open project.svml --project examples/nle-studio --view project.nle-view.json",
    "prepack": "pnpm build"
  },
  "dependencies": {
    "@hypit/audio-program": "workspace:^0.1.0",
    "@hypit/application": "workspace:^0.1.0",
    "@hypit/application-home": "workspace:^0.1.0",
    "@hypit/canvas-studio": "workspace:^0.1.0",
    "@hypit/execution": "workspace:^0.1.0",
    "@hypit/provider-hypihub": "workspace:^0.1.0",
    "@hypit/html-chromium-local": "workspace:^0.1.0",
    "@hypit/html-electron-local": "workspace:^0.1.0",
    "@hypit/html-program": "workspace:^0.1.0",
    "@hypit/html-render-local": "workspace:^0.1.0",
    "@hypit/html-video": "workspace:^0.1.0",
    "@hypit/html-video-local": "workspace:^0.1.0",
    "@hypit/media": "workspace:^0.1.0",
    "@hypit/media-asset": "workspace:^0.1.0",
    "@hypit/media-local": "workspace:^0.1.0",
    "@hypit/nle": "workspace:^0.1.0",
    "@hypit/nle-delivery": "workspace:^0.1.0",
    "@hypit/nle-studio": "workspace:^0.1.0",
    "@hypit/project": "workspace:^0.1.0"
  },
  "devDependencies": {
    "@types/node": "24.10.1",
    "typescript": "5.9.3"
  }
}
