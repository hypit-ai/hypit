{
  "name": "@narratage/repository",
  "version": "0.0.1",
  "license": "SEE LICENSE IN LICENSE",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "check": "tsc -p tsconfig.json --noEmit",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs",
    "test": "node --import tsx --test 'packages/*/test/**/*.test.ts' 'services/*/test/**/*.test.ts' 'tools/*/test/**/*.test.ts' 'test/**/*.test.ts'",
    "test:release": "node --import tsx --test tools/repository-hygiene.test.mjs",
    "test:whisperx-service": "uv run --project services/whisperx --frozen python -m unittest discover -s services/whisperx/tests -p 'test_*.py'",
    "test:browser-visual": "SVML_BROWSER_TESTS=1 node --import tsx --test packages/hyperframes/test/browser-visual.test.ts",
    "test:image-opencv": "SVML_OPENCV_TESTS=1 SVML_OPENCV_PYTHON=services/image-opencv/.venv/bin/python node --import tsx --test packages/provider-image-opencv-local/test/provider.test.ts",
    "smoke:kie": "node --import tsx packages/provider-kie/test/live-smoke.ts",
    "narratage": "node --disable-warning=ExperimentalWarning --import tsx packages/video-cli/src/cli.ts",
    "svml": "node --disable-warning=ExperimentalWarning --import tsx packages/video-cli/src/cli.ts",
    "caption:playground": "pnpm --filter @narratage/caption-playground exec node --import tsx start.ts",
    "build:media-lambda": "pnpm --filter @narratage/media-lambda build",
    "build:media-lambda-layer": "pnpm --filter @narratage/media-lambda build:layer"
  },
  "engines": {
    "node": ">=22",
    "pnpm": ">=10.33.0 <11"
  },
  "devDependencies": {
    "@narratage/artifact": "workspace:*",
    "@narratage/artifact-store-fs": "workspace:*",
    "@narratage/artifact-store-s3": "workspace:*",
    "@narratage/audio-track": "workspace:*",
    "@narratage/background-removal": "workspace:*",
    "@narratage/caption": "workspace:*",
