    },
    "./protocol": {
      "hypit-source": "./packages/protocol/src/index.ts",
      "types": "./dist/public/protocol.d.ts",
      "import": "./packages/protocol/src/index.ts"
    },
    "./product": {
      "hypit-source": "./packages/product/src/index.ts",
      "types": "./dist/public/product.d.ts",
      "import": "./packages/product/src/index.ts"
    },
    "./product/node": {
      "hypit-source": "./packages/product/src/node/index.ts",
      "types": "./dist/public/product-node.d.ts",
