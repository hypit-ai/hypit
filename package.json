{
  "name": "@narratage/workspace",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "check": "tsc -p tsconfig.json --noEmit",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs",
    "test": "node --import tsx --test 'packages/*/test/**/*.test.ts' 'services/*/test/**/*.test.ts' 'tools/*.test.mjs'",
    "test:whisperx-service": "uv run --project services/whisperx --frozen python -m unittest discover -s services/whisperx/tests -p 'test_*.py'",
    "test:image-opencv": "SVML_OPENCV_TESTS=1 SVML_OPENCV_PYTHON=services/image-opencv/.venv/bin/python node --import tsx --test packages/provider-image-opencv-local/test/provider.test.ts",
    "smoke:kie": "node --import tsx packages/provider-kie/test/live-smoke.ts",
    "narratage": "node --import tsx packages/video-cli/src/cli.ts",
    "svml": "node --import tsx packages/video-cli/src/cli.ts",
    "build:media-lambda": "pnpm --filter @narratage/media-lambda build",
    "build:media-lambda-layer": "pnpm --filter @narratage/media-lambda build:layer"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@narratage/artifact": "workspace:*",
    "@narratage/audio-track": "workspace:*",
    "@narratage/caption": "workspace:*",
    "@narratage/caption-fine": "workspace:*",
    "@narratage/caption-gemini": "workspace:*",
    "@narratage/composition": "workspace:*",
    "@narratage/deck-track": "workspace:*",
    "@narratage/estimate": "workspace:*",
    "@narratage/film": "workspace:*",
    "@narratage/fonts-open": "workspace:*",
    "@narratage/generation": "workspace:*",
    "@narratage/hyperframes": "workspace:*",
    "@narratage/image-transform": "workspace:*",
    "@narratage/local": "workspace:*",
    "@narratage/media": "workspace:*",
    "@narratage/media-track": "workspace:*",
    "@narratage/media-pipeline": "workspace:*",
    "@narratage/narrative": "workspace:*",
    "@narratage/program-space": "workspace:*",
    "@narratage/prompt-kit": "workspace:*",
    "@narratage/ranking": "workspace:*",
    "@narratage/provider-google-vertex": "workspace:*",
    "@narratage/provider-hyperframes-local": "workspace:*",
    "@narratage/provider-image-opencv-local": "workspace:*",
    "@narratage/provider-kie": "workspace:*",
    "@narratage/provider-media-local": "workspace:*",
    "@narratage/provider-whisperx-local": "workspace:*",
    "@narratage/render-hyperframes": "workspace:*",
    "@narratage/run-text": "workspace:*",
    "@narratage/runtime-adapter": "workspace:*",
    "@narratage/runtime-adapter-node": "workspace:*",
    "@narratage/script": "workspace:*",
    "@narratage/screen-overlay": "workspace:*",
    "@narratage/seedance": "workspace:*",
    "@narratage/seedance-speaker": "workspace:*",
    "@narratage/semantic-map": "workspace:*",
    "@narratage/speech": "workspace:*",
    "@narratage/speech-alignment": "workspace:*",
    "@narratage/speech-basis": "workspace:*",
    "@narratage/speech-evidence": "workspace:*",
    "@narratage/speech-spine": "workspace:*",
    "@narratage/svs": "workspace:*",
    "@narratage/text-track": "workspace:*",
    "@narratage/temporal": "workspace:*",
    "@narratage/spatial": "workspace:*",
    "@narratage/visual-ir": "workspace:*",
    "@narratage/whisperx": "workspace:*",
    "@types/node": "24.10.1",
    "tsx": "4.21.0",
    "typescript": "5.9.3",
    "vitepress": "^1.6.4"
  }
}
