    "@hypit/video": "workspace:*",
    "@hypit/studio": "workspace:*",
    "@hypit/seedream": "workspace:*",
    "@hypit/spatial": "workspace:*",
    "@hypit/narrative-speech-alignment": "workspace:*",
    "@hypit/speech-evidence": "workspace:*",
    "@hypit/studio-companion": "workspace:*",
    "@hypit/recipe": "workspace:*",
    "@hypit/temporal": "workspace:*",
    "@hypit/text": "workspace:*",
