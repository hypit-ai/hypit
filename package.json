    },
    "./source/text": {
      "hypit-source": "./packages/source/src/header.ts",
      "types": "./dist/public/source-text.d.ts",
      "import": "./packages/source/src/header.ts"
    },
    "./generation-graph": {
      "hypit-source": "./packages/generation-graph/src/index.ts",
      "types": "./dist/public/generation-graph.d.ts",
      "import": "./packages/generation-graph/src/index.ts"
    },
    "./generation-graph/node": {
      "hypit-source": "./packages/generation-graph/src/node/index.ts",
