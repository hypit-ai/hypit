      "hypit-source": "./packages/prompt/src/index.ts",
      "types": "./dist/public/prompt.d.ts",
      "import": "./packages/prompt/src/index.ts"
    }
  },
  "bin": {
    "hypit": "./bin/hypit.mjs"
  },
  "hypit": {
    "cli": {
      "use": [
        "@hypit/browser-capture/cli",
        "@hypit/yt-dlp/cli"
      ]
    },
    "packageSources": [
      "@hypit/toolchain",
      "@hypit/svml-toolchain"
    ]
  },
  "packageManager": "pnpm@10.33.0",
  "files": [
    "bin",
    "dist/public/**/*.d.ts",
    "docs/public/hypit-logo-dark.svg",
    "docs/public/hypit-logo-light.svg",
    "README.md",
    "README.zh-CN.md",
    "migrations/*.md",
    "LICENSE",
    "examples/semantic-composition/README.md",
    "examples/semantic-composition/packages/audiovisual-title-card/src/**/*",
    "examples/semantic-composition/packages/audiovisual-title-card/package.json",
    "examples/semantic-composition/packages/audiovisual-title-card/tsconfig.json",
    "examples/semantic-composition/packages/audiovisual-title-card/README.md",
    "examples/provider-package/README.md",
    "examples/provider-package/packages/*/package.json",
    "examples/provider-package/packages/*/tsconfig.json",
    "examples/provider-package/packages/*/src/**/*",
    "examples/provider-package/hypit.runtime.json"
  ],
  "scripts": {
    "pack:independent": "node scripts/pack-independent-package.mjs",
    "check:seedance-package": "node --import tsx scripts/check-independent-seedance.mjs",
    "check:hypihub-package": "node --import tsx scripts/check-independent-hypihub.mjs",
    "check:runtime-packages": "node --import tsx scripts/check-independent-runtime-packages.mjs",
    "pack:distribution": "node scripts/pack-distribution.mjs",
    "check:distribution": "node scripts/check-distribution.mjs",
    "pack:release-candidate": "node scripts/pack-release-candidate.mjs",
    "check:release-candidate": "node scripts/check-release-candidate.mjs",
    "publish:release-dependencies": "node scripts/publish-release-candidate.mjs dist/release/release-plan.json --independent-only",
    "trust:release-dependencies": "npm exec --yes --package=npm@^11.15.0 -- node scripts/configure-release-publishers.mjs dist/release/release-plan.json",
    "build:public-types": "node scripts/build-public-types.mjs",
    "check": "tsc -p tsconfig.json --noEmit",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs",
    "test": "node test/run.mjs",
    "test:whisperx-service": "uv run --project packages/provider-whisperx-local/runtime --frozen python -m unittest discover -s packages/provider-whisperx-local/test/service -p \"test_*.py\"",
    "test:image-opencv": "node test/run.mjs environment provider-image-opencv-local",
    "hypit": "node bin/hypit.mjs",
    "prepack": "npm run build:public-types"
  },
  "engines": {
    "node": ">=22.15.0"
  },
  "devDependencies": {
    "@hypit/author": "workspace:*",
    "@hypit/caption-fine": "workspace:*",
    "@hypit/markup": "workspace:*",
    "@hypit/media": "workspace:*",
    "@hypit/narrative": "workspace:*",
    "@hypit/narrative-caption": "workspace:*",
    "@hypit/narrative-speech-alignment": "workspace:*",
    "@hypit/narrative-temporal": "workspace:*",
    "@hypit/protocol": "workspace:*",
    "@hypit/prompt": "workspace:*",
    "@hypit/raster-composition": "workspace:*",
    "@hypit/script": "workspace:*",
    "@hypit/svml": "workspace:*",
    "@hypit/speech-evidence": "workspace:*",
    "@hypit/timed-transcript": "workspace:*",
    "@hypit/temporal": "workspace:*",
    "@hypit/temporal-graph": "workspace:*",
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource-variable/league-spartan": "5.3.0",
    "@fontsource-variable/montserrat": "5.3.0",
    "@fontsource-variable/noto-sans-sc": "5.3.0",
    "@fontsource/archivo-black": "5.3.0",
    "linkedom": "0.18.13",
    "rollup": "4.62.4",
    "rollup-plugin-dts": "6.2.3",
    "vitepress": "^1.6.4"
  },
  "dependencies": {
    "@hypit/build-cli": "workspace:^0.1.0",
    "@hypit/generation-graph-cli": "workspace:^0.1.0",
    "@hypit/browser-capture": "workspace:^0.2.1",
    "@hypit/speech-estimate": "workspace:^0.1.2",
    "@hypit/media-local-cli": "workspace:^0.1.0",
    "@hypit/nle-local-cli": "workspace:^0.1.0",
    "@hypit/project-cli": "workspace:^0.1.0",
    "@hypit/runtime-local-cli": "workspace:^0.1.0",
    "@hypit/toolchain": "workspace:^0.3.0",
    "@hypit/svml-toolchain": "workspace:^0.1.0",
    "@hypit/whisperx": "workspace:^0.3.0",
    "@hypit/yt-dlp": "workspace:^0.2.1",
    "@types/node": "24.10.1",
    "koffi": "3.2.1",
    "tsx": "4.21.0",
    "typescript": "5.9.3",
    "cjs-module-lexer": "2.2.1"
  }
}
