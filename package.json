    "@hypit/protocol": "workspace:*",
    "@hypit/markup": "workspace:*",
    "@hypit/run": "workspace:*",
    "@hypit/provider-beatapi": "workspace:*",
    "@hypit/provider-hiapi": "workspace:*",
    "@hypit/provider-html-local": "workspace:*",
    "@hypit/provider-image-opencv-local": "workspace:*",
