{
  "name": "@hypit/hypit",
  "version": "0.4.0",
  "homepage": "https://hypit.ai",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hypit-ai/hypit.git"
  },
  "description": "Hypit modular video production toolchain for AI agents",
  "license": "SEE LICENSE IN LICENSE",
  "type": "module",
  "exports": {
    "./cli": {
      "hypit-source": "./packages/cli/src/public.ts",
      "types": "./dist/public/cli.d.ts",
      "import": "./packages/cli/src/public.ts"
    },
    "./compiler": {
