    },
    "./endpoint/http": {
      "hypit-source": "./packages/endpoint/src/http.ts",
      "types": "./dist/public/endpoint-http.d.ts",
      "import": "./packages/endpoint/src/http.ts"
    },
    "./resource-store": {
      "hypit-source": "./packages/resource-store/src/index.ts",
      "types": "./dist/public/resource-store.d.ts",
      "import": "./packages/resource-store/src/index.ts"
    },
    "./resource-store/node": {
      "hypit-source": "./packages/resource-store/src/node/index.ts",
      "types": "./dist/public/resource-store-node.d.ts",
      "import": "./packages/resource-store/src/node/index.ts"
    },
    "./loader": {
      "hypit-source": "./packages/loader/src/index.ts",
      "types": "./dist/public/loader.d.ts",
