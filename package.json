{
  "name": "@hypit/hypit",
  "version": "0.1.0",
  "description": "Federated, modular, local-first video production system",
  "license": "SEE LICENSE IN LICENSE",
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=24.0.0"
  },
  "bin": {
    "hypit-application": "./dist/application-server.js"
  },
  "exports": {
    ".": {
      "hypit-source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./audiovisual": {
      "hypit-source": "./src/audiovisual.ts",
      "types": "./dist/audiovisual.d.ts",
      "import": "./dist/audiovisual.js"
    },
    "./application": {
      "hypit-source": "./src/application.ts",
      "types": "./dist/application.d.ts",
      "import": "./dist/application.js"
    },
    "./application/node": {
      "hypit-source": "./src/application-node.ts",
      "types": "./dist/application-node.d.ts",
      "import": "./dist/application-node.js"
    },
    "./media": {
      "hypit-source": "./src/media.ts",
      "types": "./dist/media.d.ts",
      "import": "./dist/media.js"
    },
    "./media/asset": {
      "hypit-source": "./src/media-asset.ts",
      "types": "./dist/media-asset.d.ts",
      "import": "./dist/media-asset.js"
    },
    "./media/asset/node": {
      "hypit-source": "./src/media-asset-node.ts",
      "types": "./dist/media-asset-node.d.ts",
      "import": "./dist/media-asset-node.js"
    },
    "./media/asset/service": {
      "hypit-source": "./src/media-asset-service.ts",
      "types": "./dist/media-asset-service.d.ts",
      "import": "./dist/media-asset-service.js"
    },
    "./media/asset/service/node": {
      "hypit-source": "./src/media-asset-service-node.ts",
      "types": "./dist/media-asset-service-node.d.ts",
      "import": "./dist/media-asset-service-node.js"
    },
    "./media/local": {
      "hypit-source": "./src/media-local.ts",
      "types": "./dist/media-local.d.ts",
      "import": "./dist/media-local.js"
    },
    "./nle": {
      "hypit-source": "./src/nle.ts",
      "types": "./dist/nle.d.ts",
      "import": "./dist/nle.js"
    },
    "./nle/view": {
      "hypit-source": "./src/nle-view.ts",
      "types": "./dist/nle-view.d.ts",
      "import": "./dist/nle-view.js"
    },
    "./nle/surface": {
      "hypit-source": "./src/nle-surface.ts",
      "types": "./dist/nle-surface.d.ts",
      "import": "./dist/nle-surface.js"
    },
    "./project": {
      "hypit-source": "./src/project.ts",
      "types": "./dist/project.d.ts",
      "import": "./dist/project.js"
    },
    "./project/node": {
      "hypit-source": "./src/project-node.ts",
      "types": "./dist/project-node.d.ts",
      "import": "./dist/project-node.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "pnpm --filter @hypit/temporal build && pnpm --filter @hypit/media build && pnpm --filter @hypit/media-asset build && pnpm --filter @hypit/media-local build && pnpm --filter @hypit/audiovisual build && pnpm --filter @hypit/nle build && pnpm --filter @hypit/project build && pnpm --filter @hypit/application build && pnpm --filter @hypit/application-home build && pnpm --filter @hypit/nle-studio build && pnpm run build:root",
    "build:root": "tsc -p tsconfig.build.json",
    "check": "tsc -p tsconfig.json --noEmit",
    "application": "node dist/application-server.js",
    "studio": "pnpm --filter @hypit/nle-studio start -- --root ../../examples/nle-studio --document project.svml",
    "prepack": "pnpm build"
  },
  "dependencies": {
    "@hypit/application": "workspace:^0.1.0",
    "@hypit/application-home": "workspace:^0.1.0",
    "@hypit/audiovisual": "workspace:^0.1.0",
    "@hypit/media": "workspace:^0.1.0",
    "@hypit/media-asset": "workspace:^0.1.0",
    "@hypit/media-local": "workspace:^0.1.0",
    "@hypit/nle": "workspace:^0.1.0",
    "@hypit/nle-studio": "workspace:^0.1.0",
    "@hypit/project": "workspace:^0.1.0"
  },
  "devDependencies": {
    "@types/node": "24.10.1",
    "typescript": "5.9.3"
  }
}
