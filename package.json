{
  "name": "@svml/compiler",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "bin": {
    "svml": "./dist/src/cli.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && node tools/copy-runtime.mjs",
    "check": "pnpm check:v1 && pnpm check:v2",
    "check:v1": "tsc -p tsconfig.json --noEmit",
    "check:v2": "tsc -p tsconfig.v2.json --noEmit",
    "test": "pnpm test:v1 && pnpm test:v2",
    "test:v1": "node --import tsx --test 'test/**/*.test.ts'",
    "test:v2": "node --import tsx --test 'packages/*/test/**/*.test.ts'",
    "svml": "node --import tsx src/cli.ts",
    "svml:v2": "node --import tsx packages/cli/src/cli.ts"
  },
  "files": [
    "dist/src",
    "stdlib",
    "spec",
    "docs",
    "README.md"
  ],
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "hyperframes": "0.7.84"
  },
  "devDependencies": {
    "@types/node": "24.10.1",
    "tsx": "4.21.0",
    "typescript": "5.9.3"
  }
}
