{
  "name": "@svml/workspace",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "check": "tsc -p tsconfig.json --noEmit",
    "test": "node --import tsx --test 'packages/*/test/**/*.test.ts' 'tools/*.test.mjs'",
    "test:whisperx-service": "uv run --project services/whisperx --frozen python -m unittest discover -s services/whisperx/tests -p 'test_*.py'",
    "test:image-opencv": "SVML_OPENCV_TESTS=1 SVML_OPENCV_PYTHON=services/image-opencv/.venv/bin/python node --import tsx --test packages/provider-image-opencv-local/test/provider.test.ts",
    "smoke:kie": "node --import tsx packages/provider-kie/test/live-smoke.ts",
    "svml": "node --import tsx packages/video-cli/src/cli.ts"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@svml/artifact": "workspace:*",
    "@svml/broll": "workspace:*",
    "@svml/caption": "workspace:*",
    "@svml/caption-gemini": "workspace:*",
    "@svml/contracts": "workspace:*",
    "@svml/estimate": "workspace:*",
    "@svml/film": "workspace:*",
    "@svml/generation": "workspace:*",
    "@svml/hyperframes": "workspace:*",
    "@svml/hyperframes-render": "workspace:*",
    "@svml/image-transform": "workspace:*",
    "@svml/local": "workspace:*",
    "@svml/media": "workspace:*",
    "@svml/media-pipeline": "workspace:*",
    "@svml/prompt-kit": "workspace:*",
    "@svml/provider-google-vertex": "workspace:*",
    "@svml/provider-hyperframes-local": "workspace:*",
    "@svml/provider-image-opencv-local": "workspace:*",
    "@svml/provider-kie": "workspace:*",
    "@svml/provider-media-local": "workspace:*",
    "@svml/provider-whisperx-local": "workspace:*",
    "@svml/run-text": "workspace:*",
    "@svml/runtime-adapter": "workspace:*",
    "@svml/runtime-adapter-node": "workspace:*",
    "@svml/script": "workspace:*",
    "@svml/seedance": "workspace:*",
    "@svml/seedance-speaker": "workspace:*",
    "@svml/speech-align": "workspace:*",
    "@svml/speech-program": "workspace:*",
    "@svml/speech-take": "workspace:*",
    "@svml/svs": "workspace:*",
    "@svml/text-track": "workspace:*",
    "@svml/whisperx": "workspace:*",
    "@types/node": "24.10.1",
    "tsx": "4.21.0",
    "typescript": "5.9.3"
  }
}
