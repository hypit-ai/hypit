<kernel name="caption-planner" abi="1" implementation="./runtime/caption-planner.mjs">
  <param name="maxWords" style="max-words" type="number" default="3"/>
  <port name="script" direction="input" type="NarrativeIR" cardinality="one"/>
  <port name="semantic" direction="input" type="CompleteSemanticMap" cardinality="one"/>
  <port name="plan" direction="output" type="CaptionPlan" cardinality="one"/>
  <child name="annotate" cardinality="zero-or-more">
    <field name="id" type="id" required="true"/>
    <field name="kind" type="string" required="true"/>
    <field name="value" type="string"/>
    <field name="during" type="SelectionSet|ProgramSpan" consume="set"/>
    <field name="role" type="string"/>
  </child>
</kernel>
