<kernel name="audio-track" abi="1" implementation="./runtime/audio-track.mjs">
  <port name="item" direction="input" type="AudioItem" cardinality="one-or-more"/>
  <port name="track" direction="output" type="Track" cardinality="one"/>
  <child name="item" cardinality="one-or-more">
    <field name="id" type="id" required="true"/>
    <field name="source" type="Audio" required="true"/>
    <field name="during" type="SelectionSet|ProgramSpan" consume="each"/>
    <field name="at" type="MomentSet|ProgramPoint" consume="each"/>
    <field name="duration" type="string"/>
    <field name="volume" type="number"/>
    <field name="fadeIn" type="number"/>
    <field name="fadeOut" type="number"/>
    <field name="bus" type="string"/>
  </child>
</kernel>
