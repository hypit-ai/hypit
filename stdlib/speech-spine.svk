<kernel name="speech-spine" abi="1" implementation="./runtime/speech-spine.mjs">
  <port name="segment" direction="input" type="SegmentBinding" cardinality="one-or-more"/>
  <port name="segment" direction="output" type="SegmentMaterial" cardinality="one-or-more"/>
  <port name="segment.*.visual" direction="output" type="Video" cardinality="zero-or-one"/>
  <port name="segment.*.audio" direction="output" type="Audio" cardinality="one"/>
  <port name="speech" direction="output" type="SpeechSpine" cardinality="one"/>
  <port name="track" direction="output" type="Track" cardinality="one"/>
  <child name="segment" cardinality="one-or-more">
    <field name="id" type="id" required="true"/>
    <field name="script" type="ScriptSegment" required="true"/>
    <field name="visual" type="Video" required="true"/>
    <field name="audio" type="Audio"/>
  </child>
</kernel>
