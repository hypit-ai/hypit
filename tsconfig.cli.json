{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "declaration": false,
    "sourceMap": false,
    "outDir": "./dist/cli",
    "incremental": true,
    "tsBuildInfoFile": "./dist/cli.tsbuildinfo"
  },
  "include": [
    "packages/*/src/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "packages/*/test/**"
  ]
}
