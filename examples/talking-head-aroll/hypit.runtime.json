{
  "format": "hypit.runtime-profile@1",
  "runtime": {
    "use": "@hypit/runtime-local",
    "config": {
      "dataRoot": ".hypit/runtimes/local",
      "artifacts": { "use": "@hypit/artifact-store-fs", "config": { "path": "artifacts" } },
      "credentials": {
        "environment": { "use": "@hypit/credential-store-env" }
      },
      "endpoints": {
        "kie.talking-head-aroll": {
          "use": "@hypit/provider-kie",
          "config": {
            "apiKey": { "store": "env", "key": "KIE_API_KEY" },
            "defaultConcurrency": 2
          }
        },
        "media.talking-head-aroll": {
          "use": "@hypit/provider-media-local",
          "config": { "defaultConcurrency": 2 }
        },
        "whisperx.talking-head-aroll": {
          "use": "@hypit/provider-whisperx-local",
          "config": { "defaultConcurrency": 1 }
        },
        "hyperframes.talking-head-aroll": {
          "use": "@hypit/provider-hyperframes-local",
          "config": { "workers": 2, "quality": "standard", "defaultConcurrency": 1 }
        }
      }
    }
  }
}
