{
  "format": "svml.runtime-config@1",
  "packageLock": "./svml.packages.lock",
  "runtimePackageLock": "./svml.runtime-packages.lock",
  "endpoints": [
    {
      "use": "@narratage/provider-kie",
      "instance": "kie.talking-head-aroll",
      "lane": "generation",
      "config": {
        "apiKeyEnv": "KIE_API_KEY",
        "defaultConcurrency": 2
      }
    },
    {
      "use": "@narratage/provider-media-local",
      "instance": "media.talking-head-aroll",
      "lane": "media",
      "config": {
        "defaultConcurrency": 2
      }
    },
    {
      "use": "@narratage/provider-whisperx-local",
      "instance": "whisperx.talking-head-aroll",
      "lane": "alignment",
      "config": {
        "defaultConcurrency": 1
      }
    },
    {
      "use": "@narratage/provider-google-vertex",
      "instance": "vertex.talking-head-aroll",
      "lane": "planning",
      "config": {
        "projectEnv": "GOOGLE_CLOUD_PROJECT",
        "credentialsEnv": "GOOGLE_APPLICATION_CREDENTIALS_JSON",
        "location": "global",
        "defaultConcurrency": 1
      }
    },
    {
      "use": "@narratage/provider-hyperframes-local",
      "instance": "hyperframes.talking-head-aroll",
      "lane": "render",
      "config": {
        "workers": 2,
        "quality": "standard",
        "defaultConcurrency": 1
      }
    }
  ],
  "permissions": [
    "filesystem:whisperx-staging",
    "network:aiplatform.googleapis.com",
    "network:api.kie.ai",
    "network:kieai.redpandaai.co",
    "network:whisperx-loopback",
    "process:hyperframes",
    "process:media"
  ],
  "scheduling": {
    "maxConcurrency": 4,
    "lanes": {
      "generation": 2,
      "media": 2,
      "alignment": 1,
      "planning": 1,
      "render": 1
    }
  }
}
