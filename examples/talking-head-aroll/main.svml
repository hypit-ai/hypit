<?svml using="@narratage/markup@1"?>

<svml>
  <import from="@narratage/script@1"/>
  <import as="wording" from="@narratage/text@1"/>
  <import as="media" from="@narratage/media@1"/>
  <import as="estimate" from="@narratage/estimate@1"/>
  <import as="seedance" from="@narratage/seedance@1"/>
  <import as="speech" from="@narratage/speech-spine@1"/>
  <import as="whisperx" from="@narratage/whisperx@1"/>
  <import as="caption" from="@narratage/caption@1"/>
  <import as="caption-fine" from="@narratage/caption-fine@1"/>
  <import as="caption-ai" from="@narratage/caption-gemini@1"/>
  <import as="fonts" from="@narratage/fonts-open@1"/>
  <import as="space" from="@narratage/spatial@1"/>
  <import as="film" from="@narratage/film@1"/>
  <import as="render" from="@narratage/render-hyperframes@1"/>
  <import as="studio" source="./studio.svs"/>
  <import as="speaker-kit" source="../../packages/seedance-kits/kits/speaker-v1.svs"/>

  <script id="story">
    <hook>
      <HOST>Girls, you need to hear this. Never let anyone take credit for your work. For years, my boss presented my ideas as his, and I kept telling myself I needed proof—but the truth is, I was too scared to speak up.
    </hook>

    <meeting>
      <HOST>Then I found a voice memo app that auto-transcribes: just tap record and it captures every word. I brought it to one meeting. It organized the minutes and showed exactly where my work had been overlooked. For once, I felt seen.
    </meeting>

    <evidence>
      <HOST>That gave me the courage I was missing. Before our month-end review, I fed the app my meeting notes and my actual work files. It connected the dots and turned everything into one clear, evidence-backed report of what I had really delivered.
    </evidence>

    <payoff>
      <HOST>And guess what? I’m sitting in my old boss’s chair now. The first thing I did was set up the same tool for every person on my team—so work gets easier, achievements stay visible, and no one has to fight alone just to get the credit they’ve earned.
    </payoff>
  </script>

  <!-- Author-owned reference material. -->
  <media:Image id="presenter-clean" src="./assets/presenter-clean.png"/>
  <media:Image id="presenter-alt" src="./assets/presenter-alt.png"/>
  <media:Audio id="presenter-voice" src="./assets/presenter-voice.mp3"/>

  <!-- Per-take performance remains ordinary authored Text, separate from spoken words. -->
  <wording:Value id="hook-action">
    Begin with urgent direct eye contact, then let the final admission land more quietly.
  </wording:Value>
  <wording:Value id="meeting-action">
    Briefly indicate the recording tool, then return to the lens with visible relief.
  </wording:Value>
  <wording:Value id="evidence-action">
    Build confidence across the explanation and use one compact connecting gesture.
  </wording:Value>
  <wording:Value id="payoff-action">
    Deliver the reveal with a contained smile, then finish warmly and inclusively.
  </wording:Value>

  <!-- Duration remains an explicit graph fact derived from the pronunciation projection. -->
  <estimate:Speech id="hook-duration" source={story.segment.hook.speech} policy={studio.speech.normal}/>
  <estimate:Speech id="meeting-duration" source={story.segment.meeting.speech} policy={studio.speech.normal}/>
  <estimate:Speech id="evidence-duration" source={story.segment.evidence.speech} policy={studio.speech.normal}/>
  <estimate:Speech id="payoff-duration" source={story.segment.payoff.speech} policy={studio.speech.normal}/>

  <!-- Prompt assembly is an ordinary Text subgraph. -->
  <wording:Render
    id="hook-prompt"
    template={speaker-kit.speaker-v1}
    recipe={studio.speaker.host}
  >
    <wording:Set name="dialogue" text={story.segment.hook.dialogue}/>
    <wording:Set name="action" text={hook-action}/>
  </wording:Render>

  <wording:Render
    id="meeting-prompt"
    template={speaker-kit.speaker-v1}
    recipe={studio.speaker.host}
  >
    <wording:Set name="dialogue" text={story.segment.meeting.dialogue}/>
    <wording:Set name="action" text={meeting-action}/>
  </wording:Render>

  <wording:Render
    id="evidence-prompt"
    template={speaker-kit.speaker-v1}
    recipe={studio.speaker.host}
  >
    <wording:Set name="dialogue" text={story.segment.evidence.dialogue}/>
    <wording:Set name="action" text={evidence-action}/>
  </wording:Render>

  <wording:Render
    id="payoff-prompt"
    template={speaker-kit.speaker-v1}
    recipe={studio.speaker.host}
  >
    <wording:Set name="dialogue" text={story.segment.payoff.dialogue}/>
    <wording:Set name="action" text={payoff-action}/>
  </wording:Render>

  <!-- Base → alternate → alternate → base; all four share the same voice reference. -->
  <seedance:ReferenceVideo
    id="hook-take"
    model="mini"
    prompt={hook-prompt}
    duration={hook-duration.duration}
    resolution="720p"
    aspect-ratio="9:16"
    generate-audio="true"
  >
    <seedance:Reference image={presenter-clean}/>
    <seedance:Reference audio={presenter-voice}/>
  </seedance:ReferenceVideo>

  <seedance:ReferenceVideo
    id="meeting-take"
    model="mini"
    prompt={meeting-prompt}
    duration={meeting-duration.duration}
    resolution="720p"
    aspect-ratio="9:16"
    generate-audio="true"
  >
    <seedance:Reference image={presenter-alt}/>
    <seedance:Reference audio={presenter-voice}/>
  </seedance:ReferenceVideo>

  <seedance:ReferenceVideo
    id="evidence-take"
    model="mini"
    prompt={evidence-prompt}
    duration={evidence-duration.duration}
    resolution="720p"
    aspect-ratio="9:16"
    generate-audio="true"
  >
    <seedance:Reference image={presenter-alt}/>
    <seedance:Reference audio={presenter-voice}/>
  </seedance:ReferenceVideo>

  <seedance:ReferenceVideo
    id="payoff-take"
    model="mini"
    prompt={payoff-prompt}
    duration={payoff-duration.duration}
    resolution="720p"
    aspect-ratio="9:16"
    generate-audio="true"
  >
    <seedance:Reference image={presenter-clean}/>
    <seedance:Reference audio={presenter-voice}/>
  </seedance:ReferenceVideo>

  <space:Canvas id="vertical" width="720" height="1280"/>
  <space:Frame id="speech-frame" within={vertical} left="0%" top="0%" right="100%" bottom="100%"/>

  <!-- Four equal Takes become one ordered speech coordinate space and two peer Tracks. -->
  <speech:Spine id="speech" frame-rate="30"
    visual-frame={speech-frame} visual-appearance={studio.speech.visual} visual-z="0">
    <speech:Take video={hook-take.video} segment={story.segment.hook}/>
    <speech:Take video={meeting-take.video} segment={story.segment.meeting}/>
    <speech:Take video={evidence-take.video} segment={story.segment.evidence}/>
    <speech:Take video={payoff-take.video} segment={story.segment.payoff}/>
  </speech:Spine>

  <!-- One measured evidence pass locates the complete authored Script. -->
  <whisperx:Alignment id="timing" narrative={story} audio={speech.audio}/>

  <!-- Gemini sees display words and these requirements, never audio or timing. -->
  <fonts:Stack id="caption-font" family="inter" weight="800" style="normal"/>
  <caption-fine:Style id="primary-caption" recipe={studio.caption.primary} font={caption-font}/>

  <caption:Program id="caption-program" display={story.caption} default={primary-caption}/>
  <caption-ai:Planner
    id="caption-plan"
    display={story.caption}
    program={caption-program}
    model="gemini-2.5-flash"
  />

  <!-- Caption becomes an ordinary self-contained VisualTrack after joining the measured map. -->
  <caption-fine:Track
    id="captions"
    display={story.caption}
    correspondence={story.caption.correspondence}
    map={timing.map}
    space={speech.space}
    program={caption-program}
    plan={caption-plan.plan}
  />

  <film:Film id="main" canvas={vertical} space={speech.space} appearance={studio.film.vertical}>
    <film:Track source={speech.visual}/>
    <film:Track source={speech.audioTrack}/>
    <film:Track source={captions.track}/>
  </film:Film>

  <render:Video id="final" composition={main.composition} space={speech.space}/>
</svml>
