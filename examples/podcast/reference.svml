<?svml using="@hypit/markup@1"?>

<svml>
  <import from="@hypit/script@1"/>
  <import as="asset" from="@hypit/media@1"/>
  <import as="mimo" from="@hypit/mimo-speech@1"/>
  <import as="text" from="@hypit/text@1"/>
  <import as="gpt" from="@hypit/gpt-image@1"/>
  <import as="seedance" from="@hypit/seedance@1"/>
  <import as="program" from="@hypit/program-space@1"/>
  <import as="pipeline" from="@hypit/media-pipeline@1"/>
  <import as="whisperx" from="@hypit/whisperx@1"/>
  <import as="speech" from="@hypit/speech-track@1"/>
  <import as="audio-track" from="@hypit/audio-track@1"/>
  <import as="caption" from="@hypit/caption@1"/>
  <import as="caption-fine" from="@hypit/caption-fine@1"/>
  <import as="fonts" from="@hypit/fonts-open@1"/>
  <import as="media-track" from="@hypit/media-track@1"/>
  <import as="space" from="@hypit/spatial@1"/>
  <import as="film" from="@hypit/film@1"/>
  <import as="render" from="@hypit/render-hyperframes@1"/>
  <import as="recipes" source="./reference.svs"/>
  <import as="image-kit" source="@hypit/gpt-image-kits/phone-ugc-v1"/>
  <import as="opening-kit" source="./kits/split-opening.svs"/>
  <import as="broll-kit" source="@hypit/seedance-kits/broll"/>
  <import as="podcast-kit" source="@hypit/seedance-kits/podcast"/>

  <script id="story">
    <opening-question>
      <GUY>OK Sarah || so what is || the one single thing || that you literally || can't live without?
    </opening-question>
    <daily-creatine>
      <GIRL>Creatine. Five grams || a day, every day. ~@lifestyle || I put it || in my coffee, || my smoothie, || and even my || pasta water.
      <GUY>God I think || you're treating this @/lifestyle || as flour.
    </daily-creatine>
    <arms-are-asking>
      <GIRL>But actually you || need this way || more than I do.
      <GUY>Wait what? || I didn't ask || for that!
      <GIRL>Of course you did. || Look at your arms!
    </arms-are-asking>
  </script>

  <!-- The main host establishes the person, place and capture language. -->
  <text:Value id="girl-person">
    A Japanese-American woman in her early twenties, exceptionally, strikingly beautiful, with the looks of a top Korean girl-group idol.
    She has a small refined face, very fair skin, large attractive eyes with blue contact lenses, and long straight
    black hair with blunt bangs. Her strikingly muscular physique contrasts with her delicate face.
    Her shoulders are very broad, her head-to-shoulder proportions excellent, and her arms have pronounced
    muscle definition and visible veins. She wears a black strapless top with an angel-wing design and
    relaxed tweed trousers with an asymmetrical pattern of pale stripes.
  </text:Value>
  <text:Value id="girl-shot">
    Generate a close half-body podcast view. She sits toward the right, her body angled slightly left,
    looking at her conversation partner outside the left edge. Her face remains clearly readable.
    She sits back comfortably in a fabric armchair with her legs crossed, near enough to the camera for her
    face and upper body to feel present, while her shoulders, arms and seated legs stay comfortably framed.
    A half-eaten grape bingsu sits on a table in the lower left.
    A podcast microphone extends from the left, marked HYPIT in attractive uppercase lettering.
  </text:Value>
  <text:Value id="girl-setting">
    The setting is outside a pleasant Korean street-side restaurant, with textured dark wooden walls,
    plants and other tables.
    Wood brown and coral red establish the background palette, with green plants as accents.
    Natural light falls comfortably across her face; the wooden wall retains its own color and texture.
  </text:Value>
  <text:Render id="girl-prompt" template={image-kit.phone-ugc-v1}>
    <text:Set name="person" text={girl-person}/>
    <text:Set name="shot" text={girl-shot}/>
    <text:Set name="setting" text={girl-setting}/>
  </text:Render>
  <gpt:Image id="girl" prompt={girl-prompt} aspect-ratio="9:16" resolution="2K"/>

  <text:Value id="guy-person">
    A young American man, exceptionally handsome, with the looks of a young Hollywood actor and an endearing nerdy presence.
    He has fair skin, a slim build, broad shoulders and excellent head-to-shoulder proportions, messy curly hair
    and black-framed glasses. He wears a pale finely striped T-shirt with a small abstract
    devil-tail graphic, black trousers and a cool necklace. Create this other host rather than mirroring the woman.
  </text:Value>
  <text:Value id="guy-shot">
    Use the first image for the conversational geometry and generate the complementary half-body camera view.
    He sits casually in the corresponding fabric chair toward the left, angled and looking right toward the woman outside the frame.
    Match the comfortable camera distance and scale of the first view. The microphone now enters from the right
    and reads HYPIT; a bowl of mango bingsu on the lower-right table balances him.
  </text:Value>
  <text:Value id="guy-setting">
    Use the first image for the restaurant and capture language. Keep its textured wooden surfaces and natural
    lighting, but show the other part of the space with different background objects appropriate to this
    camera's direction rather than duplicating her background.
  </text:Value>
  <text:Render id="guy-prompt" template={image-kit.phone-ugc-v1}>
    <text:Set name="person" text={guy-person}/>
    <text:Set name="shot" text={guy-shot}/>
    <text:Set name="setting" text={guy-setting}/>
  </text:Render>
  <gpt:Image id="guy" prompt={guy-prompt} aspect-ratio="9:16" resolution="2K">
    <gpt:Reference image={girl.image}/>
  </gpt:Image>

  <text:Value id="creatine-prompt">
    A typical e-commerce product photograph of a single creatine supplement tub.
    The main English label reads CREATINE, with a few smaller packaging details arranged like a believable
    supplement label. Show the whole tub and lid clearly against a simple neutral product backdrop.
    Only the tub is present; there are no surrounding objects or floating words.
  </text:Value>
  <gpt:Image id="creatine" prompt={creatine-prompt} aspect-ratio="1:1" resolution="2K"/>

  <text:Value id="guy-voice-sample">OK Sarah, so what is the one single thing that you literally can't live without?</text:Value>
  <mimo:VoiceDesign id="guy-voice" speech={guy-voice-sample}>
    A young American man with a curious, friendly podcast-host delivery; clear, relaxed, lightly nasal, and conversational, with an easy medium pace.
  </mimo:VoiceDesign>
  <text:Value id="girl-voice-sample">Creatine. Five grams a day, every day.</text:Value>
  <mimo:VoiceDesign id="girl-voice" speech={girl-voice-sample}>
    A young woman speaking conversational American English with a confident, lively podcast delivery; clear, bright, athletic, and matter-of-fact, with expressive emphasis and natural pacing.
  </mimo:VoiceDesign>
  <asset:Audio id="soundtrack" src="./assets/shared-soundtrack.m4a"/>

  <text:Value id="split-person">
    Preserve the man's identity and styling from the first image and the woman's identity and styling from the second.
  </text:Value>
  <text:Value id="split-shot">
    Create a horizontal split-screen image: the man fills the upper panel and the woman fills the lower panel.
    The first image supplies his camera view for the upper panel; the second supplies hers for the lower panel.
    Both panels are close views of their faces and upper bodies, with their microphones visible.
    The man looks right and the woman looks left, as in their individual views.
    Keep the horizontal dividing line clean and preserve the sense that both are present in the conversation.
  </text:Value>
  <text:Value id="split-setting">
    Keep each reference image's restaurant surroundings and natural lighting in its corresponding panel.
  </text:Value>
  <text:Render id="split-prompt" template={image-kit.phone-ugc-v1}>
    <text:Set name="person" text={split-person}/>
    <text:Set name="shot" text={split-shot}/>
    <text:Set name="setting" text={split-setting}/>
  </text:Render>
  <gpt:Image id="split" prompt={split-prompt} aspect-ratio="9:16" resolution="2K">
    <gpt:Reference image={guy.image}/>
    <gpt:Reference image={girl.image}/>
  </gpt:Image>

  <text:Value id="girl-hold-person">
    Image one supplies the woman. Preserve her beauty, identity and muscular physique.
  </text:Value>
  <text:Value id="girl-hold-shot">
    Keep the first image's camera view, framing, seated pose and microphone position.
    The woman holds the creatine tub from the second image with the hand on the right side of the frame,
    while the hand on the left points toward it. She still looks left as if talking to her partner.
    Image two supplies the exact product, including its label and proportions. The tub belongs naturally in her hand and the scene.
  </text:Value>
  <text:Value id="girl-hold-setting">
    Image one supplies the complete scene. Keep its surroundings and natural lighting.
  </text:Value>
  <text:Render id="girl-hold-prompt" template={image-kit.phone-ugc-v1}>
    <text:Set name="person" text={girl-hold-person}/>
    <text:Set name="shot" text={girl-hold-shot}/>
    <text:Set name="setting" text={girl-hold-setting}/>
  </text:Render>
  <gpt:Image id="girl-hold" prompt={girl-hold-prompt} aspect-ratio="9:16" resolution="2K">
    <gpt:Reference image={girl.image}/>
    <gpt:Reference image={creatine.image}/>
  </gpt:Image>

  <text:Value id="guy-hold-person">
    Image one supplies the man. Preserve his identity and clothing.
  </text:Value>
  <text:Value id="guy-hold-shot">
    Keep the first image's camera view, framing, seated pose and microphone position.
    The man holds the creatine tub from the second image with the hand on the left side of the frame.
    He still looks right as if speaking to his partner. Keep his other hand naturally at rest.
    Image two supplies the same product held by the woman. The tub belongs naturally in his hand and the scene.
  </text:Value>
  <text:Value id="guy-hold-setting">
    Image one supplies the complete scene. Keep its surroundings and natural lighting.
  </text:Value>
  <text:Render id="guy-hold-prompt" template={image-kit.phone-ugc-v1}>
    <text:Set name="person" text={guy-hold-person}/>
    <text:Set name="shot" text={guy-hold-shot}/>
    <text:Set name="setting" text={guy-hold-setting}/>
  </text:Render>
  <gpt:Image id="guy-hold" prompt={guy-hold-prompt} aspect-ratio="9:16" resolution="2K">
    <gpt:Reference image={guy.image}/>
    <gpt:Reference image={creatine.image}/>
  </gpt:Image>

  <text:Value id="coffee-person">
    The first image supplies her identity and physique. Preserve her exceptionally attractive face,
    muscular shoulders and strong arms.
    She has changed into a lightweight pale-gray sleeveless zip-front sports layer over a beige bandeau,
    with the hood and an additional pink baseball cap.
  </text:Value>
  <text:Value id="coffee-shot">
    Generate a lively raised-arm selfie of the woman turning toward her phone.
    The view feels comfortably close and casually composed. Her expression is playful and sociable,
    with one casual hand gesture.
  </text:Value>
  <text:Value id="coffee-setting">
    Change her location to a cafe.
    Other customers are faintly present in the cafe. Afternoon light through the windows gives her face
    natural illumination; cafe furniture and surroundings retain their color.
  </text:Value>
  <text:Render id="coffee-prompt" template={image-kit.phone-ugc-v1}>
    <text:Set name="person" text={coffee-person}/>
    <text:Set name="shot" text={coffee-shot}/>
    <text:Set name="setting" text={coffee-setting}/>
  </text:Render>
  <gpt:Image id="coffee" prompt={coffee-prompt} aspect-ratio="9:16" resolution="2K">
    <gpt:Reference image={girl.image}/>
  </gpt:Image>

  <text:Value id="smoothie-person">
    Preserve the woman from the first image, with her very beautiful face and clearly muscular arms and shoulders.
    Change her outfit to a navy Adidas sports tank and charcoal over-ear headphones.
  </text:Value>
  <text:Value id="smoothie-shot">
    Generate a lively mirror selfie of the woman standing.
    She holds her phone in one hand, watches its screen, and holds a bowl of strawberry bingsu in the other.
    Her phone has a playful CASETiFY case with a cute rabbit design.
    She parts her lips with an amused expression as if about to taste the bingsu.
    The composition feels spontaneous rather than rigid.
  </text:Value>
  <text:Value id="smoothie-setting">
    Change the location to a dessert shop, lit naturally through its windows, with a readable background.
    This dessert scene broadly supports her food routine; it is not a literal smoothie demonstration.
  </text:Value>
  <text:Render id="smoothie-prompt" template={image-kit.phone-ugc-v1}>
    <text:Set name="person" text={smoothie-person}/>
    <text:Set name="shot" text={smoothie-shot}/>
    <text:Set name="setting" text={smoothie-setting}/>
  </text:Render>
  <gpt:Image id="smoothie" prompt={smoothie-prompt} aspect-ratio="9:16" resolution="2K">
    <gpt:Reference image={girl.image}/>
  </gpt:Image>

  <text:Value id="pasta-person">
    Use the first image for her identity and physique. Keep her exceptionally attractive face,
    strong arms and broad muscular shoulders.
    She wears a pink spaghetti-strap apron over a textured pale T-shirt, with a pale hair clip holding back
    part of her hair.
  </text:Value>
  <text:Value id="pasta-shot">
    Generate a low-angle photograph as if a phone has been set on a table.
    She is close enough for her attentive expression and practical hand movements to be clearly readable.
    She is preparing macaroni at a stovetop, with pasta ready to go into a pot.
  </text:Value>
  <text:Value id="pasta-setting">
    Create this home-cooking scene independently of the other lifestyle images, in her home courtyard.
    The covered courtyard has a warm modern Korean domestic feel, with a slatted wooden roof and hanging plants.
    Afternoon sunlight enters the courtyard and gives her face natural illumination, while the covered area
    and surrounding wood keep the scene tonally grounded.
  </text:Value>
  <text:Render id="pasta-prompt" template={image-kit.phone-ugc-v1}>
    <text:Set name="person" text={pasta-person}/>
    <text:Set name="shot" text={pasta-shot}/>
    <text:Set name="setting" text={pasta-setting}/>
  </text:Render>
  <gpt:Image id="pasta" prompt={pasta-prompt} aspect-ratio="9:16" resolution="2K">
    <gpt:Reference image={girl.image}/>
  </gpt:Image>

  <text:Value id="lifestyle-montage-story">
    Use @image1, @image2 and @image3 as three ordered shots in one five-second montage about her daily food routine.
    Give all three scenes readable screen time, including the final cooking scene.
    In the cafe selfie she gives a small playful head turn. In the mirror selfie she keeps her phone in one hand,
    looks at its screen and brings the bingsu slightly closer with an amused expression.
    In the courtyard she continues preparing pasta with small, practical movements.
    Cut cleanly between the three scenes; each scene is continuous internally. Keep her identity, outfit and
    setting faithful to that scene's reference. Motion is ordinary real-time motion, relaxed and physically coherent.
  </text:Value>

  <text:Value id="opening-action">
    The man speaks briskly and naturally while looking right, with a small conversational head movement.
    At the same time the woman remains silent, briefly glances down, makes one small seated-posture adjustment,
    and looks back left attentively. Her lips do not form his words. Keep both performances understated and alive.
  </text:Value>
  <text:Render id="opening-take-prompt" template={opening-kit.split-opening}>
    <text:Set name="dialogue" text={story.segment.opening-question.dialogue}/>
    <text:Set name="action" text={opening-action}/>
  </text:Render>

  <text:Value id="daily-creatine-action">
    GIRL is Host A (@image1, @audio1); GUY is Host B (@image2, @audio2).
    Only the current speaker speaks; the listener reacts silently.
    GIRL presents the creatine tub with cheerful, matter-of-fact confidence. On "Creatine", make its label easy
    to see; on the daily amount, give it one light indicating gesture and a small nod. Keep it secure in that hand.
    Her list of foods has a playful, almost obvious-to-her rhythm, with a relaxed illustrative gesture from the free hand.
    GUY shifts his seated posture with mild amused disbelief, then makes one compact open-hand gesture as
    "treating this as flour" lands. Let "flour" finish with falling intonation. Keep the banter brisk and natural;
    no finger counting or exaggerated reactions.
  </text:Value>

  <text:Value id="arms-are-asking-action">
    GIRL is Host A (@image1, @audio1); GUY is Host B (@image2, @audio2).
    Keep the exchange quick, relaxed and gently teasing. Each person speaks only their own lines.
    At first GIRL holds the tub and looks left with an amused half-smile. As she says "you need this way more
    than I do", she offers it toward the left edge of her frame. Cut on that offering action to GUY's view,
    where he receives it from the right; his holding reference supplies the resulting pose.
    GUY gives a small confused head shake and one palm-up gesture with his free hand while keeping the tub secure.
    On the return to GIRL, her hands are empty. She loosely folds her arms, then gestures toward him once as
    "Look at your arms!" lands with a confident nod. Make the change of possession clear through the cuts.
  </text:Value>

  <text:Render id="lifestyle-montage-prompt"
    template={broll-kit.broll-v1} recipe={recipes.broll.calm-ugc-montage}>
    <text:Set name="story" text={lifestyle-montage-story}/>
  </text:Render>

  <seedance:ReferenceVideo id="lifestyle-montage" model="mini"
    prompt={lifestyle-montage-prompt} duration="5"
    resolution="720p" aspect-ratio="9:16" generate-audio="false">
    <seedance:Reference image={coffee.image}/>
    <seedance:Reference image={smoothie.image}/>
    <seedance:Reference image={pasta.image}/>
  </seedance:ReferenceVideo>

  <text:Render id="daily-creatine-take-prompt"
    template={podcast-kit.podcast-v1} recipe={recipes.podcast.daily-creatine}>
    <text:Set name="dialogue" text={story.segment.daily-creatine.dialogue}/>
    <text:Set name="action" text={daily-creatine-action}/>
  </text:Render>

  <text:Render id="arms-are-asking-take-prompt"
    template={podcast-kit.podcast-v1} recipe={recipes.podcast.arms-are-asking}>
    <text:Set name="dialogue" text={story.segment.arms-are-asking.dialogue}/>
    <text:Set name="action" text={arms-are-asking-action}/>
  </text:Render>

  <seedance:ReferenceVideo id="opening-take" model="mini"
    prompt={opening-take-prompt} duration="5"
    resolution="720p" aspect-ratio="9:16" generate-audio="true">
    <seedance:Reference image={split.image}/>
    <seedance:Reference audio={guy-voice.reference}/>
  </seedance:ReferenceVideo>

  <seedance:ReferenceVideo id="daily-creatine-take" model="mini"
    prompt={daily-creatine-take-prompt} duration="8"
    resolution="720p" aspect-ratio="9:16" generate-audio="true">
    <seedance:Reference image={girl-hold.image}/>
    <seedance:Reference image={guy.image}/>
    <seedance:Reference audio={girl-voice.reference}/>
    <seedance:Reference audio={guy-voice.reference}/>
  </seedance:ReferenceVideo>

  <seedance:ReferenceVideo id="arms-are-asking-take" model="mini"
    prompt={arms-are-asking-take-prompt} duration="6"
    resolution="720p" aspect-ratio="9:16" generate-audio="true">
    <seedance:Reference image={girl-hold.image}/>
    <seedance:Reference image={guy-hold.image}/>
    <seedance:Reference audio={girl-voice.reference}/>
    <seedance:Reference audio={guy-voice.reference}/>
  </seedance:ReferenceVideo>

  <space:Canvas id="vertical" width="720" height="1280"/>
  <space:Frame id="full-frame" within={vertical}
    left="0%" top="0%" right="100%" bottom="100%"/>
  <program:Clock id="clock" frame-rate="30"/>

  <pipeline:Normalize id="soundtrack-media" source={soundtrack}
    video="none" audio="default" span-authority="audio" clock={clock}/>

  <pipeline:Normalize id="opening-media" source={opening-take.video}
    video="primary-moving" audio="default" span-authority="video" clock={clock}/>
  <pipeline:Normalize id="daily-creatine-media" source={daily-creatine-take.video}
    video="primary-moving" audio="default" span-authority="video" clock={clock}/>
  <pipeline:Normalize id="arms-are-asking-media" source={arms-are-asking-take.video}
    video="primary-moving" audio="default" span-authority="video" clock={clock}/>
  <pipeline:Normalize id="lifestyle-media" source={lifestyle-montage.video}
    video="primary-moving" audio="none" span-authority="video" clock={clock}/>

  <whisperx:SemanticTake id="opening-semantic" narrative={story}
    segment={story.segment.opening-question} media={opening-media.media} language="en"/>
  <whisperx:SemanticTake id="daily-creatine-semantic" narrative={story}
    segment={story.segment.daily-creatine} media={daily-creatine-media.media} language="en"/>
  <whisperx:SemanticTake id="arms-are-asking-semantic" narrative={story}
    segment={story.segment.arms-are-asking} media={arms-are-asking-media.media} language="en"/>


  <speech:Track id="speech">
    <speech:Take source={opening-semantic.take}/>
    <speech:Take source={daily-creatine-semantic.take}/>
    <speech:Take source={arms-are-asking-semantic.take}/>
  </speech:Track>
  <media-track:Track id="speech-picture" semantic={speech.semantic} canvas={vertical}>
    <media-track:Performance during="program" frame={full-frame}
      appearance={recipes.media.performance}/>
  </media-track:Track>

  <audio-track:Track id="music-bed" semantic={speech.semantic}>
    <audio-track:Clip source={soundtrack-media.media} during="program"
      playback="once-start" gain="0.12" fade-in="300ms" fade-out="600ms"/>
  </audio-track:Track>

  <media-track:Track id="lifestyle" semantic={speech.semantic} canvas={vertical}>
    <media-track:Item id="lifestyle-cutaway" media={lifestyle-media.media}
      frame={full-frame} during={story.selection.lifestyle}
      appearance={recipes.media.lifestyle}/>
  </media-track:Track>

  <fonts:Stack id="caption-font" family="montserrat" weight="900" style="normal"/>
  <caption-fine:Style id="caption-style" recipe={recipes.caption.original-girl}
    font={caption-font}/>
  <caption-fine:Style id="caption-guy-style" recipe={recipes.caption.original-guy}
    font={caption-font}/>
  <caption:Program id="caption-program" document={story.caption}
    narrative={story} default={caption-style}>
    <caption:Use role="GUY" style={caption-guy-style}/>
  </caption:Program>
  <caption-fine:Track id="captions" document={story.caption}
    semantic={speech.semantic} program={caption-program}/>

  <film:Film id="main" canvas={vertical} semantic={speech.semantic}
    appearance={recipes.film.vertical}>
    <film:Track source={speech-picture.visual}/>
    <film:Track source={speech.audio}/>
    <film:Track source={lifestyle.visual}/>
    <film:Track source={captions.track}/>
    <film:Track source={music-bed.track}/>
  </film:Film>

  <render:Video id="final" composition={main.composition}
    semantic={speech.semantic}/>
</svml>
