<!-- Proposed composite-v1 syntax; not implemented by the current compiler. -->
<kernel
  name="speech-program"
  abi="1"
  profile="composite-v1"
>

  <port
    name="script"
    direction="input"
    type="Script"
    cardinality="one"
  />

  <port
    name="production"
    direction="output"
    type="TemporalBasisProduction"
    cardinality="one"
  />

  <port
    name="program"
    direction="output"
    type="SpeechProgram"
    cardinality="one"
  />

  <port
    name="map"
    direction="output"
    type="ExactSemanticMap"
    cardinality="one"
  />

  <port
    name="facets.visual"
    direction="output"
    type="ProgramBoundVideo"
    cardinality="zero-or-one"
  />

  <param
    name="join"
    type="enum(cut,crossfade,gap)"
    default="cut"
  />

  <param
    name="joinDuration"
    style="join-duration"
    type="duration"
    default="0ms"
  />

  <child name="segment" cardinality="one-or-more">
    <field name="id" type="id" required="true"/>
    <field name="source" type="Video" required="true"/>
    <field name="sourceWindow" type="SourceRange"/>
  </child>

  <child name="join" cardinality="zero-or-more">
    <field name="after" type="id" required="true"/>
    <field name="overlap" type="duration"/>
    <field name="gap" type="duration"/>
    <field name="audio" type="enum(cut,crossfade)"/>
    <field name="visual" type="enum(cut,dissolve)"/>
  </child>

  <import
    as="basis-component"
    from="@svml/std/speech-assemble.svk"
  />

  <import
    as="locator-component"
    from="@svml/std/speech-locator.svk"
  />

  <compose>

    <basis-component
      id="basis"
      defaultJoin={params.join}
      defaultJoinDuration={params.joinDuration}
    >
      <for each={children.segment} as="item">
        <segment
          id={item.id}
          script={ports.script.segment[item.id]}
          source={item.source}
          sourceWindow={item.sourceWindow}
        />
      </for>

      <for each={children.join} as="join">
        <join
          after={join.after}
          overlap={join.overlap}
          gap={join.gap}
          audio={join.audio}
          visual={join.visual}
        />
      </for>
    </basis-component>

    <locator-component
      id="locator"
      script={ports.script}
      basis={basis.production}
    />

    <export
      port="production"
      value={basis.production}
    />

    <export
      port="map"
      value={locator.map}
    />

    <export port="program">
      <value
        production={basis.production}
        semantic={locator.map}
      />
    </export>

    <export
      port="facets.visual"
      value={basis.facets.visual}
    />

  </compose>

</kernel>
