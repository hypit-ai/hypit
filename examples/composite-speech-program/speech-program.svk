<kernel name="speech-program" abi="1" profile="composite-v1">
  <port name="script" direction="input" type="NarrativeIR" cardinality="one"/>
  <port name="evidence" direction="input" type="AlignmentEvidence" cardinality="one"/>
  <port name="production" direction="output" type="TemporalBasisProduction" cardinality="one"/>
  <port name="map" direction="output" type="ExactSemanticMap" cardinality="one"/>
  <port name="facets.visual" direction="output" type="ProgramBoundVideoSequence" cardinality="one"/>

  <param name="join" type="enum(cut,crossfade,gap)" default="cut"/>
  <param name="joinDuration" style="join-duration" type="duration" default="0ms"/>

  <child name="segment" cardinality="one-or-more">
    <field name="id" type="id" required="true"/>
    <field name="visual" type="Video"/>
    <field name="audio" type="Audio" required="true"/>
    <field name="sourceWindow" type="SourceRange" required="true"/>
  </child>

  <child name="join" cardinality="zero-or-more">
    <field name="after" type="id" required="true"/>
    <field name="overlap" type="duration"/>
    <field name="gap" type="duration"/>
    <field name="audio" type="enum(cut,crossfade)"/>
    <field name="visual" type="enum(cut,dissolve)"/>
  </child>

  <import as="assemble" from="../../stdlib/speech-assemble.svk"/>
  <import as="locate" from="../../stdlib/speech-locator.svk"/>

  <compose>
    <assemble id="basis" defaultJoin={params.join} defaultJoinDuration={params.joinDuration}>
      <for each={children.segment} as="item">
        <segment
          id={item.id}
          script={ports.script.segment[item.id]}
          visual={item.visual}
          audio={item.audio}
          sourceWindow={item.sourceWindow}
        />
      </for>
      <for each={children.join} as="join">
        <join
          after={join.after}
          overlap={join.overlap}
          gap={join.gap}
          audio={join.audio}
          visual={join.visual}
        />
      </for>
    </assemble>

    <locate id="locator" script={ports.script} basis={basis.production} evidence={ports.evidence}/>

    <export port="production" value={basis.production}/>
    <export port="map" value={locator.map}/>
    <export port="facets.visual" value={basis.facets.visual}/>
  </compose>
</kernel>
