<svml version="1">
  <import from="./speech-program.svk"/>
  <import from="../../stdlib/media-track.svk"/>
  <import from="../../stdlib/film.svk"/>
  <import as="house" from="./house.svs"/>

  <script>
    <segment id="intro">
      <HOST> Hello, this is SVML.
    </segment>

    <segment id="close">
      <HOST> Write the script, get the video.
    </segment>
  </script>

  <video id="host" src="../regen-ranking/assets/avatar-1.mp4"/>
  <audio id="host-audio" src="../regen-ranking/assets/avatar-1.mp3"/>
  <alignment id="alignment" src="./alignment.json"/>

  <speech-program id="voice" script={script} evidence={alignment} class="house.default">
    <segment id="intro" visual={host} audio={host-audio} sourceWindow="0s .. 5s"/>
    <segment id="close" visual={host} audio={host-audio} sourceWindow="5s .. 10s"/>
    <join after="intro" overlap="500ms" audio="crossfade" visual="dissolve"/>
  </speech-program>

  <media-track id="aroll" z="100">
    <item id="host" source={voice.facets.visual} during="full" playback="program-map"/>
  </media-track>

  <film id="main" basis={voice.production} semantic={voice.map} width="1080" height="1920">
    <track ref={aroll.track}/>
  </film>
</svml>
