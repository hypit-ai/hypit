<sheet version="1" id="house">

  film.vertical {
    width: 1080;
    height: 1920;
    frame-rate: 30;
    background: #09090B;
  }

  media-track.host-full {
    x: 0;
    y: 0;
    width: 1;
    height: 1;
    fit: cover;
  }

  media-track.face-top-left {
    x: 0.05;
    y: 0.06;
    width: 0.30;
    height: 0.30;
    fit: cover;
    mask: circle;
  }

  media-track.face-top-right {
    x: 0.65;
    y: 0.06;
    width: 0.30;
    height: 0.30;
    fit: cover;
    mask: circle;
  }

  media-track.face-bottom-right {
    x: 0.65;
    y: 0.64;
    width: 0.30;
    height: 0.30;
    fit: cover;
    mask: circle;
  }

  media-track.face-center {
    x: 0.35;
    y: 0.35;
    width: 0.30;
    height: 0.30;
    fit: cover;
    mask: circle;
  }

  media-track.host-lower-split {
    x: 0;
    y: 0.50;
    width: 1;
    height: 0.50;
    fit: cover;
  }

  media-track.host-corner-circle {
    x: 0.68;
    y: 0.70;
    width: 0.27;
    height: 0.27;
    fit: cover;
    mask: circle;
  }

  broll-track.broll-full {
    x: 0;
    y: 0;
    width: 1;
    height: 1;
    fit: cover;
  }

  ranking-column.ranking {
    x: 0.06;
    y: 0.14;
    width: 0.42;
    row-height: 0.071;
    gap: 0.018;
    stage-x: 0.66;
    stage-y: 0.73;
    stage-size: 0.33;
  }

  text-track.title {
    x: 0.06;
    y: 0.08;
    width: 0.88;
    height: 0.12;
    font-family: Inter, Arial, sans-serif;
    font-size: 64;
    font-weight: 850;
    fill: #FFFFFF;
  }

  text-track.arrow {
    x: 0.42;
    y: 0.80;
    width: 0.16;
    height: 0.14;
    font-size: 120;
    fill: #A78BFA;
  }

  caption-track.captions {
    x: 0.08;
    y: 0.78;
    width: 0.84;
    font-family: Inter, Arial, sans-serif;
    font-size: 56;
    font-weight: 800;
    fill: #FFFFFF;
  }

  caption-track.caption-emphasis {
    fill: #FDE047;
    active-fill: #FFFFFF;
    scale: 1.08;
  }

</sheet>
