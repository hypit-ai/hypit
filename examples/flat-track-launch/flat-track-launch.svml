<svml version="1">

  <import from="../../stdlib/speech-assemble.svk"/>
  <import from="../../stdlib/speech-locator.svk"/>
  <import from="../../stdlib/media-track.svk"/>
  <import from="../../stdlib/broll-track.svk"/>
  <import from="../../stdlib/ranking-column.svk"/>
  <import from="../../stdlib/text-track.svk"/>
  <import from="../../stdlib/caption-planner.svk"/>
  <import from="../../stdlib/caption-track.svk"/>
  <import from="../../stdlib/audio-track.svk"/>
  <import from="../../stdlib/film.svk"/>
  <import as="house" from="./launch.svs"/>

  <script>
    @whole

    <segment id="scene-1">
      <NARRATOR> @photoshop @emphasis Photoshop @/emphasis.
      <SPEAKER> Powerful, but only if you know how to use it. Otherwise, your new profile
                picture becomes a three-hour design project @/photoshop.
      <NARRATOR> @facetune Facetune.
      <SPEAKER> Fast and great for touch-ups. But it still leaves you with the same awkward
                pose and the same dorm-room background @/facetune.
    </segment>

    <segment id="scene-2">
      <NARRATOR> @remini Remini.
      <SPEAKER> Great for blurry photos. It restores detail, but it can't fix the pose,
                outfit, or background. You get the same bad photo in HD @/remini.
      <NARRATOR> @chatgpt ChatGPT.
      <SPEAKER> More flexible. It can create a new shot, but getting your face and the
                details right becomes a prompt-writing group project @/chatgpt.
    </segment>

    <segment id="scene-3">
      <NARRATOR> @ranking! @regen ReGen.
      <SPEAKER> Pick a photo you love, and the app @handsome-1 rebuilds it around you with a
                @/handsome-1~ @handsome-2 @emphasis better pose @/emphasis, outfit, and setting. @/handsome-2
                From one selfie, you can make @dating-photo a dating photo, @/dating-photo~
                @linkedin-headshot LinkedIn headshot, @/linkedin-headshot~
                @instagram-post or Instagram post, @/instagram-post
                so you get what you wanted instead of fixing a bad shot @/regen.
    </segment>

    @/whole~
  </script>

  <!-- These local artifacts are inputs; the example invokes no generation model. -->
  <video id="avatar-1" src="../regen-ranking/assets/avatar-1.mp4"/>
  <video id="avatar-2" src="../regen-ranking/assets/avatar-2.mp4"/>
  <video id="avatar-3" src="../regen-ranking/assets/avatar-3.mp4"/>
  <audio id="avatar-1-audio" src="../regen-ranking/assets/avatar-1.mp3"/>
  <audio id="avatar-2-audio" src="../regen-ranking/assets/avatar-2.mp3"/>
  <audio id="avatar-3-audio" src="../regen-ranking/assets/avatar-3.mp3"/>
  <image id="ranking-icon-1" src="../regen-ranking/assets/ranking-icon-1.jpg"/>
  <image id="ranking-icon-2" src="../regen-ranking/assets/ranking-icon-2.jpg"/>
  <image id="ranking-icon-3" src="../regen-ranking/assets/ranking-icon-3.jpg"/>
  <image id="ranking-icon-4" src="../regen-ranking/assets/ranking-icon-4.jpg"/>
  <image id="ranking-icon-5" src="../regen-ranking/assets/ranking-icon-5.jpg"/>
  <image id="broll-1" src="../regen-ranking/assets/broll-5.png"/>
  <audio id="ranking-appear" src="../regen-ranking/assets/ranking-appear.wav"/>
  <audio id="ranking-move" src="../regen-ranking/assets/ranking-move.wav"/>
  <audio id="music" src="../regen-ranking/assets/background.mp3"/>
  <timing id="timing" src="../regen-ranking/evidence/alignment.json"/>

  <!-- The Basis Producer and Locator are replaceable Components with typed outputs. -->
  <speech-assemble id="voice" fps="30" defaultJoin="cut">
    <segment id="scene-1" script={script.segment.scene-1} visual={avatar-1} audio={avatar-1-audio} sourceWindow="0s .. 12.033333333333333s"/>
    <segment id="scene-2" script={script.segment.scene-2} visual={avatar-2} audio={avatar-2-audio} sourceWindow="0s .. 12.033333333333333s"/>
    <segment id="scene-3" script={script.segment.scene-3} visual={avatar-3} audio={avatar-3-audio} sourceWindow="0s .. 12.033333333333333s"/>
  </speech-assemble>
  <speech-locator id="location" script={script} basis={voice.production} evidence={timing}/>

  <!-- One source mapping; Present only changes its projection in ProgramSpace. -->
  <media-track id="aroll" z="20">
    <item id="host" source={voice.facets.visual} during={script.selection.whole} class="house.host-full">
      <present id="opening-left"  during="0s .. 2.2s" z="31" class="house.face-top-left" exit="fade 200ms"/>
      <present id="opening-right" during="2s .. 4.2s" z="32" class="house.face-top-right" enter="fade 200ms" exit="fade 200ms"/>
      <present id="opening-low"   during="4s .. 6.2s" z="33" class="house.face-bottom-right" enter="fade 200ms" exit="fade 200ms"/>
      <present id="opening-full"  during="6s .. 8s" z="34" class="house.face-center" enter="fade 200ms"/>
      <present id="photoshop-split" during={script.selection.photoshop} z="35" class="house.host-lower-split"/>
      <present id="regen-pip" during={script.selection.regen} window="start-200ms .. end" z="36" class="house.host-corner-circle" enter="fade 200ms"/>
    </item>
  </media-track>

  <!-- B-roll keeps its own source audio and transition sound in the same Track. -->
  <broll-track id="broll" z="100">
    <item id="poster" source={broll-1} during={script.selection.handsome-1} playback="hold" class="house.broll-full"/>
    <item id="product-demo" source={avatar-3} during={script.selection.handsome-2} playback="stretch" sourceDuration="12.033333333333333" audio="source" volume="0.15" class="house.broll-full"/>
    <transition from="poster" to="product-demo" kind="crossfade" duration="200ms" sound={ranking-appear} volume="0.7"/>
  </broll-track>

  <!-- A Moment gates one independent Track; every item still owns its Selection. -->
  <ranking-column id="ranking" z="300" at={script.moment.ranking} class="house.ranking"
                  appearSound={ranking-appear} moveSound={ranking-move}>
    <item id="regen"     rank="1" image={ranking-icon-1} during={script.selection.regen}/>
    <item id="chatgpt"   rank="2" image={ranking-icon-2} during={script.selection.chatgpt}/>
    <item id="remini"    rank="3" image={ranking-icon-3} during={script.selection.remini}/>
    <item id="facetune"  rank="4" image={ranking-icon-4} during={script.selection.facetune}/>
    <item id="photoshop" rank="5" image={ranking-icon-5} during={script.selection.photoshop}/>
  </ranking-column>

  <!-- Manual ProgramSpans remain a deliberate escape hatch. -->
  <text-track id="overlays" z="400">
    <item id="opening-title" text="Semantic video starts with meaning." during="0s .. 3s" class="house.title"/>
    <item id="ending-arrow" text="↓" during="end-2s .. end" class="house.arrow"/>
  </text-track>

  <!-- The repeated emphasis Selection is disconnected and consumed as one set. -->
  <caption-planner id="caption-plan" script={script} semantic={location.map} maxWords="3"/>
  <caption-track id="captions" z="500" script={script} semantic={location.map} plan={caption-plan.plan} class="house.captions">
    <style id="emphasis" during={script.selection.emphasis} class="house.caption-emphasis"/>
    <style id="narrator" role="NARRATOR" activeColor="#73fbd3"/>
  </caption-track>

  <audio-track id="background-music">
    <item id="music" source={music} during="full" volume="0.28" bus="music"/>
  </audio-track>

  <!-- Child order is not paint order: absolute z across flat Tracks is authoritative. -->
  <film id="launch" basis={voice.production} semantic={location.map} class="house.vertical">
    <track ref={captions.track}/>
    <track ref={background-music.track}/>
    <track ref={broll.track}/>
    <track ref={overlays.track}/>
    <track ref={aroll.track}/>
    <track ref={ranking.track}/>
  </film>

</svml>
