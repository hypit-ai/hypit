{
  "format": "hypit.execution-environment-local@1",
  "dataRoot": ".hypit/environment/local",
  "credentials": {
    "local": {
      "use": "@hypit/credential-store-local"
    }
  },
  "endpoints": {
    "images.personal": {
      "use": "@example/provider-images",
      "config": {
        "baseUrl": "https://images.example",
        "apiKey": {
          "store": "local",
          "key": "images.personal"
        }
      }
    },
    "videos.personal": {
      "use": "@example/provider-videos",
      "config": {
        "baseUrl": "https://videos.example",
        "apiKey": {
          "store": "local",
          "key": "videos.personal"
        }
      }
    }
  },
  "bindings": {
    "@hypit/gpt-image#gpt-image-2": "images.personal",
    "@hypit/seedance#seedance-2-mini": "videos.personal"
  }
}
