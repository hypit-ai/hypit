<?svml using="@hypit/run-markup@1"?>

<!-- Gate 1: only the generated reference pictures, so every one can be reviewed
     before anything downstream is paid for. -->
<svrun version="1">
  <author source="./main.svml"/>

  <target output="presenter.image"/>
  <target output="paper.image"/>
  <target output="meme-post.image"/>
  <target output="thumbnail.image"/>
  <target output="newsletter.image"/>
  <target output="apple.image"/>
  <target output="microsoft.image"/>
  <target output="nasa.image"/>
</svrun>
