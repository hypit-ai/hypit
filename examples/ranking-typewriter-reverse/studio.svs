<?svml using="@hypit/svs@1"?>

<sheet version="1" id="studio">
  speech.normal {
    language: en;
    pace: normal;
    min: 4;
    max: 15;
    rounding: round;
  }

  /* The reference is one locked podcast setup cut into jump cuts, so the
     performance stays continuous and the camera never moves. */
  speaker.host {
    composition-stability: strict-locked;
    camera-motion: none;
    edit-rhythm: continuous-take;
    performance: natural-explainer;
    gesture: natural;
  }

  film.vertical { background: #000000; }
  speech.visual { fit: cover; }

  /* The graph-paper list. Positions are fractions of the full 1080x1920 Frame,
     read from the sheet as it appears in the reference: the title in the upper
     fifth, five numbered slots evenly spaced below it, and the item copy set in
     an upright handwriting face beside each number. */
  notepad.list {
    surface-fit: cover;

    title-x: 0.11;
    title-y: 0.185;
    title-width: 0.82;
    title-size: 92;
    title-line-height: 1.14;
    title-color: #1f1f1f;
    title-underline: 0;

    opening-x: 0.09;
    opening-y: 0.545;
    opening-width: 0.86;
    opening-size: 92;
    opening-line-height: 1.14;
    opening-color: #ffffff;
    opening-underline: 5;
    opening-shadow-x: 2;
    opening-shadow-y: 3;
    opening-shadow-blur: 12;
    opening-shadow-color: #00000099;

    row-x: 0.305;
    row-top: 0.372;
    row-width: 0.66;
    row-gap: 177;
    row-size: 62;
    row-line-height: 1.2;
    row-color: #1f1f1f;
    row-number-width: 100;

    mark-color: #1f1f1f;
    mark-stroke: 4;
    mark-pad-x: 26;
    mark-pad-y: 14;
    mark-rotate: -1.5;
    mark-frames: 9;

    title-type-frames: 2;
    row-type-frames: 3;

    surface-stack: 50;
    title-stack: 52;
    row-stack: 54;
    mark-stack: 56;
  }

  /* Inserted pictures. The reference cuts them straight in and straight out, so
     no insert carries an entrance or an exit operator. */
  media.panel {
    stack-order: 40;
    fit: cover;
    clip: frame;
    border-width: 1;
    border-style: solid;
    border-color: #FFFFFF66;
  }

  media.card {
    stack-order: 40;
    fit: cover;
    clip: rounded;
    radius: 14;
    border-width: 2;
    border-style: solid;
    border-color: #FFFFFFCC;
    shadows: 0 10 26 0 #000000A6;
  }

  media.sheet {
    stack-order: 40;
    fit: fit-width;
    fit-constraint: free;
    content-y: 0;
    frame-y: 0;
    clip: rounded;
    radius: 12;
    border-width: 2;
    border-style: solid;
    border-color: #111111;
    frame-paint: #FFFFFF;
  }

  media.logo {
    stack-order: 42;
    fit: contain;
  }

  motion.cut {
    enter: none;
    exit: none;
  }

  /* Captions. The default is the plain white lower-third the reference uses for
     most of the programme; the boxed variant is the same type on the solid black
     capsule it switches to over the newsletter. */
  caption.plain {
    cue-min-words: 1;
    cue-max-words: 3;
    stack-order: 70;
    x: 0.5; y: 0.675; width: 0.86;
    anchor-x: center; anchor-y: center;
    size: 56;
    line-height: 1.1;
    align: center;
    fill: #FFFFFF;
    stroke-color: #000000; stroke-width: 1;
    shadow-color: #000000; shadow-opacity: 0.55;
    shadow-x: 0; shadow-y: 3; shadow-blur: 7;
    background: #00000000; border-color: #00000000; border-width: 0;
    padding: 0 0; radius: 0;
    cue-enter: fade; cue-enter-frames: 1; cue-exit: fade; cue-exit-frames: 1;
  }

  caption.boxed {
    cue-min-words: 1;
    cue-max-words: 3;
    stack-order: 70;
    x: 0.5; y: 0.675; width: 0.86;
    anchor-x: center; anchor-y: center;
    size: 56;
    line-height: 1.1;
    align: center;
    fill: #FFFFFF;
    background: #000000FF; padding: 10 18; radius: 10;
    cue-enter: fade; cue-enter-frames: 1; cue-exit: fade; cue-exit-frames: 1;
  }
</sheet>
