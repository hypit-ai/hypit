<?svml using="@hypit/markup@1"?>

<svml>
  <import from="@hypit/script@1"/>
  <import as="wording" from="@hypit/text@1"/>
  <import as="seedance" from="@hypit/seedance@1"/>
  <import as="pipeline" from="@hypit/media-pipeline@1"/>
  <import as="speech" from="@hypit/speech-spine@1"/>
  <import as="whisperx" from="@hypit/whisperx@1"/>
  <import as="media-track" from="@hypit/media-track@1"/>
  <import as="caption" from="@hypit/caption@1"/>
  <import as="caption-fine" from="@hypit/caption-fine@1"/>
  <import as="caption-ai" from="@hypit/caption-gemini@1"/>
  <import as="fonts" from="@hypit/fonts-open@1"/>
  <import as="space" from="@hypit/spatial@1"/>
  <import as="program" from="@hypit/program-space@1"/>
  <import as="film" from="@hypit/film@1"/>
  <import as="render" from="@hypit/render-hyperframes@1"/>
  <import as="recipes" source="./recipes.svs"/>

  <!-- The words are the ones actually spoken in the recorded interview, so the
       Script and the picture describe the same programme. -->
  <script id="story">
    <hook>
      <A>How much was your flight?
      <B>$49. That's cheap. @seat The seat was cheap. The rainbow wasn't.@/seat
    </hook>
    <price>
      <A>They charged you for the rainbow?
      <B>@bags They counted it as seven carry-ons.@/bags
      <A>Why seven?
      <B>One bag for each color.
    </price>
    <rainbow>
      <A>Couldn't you turn it off?
      <B>I tried. @fee They charged me a @amount $35@/amount rainbow deactivation fee.@/fee
      <A>What was the total?
      <B>$2,846.
      <A>Do you have the receipt?
      <B>@receipt Yeah, but I can't screenshot the whole thing. It's still scrolling.@/receipt
    </rainbow>
    <payment>
      <A>How did you pay for it?
      <B>I took out a student loan.
      <A>But you're not in college.
      <B>@loan I am now. The airline enrolled me so I could finance the baggage fees.@/loan
    </payment>
  </script>

  <space:Canvas id="vertical" width="1080" height="1920"/>
  <program:Clock id="clock" frame-rate="24"/>
  <space:Frame id="speech-frame" within={vertical}
    left="0%" top="0%" right="100%" bottom="100%"/>
  <!-- The cutaways are shot 9:16 like the scenes, so they cut away from the
       whole frame rather than sitting inside it. right and bottom are edge
       positions, not insets. -->
  <space:Frame id="full" within={vertical}
    left="0%" top="0%" right="100%" bottom="100%"/>

  <wording:Value id="direction">Handheld street interview, late afternoon, two speakers.</wording:Value>
  <seedance:TextVideo id="take-hook" model="mini" prompt={direction} duration="5" generate-audio="true"/>
  <seedance:TextVideo id="take-price" model="mini" prompt={direction} duration="6" generate-audio="true"/>
  <seedance:TextVideo id="take-rainbow" model="mini" prompt={direction} duration="11" generate-audio="true"/>
  <seedance:TextVideo id="take-payment" model="mini" prompt={direction} duration="9" generate-audio="true"/>
  <seedance:TextVideo id="cutaway-bags" model="mini" prompt={direction} duration="4"/>
  <seedance:TextVideo id="cutaway-fee" model="mini" prompt={direction} duration="4"/>
  <seedance:TextVideo id="cutaway-receipt" model="mini" prompt={direction} duration="5"/>

  <pipeline:Normalize id="hook-media" source={take-hook.video}
    video="primary-moving" audio="default" span-authority="video" clock={clock}/>
  <pipeline:Normalize id="price-media" source={take-price.video}
    video="primary-moving" audio="default" span-authority="video" clock={clock}/>
  <pipeline:Normalize id="rainbow-media" source={take-rainbow.video}
    video="primary-moving" audio="default" span-authority="video" clock={clock}/>
  <pipeline:Normalize id="payment-media" source={take-payment.video}
    video="primary-moving" audio="default" span-authority="video" clock={clock}/>
  <pipeline:Normalize id="cutaway-bags-media" source={cutaway-bags.video}
    video="primary-moving" audio="none" span-authority="video" clock={clock}/>
  <pipeline:Normalize id="cutaway-fee-media" source={cutaway-fee.video}
    video="primary-moving" audio="none" span-authority="video" clock={clock}/>
  <pipeline:Normalize id="cutaway-receipt-media" source={cutaway-receipt.video}
    video="primary-moving" audio="none" span-authority="video" clock={clock}/>
  <whisperx:SemanticTake id="hook-semantic" narrative={story} segment={story.segment.hook} media={hook-media.media}/>
  <whisperx:SemanticTake id="price-semantic" narrative={story} segment={story.segment.price} media={price-media.media}/>
  <whisperx:SemanticTake id="rainbow-semantic" narrative={story} segment={story.segment.rainbow} media={rainbow-media.media}/>
  <whisperx:SemanticTake id="payment-semantic" narrative={story} segment={story.segment.payment} media={payment-media.media}/>

  <speech:Spine id="speech" clock={clock}
    visual-frame={speech-frame} visual-appearance={recipes.speech.visual} visual-z="0">
    <speech:Take source={hook-semantic.take}/>
    <speech:Take source={price-semantic.take}/>
    <speech:Take source={rainbow-semantic.take}/>
    <speech:Take source={payment-semantic.take}/>
  </speech:Spine>

  <fonts:Stack id="caption-font" family="inter" weight="700" style="normal"/>
  <caption-fine:Style id="base-caption" recipe={recipes.caption.base} font={caption-font}/>
  <caption:Program id="caption-program" display={story.caption} default={base-caption}/>
  <caption-ai:Planner id="cue-plan" display={story.caption} program={caption-program}
    model="gemini-2.5-flash"/>
  <caption-fine:Track id="captions" display={story.caption}
    correspondence={story.caption.correspondence}
    map={speech.semanticMap} space={speech.space}
    plan={cue-plan.plan} program={caption-program}/>

  <!-- Three cutaways on one Track. Their Selections do not overlap, so they
       share a single timeline row the way an editor would lay them out. -->
  <media-track:Track id="cutaways" map={speech.semanticMap} space={speech.space} canvas={vertical}>
    <media-track:Item id="bags" media={cutaway-bags-media.media} during={story.selection.bags}
      frame={full} appearance={recipes.media.cutaway} motion={recipes.motion.cut}/>
    <media-track:Item id="fee" media={cutaway-fee-media.media} during={story.selection.fee}
      frame={full} appearance={recipes.media.cutaway} motion={recipes.motion.cut}/>
    <media-track:Item id="receipt" media={cutaway-receipt-media.media} during={story.selection.receipt}
      frame={full} appearance={recipes.media.cutaway} motion={recipes.motion.drop}/>
  </media-track:Track>

  <film:Film id="main" canvas={vertical} space={speech.space} appearance={recipes.film.vertical}>
    <film:Track source={speech.visual}/>
    <film:Track source={speech.audioTrack}/>
    <film:Track source={cutaways.visual}/>
    <film:Track source={captions.track}/>
  </film:Film>
  <render:Video id="final" composition={main.composition} space={speech.space}/>
</svml>
