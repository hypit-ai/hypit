<?svml using="@hypit/markup@1"?>

<svml>
  <import from="@hypit/script@1"/>
  <import as="text" from="@hypit/text@1"/>
  <import as="media" from="@hypit/media@1"/>
  <import as="seedance" from="@hypit/seedance@1"/>
  <import as="program" from="@hypit/program-space@1"/>
  <import as="pipeline" from="@hypit/media-pipeline@1"/>
  <import as="whisperx" from="@hypit/whisperx@1"/>
  <import as="adjust" from="@hypit/semantic-take-adjust@1"/>
  <import as="speech" from="@hypit/speech-track@1"/>
  <import as="audio-track" from="@hypit/audio-track@1"/>
  <import as="caption" from="@hypit/caption@1"/>
  <import as="caption-fine" from="@hypit/caption-fine@1"/>
  <import as="fonts" from="@hypit/fonts-open@1"/>
  <import as="space" from="@hypit/spatial@1"/>
  <import as="screen" from="@hypit/screen-overlay@1"/>
  <import as="film" from="@hypit/film@1"/>
  <import as="render" from="@hypit/render-hyperframes@1"/>
  <import as="emoji" from="@hypit/interview-emoji-reveal@1"/>
  <import as="recipes" source="./recipes.svs"/>
  <import as="tracking" source="./spanish-tracking.svs"/>
  <import as="interview-kit" source="./kits/street-interview-v1.svs"/>

  <script id="story">
    <manifest-rule>
      <BOY>Oye! || Este Ferrari || es tuyo?
      <WIFE>@aja! Ajá.
      <BOY>Dame tres reglas || para ganar || tu primer millón.
      <WIFE>OK || la || primera || es || @manifest! Manifestar.
      <BOY>Manifestaste || un Ferrari?
      <WIFE>Me lo || repetí || cada || mañana.
    </manifest-rule>

    <real-estate-rule>
      <BOY>Y funcionó?
      <WIFE>No. || Pero || la dos || sí.
      <BOY>Dime.
      <WIFE>@real-estate! Bienes raíces. || Compra || el || edificio || y cóbrales || renta a || todos.
      <BOY>Pero || cómo compraste || el edificio?
      <WIFE>Esa || es || la tres.
    </real-estate-rule>

    <bitcoin-rule>
      <BOY>Espera qué?
      <WIFE>@bitcoin! Bitcoin. || Apreté || el || botón || equivocado || en <2012 | dos mil doce> || y gané || seis || cifras.
      <BOY>Compraste Bitcoin || por accidente?!
      <WIFE>Eso || es || manifestar, || cariño.
    </bitcoin-rule>
  </script>

  <text:Value id="interviewer-view-prompt">Photorealistic vertical street-interview frame showing interviewer view, natural handheld phone-camera texture, realistic people and background, no readable text or logos.</text:Value>
  <gpt:Image id="interviewer-view" prompt={interviewer-view-prompt} aspect-ratio="9:16" resolution="2K"/>
  <text:Value id="guest-view-prompt">Photorealistic vertical street-interview frame showing guest view, natural handheld phone-camera texture, realistic people and background, no readable text or logos.</text:Value>
  <gpt:Image id="guest-view" prompt={guest-view-prompt} aspect-ratio="9:16" resolution="2K"/>
  <text:Value id="shared-view-prompt">Photorealistic vertical street-interview frame showing shared view, natural handheld phone-camera texture, realistic people and background, no readable text or logos.</text:Value>
  <gpt:Image id="shared-view" prompt={shared-view-prompt} aspect-ratio="9:16" resolution="2K"/>
  <media:Audio id="boy-voice" src="./assets/guy.wav"/>
  <media:Audio id="wife-voice" src="./assets/wife.wav"/>
  <media:Audio id="soundtrack" src="./assets/shared-soundtrack.m4a"/>
  <media:Audio id="rule-reveal-sound" src="./assets/rule-reveal.wav"/>
  <text:Value id="rule-placeholder-prompt">Photorealistic vertical image of rule placeholder, natural lighting, realistic detail, clear composition, no readable text or logos.</text:Value>
  <gpt:Image id="rule-placeholder" prompt={rule-placeholder-prompt} aspect-ratio="9:16" resolution="2K"/>
  <text:Value id="manifest-icon-prompt">Clean colorful 3D emoji-style icon representing manifest, centered on a simple light background, crisp edges, no readable text.</text:Value>
  <gpt:Image id="manifest-icon" prompt={manifest-icon-prompt} aspect-ratio="1:1" resolution="1K"/>
  <text:Value id="real-estate-icon-prompt">Clean colorful 3D emoji-style icon representing real estate, centered on a simple light background, crisp edges, no readable text.</text:Value>
  <gpt:Image id="real-estate-icon" prompt={real-estate-icon-prompt} aspect-ratio="1:1" resolution="1K"/>
  <text:Value id="bitcoin-icon-prompt">Clean colorful 3D emoji-style icon representing bitcoin, centered on a simple light background, crisp edges, no readable text.</text:Value>
  <gpt:Image id="bitcoin-icon" prompt={bitcoin-icon-prompt} aspect-ratio="1:1" resolution="1K"/>

  <text:Value id="manifest-rule-action">
    BOY is interviewer A, the young man holding the microphone. WIFE is guest B, the woman holding her bag beside the Ferrari. Preserve their identities, outfits, props, left-right relationship, and the street location throughout.
    Begin in the exact shared two-person camera setup from @image3 and hold that complete frame for BOY's “Oye! ¿Este Ferrari es tuyo?” WIFE initially looks down while checking her bag. As BOY asks the question, he takes one step forward toward her. Hearing him, WIFE is briefly startled, then raises her head and looks at BOY.
    Hard cut directly to the exact WIFE camera setup from @image2 and hold that complete frame for “Ajá.” WIFE pouts slightly and nods.
    Hard cut directly to the exact shared camera setup from @image3 and hold that complete frame for BOY's “Dame tres reglas para ganar tu primer millón.” BOY speaks with natural explanatory hand gestures.
    Hard cut directly to the exact WIFE camera setup from @image2 and hold that complete frame for “OK, la primera es manifestar.” WIFE tilts her head and rests one hand lightly against her chin.
    Hard cut directly to the exact BOY camera setup from @image1 and hold that complete frame for “¿Manifestaste un Ferrari?” BOY makes a visibly surprised hand gesture while asking.
    Hard cut directly to the exact WIFE camera setup from @image2 and hold that complete frame for “Me lo repetí cada mañana.” WIFE uses the hand not holding her bag to pat her upper chest while speaking.
  </text:Value>

  <text:Value id="real-estate-rule-action">
    BOY is interviewer A, the young man holding the microphone. WIFE is guest B, the woman holding her bag beside the Ferrari. Preserve their identities, outfits, props, left-right relationship, and the street location throughout.
    Begin in the exact shared two-person camera setup from @image3 and hold that complete frame for BOY's “¿Y funcionó?” BOY uses a natural questioning hand gesture.
    Hard cut directly to the exact WIFE camera setup from @image2 and hold that complete frame for “No. Pero la dos sí.” WIFE shakes her head on “No,” then looks at BOY meaningfully as she delivers the second sentence.
    Hard cut directly to the exact shared camera setup from @image3 and hold that complete frame for BOY's short line, “Dime.”
    Hard cut directly to the exact WIFE camera setup from @image2 and hold that complete frame for “Bienes raíces. Compra el edificio y cóbrales renta a todos.” WIFE plants the hand holding her bag on her hip and lightly waves her free hand as she speaks, looking bold and expansive.
    Hard cut directly to the exact BOY camera setup from @image1 and hold that complete frame for “¿Pero cómo compraste el edificio?” BOY asks with visible disbelief.
    Hard cut directly to the exact WIFE camera setup from @image2 and hold that complete frame for “Esa es la tres.” WIFE folds her arms, tilts her head, and gives a small smile.
  </text:Value>

  <text:Value id="bitcoin-rule-action">
    BOY is interviewer A, the young man holding the microphone. WIFE is guest B, the woman holding her bag beside the Ferrari. Preserve their identities, outfits, props, left-right relationship, and the street location throughout.
    Use only the three exact camera compositions supplied by @image1, @image2, and @image3. Every shot must be a direct hard cut to one of those complete reference compositions and must hold that composition unchanged. Do not invent any other framing, camera position, reverse angle, over-the-shoulder view, push-in, orbit, reframe, crop, or camera movement.
    BOY's face must never be shown front-on at any time. Whenever BOY is visible, preserve only the same side-profile orientation established by @image1 and @image3. He keeps looking toward WIFE and never turns his face toward the camera, including while speaking or reacting.
    Begin in the exact shared two-person camera setup from @image3 and hold that complete frame for BOY's “¿Espera, qué?” BOY makes a questioning hand gesture.
    Hard cut directly to the exact WIFE camera setup from @image2 and hold that complete frame for “Bitcoin. Apreté el botón equivocado en dos mil doce y gané seis cifras.” WIFE raises one finger while explaining, then makes a broad emphatic hand gesture to show how much money she made.
    Hard cut directly to the exact BOY side-profile camera setup from @image1 and hold that complete frame for “¿Compraste Bitcoin por accidente?” BOY reacts with astonished disbelief while keeping his head in the same side-profile orientation and looking only toward WIFE.
    Hard cut directly to the exact WIFE camera setup from @image2 and hold that complete frame for “Eso es manifestar, cariño.” WIFE tilts her head with a cheeky, flirtatious attitude, then turns to her left at the end of the line as if preparing to walk away.
  </text:Value>

  <text:Render id="manifest-rule-prompt"
    template={interview-kit.street-interview-v1}
    recipe={recipes.interview.street}>
    <text:Set name="dialogue" text={story.segment.manifest-rule.dialogue}/>
    <text:Set name="action" text={manifest-rule-action}/>
  </text:Render>
  <text:Render id="real-estate-rule-prompt"
    template={interview-kit.street-interview-v1}
    recipe={recipes.interview.street}>
    <text:Set name="dialogue" text={story.segment.real-estate-rule.dialogue}/>
    <text:Set name="action" text={real-estate-rule-action}/>
  </text:Render>
  <text:Render id="bitcoin-rule-prompt"
    template={interview-kit.street-interview-v1}
    recipe={recipes.interview.street}>
    <text:Set name="dialogue" text={story.segment.bitcoin-rule.dialogue}/>
    <text:Set name="action" text={bitcoin-rule-action}/>
  </text:Render>

  <seedance:ReferenceVideo id="manifest-rule-take"
    model="mini" prompt={manifest-rule-prompt}
    duration="10"
    resolution="720p" aspect-ratio="9:16" generate-audio="true">
    <seedance:Reference image={interviewer-view}/>
    <seedance:Reference image={guest-view}/>
    <seedance:Reference image={shared-view}/>
    <seedance:Reference audio={boy-voice}/>
    <seedance:Reference audio={wife-voice}/>
  </seedance:ReferenceVideo>

  <seedance:ReferenceVideo id="real-estate-rule-take"
    model="mini" prompt={real-estate-rule-prompt}
    duration="8"
    resolution="720p" aspect-ratio="9:16" generate-audio="true">
    <seedance:Reference image={interviewer-view}/>
    <seedance:Reference image={guest-view}/>
    <seedance:Reference image={shared-view}/>
    <seedance:Reference audio={boy-voice}/>
    <seedance:Reference audio={wife-voice}/>
  </seedance:ReferenceVideo>

  <seedance:ReferenceVideo id="bitcoin-rule-take"
    model="mini" prompt={bitcoin-rule-prompt}
    duration="8"
    resolution="720p" aspect-ratio="9:16" generate-audio="true">
    <seedance:Reference image={interviewer-view}/>
    <seedance:Reference image={guest-view}/>
    <seedance:Reference image={shared-view}/>
    <seedance:Reference audio={boy-voice}/>
    <seedance:Reference audio={wife-voice}/>
  </seedance:ReferenceVideo>

  <space:Canvas id="vertical" width="720" height="1280"/>
  <space:RegionTimeline id="wife-heads" within={vertical}
    recipe={tracking.heads.wife}/>
  <space:Frame id="full-frame" within={vertical}
    left="0%" top="0%" right="100%" bottom="100%"/>
  <program:Clock id="clock" frame-rate="30"/>

  <pipeline:Normalize id="soundtrack-media" source={soundtrack}
    video="none" audio="default" span-authority="audio" clock={clock}/>
  <pipeline:Normalize id="rule-reveal-sound-media" source={rule-reveal-sound}
    video="none" audio="default" span-authority="audio" clock={clock}/>

  <pipeline:Normalize id="manifest-rule-media" source={manifest-rule-take.video}
    video="primary-moving" audio="default" span-authority="video" clock={clock}/>
  <pipeline:Normalize id="real-estate-rule-media" source={real-estate-rule-take.video}
    video="primary-moving" audio="default" span-authority="video" clock={clock}/>
  <pipeline:Normalize id="bitcoin-rule-media" source={bitcoin-rule-take.video}
    video="primary-moving" audio="default" span-authority="video" clock={clock}/>

  <whisperx:SemanticTake id="manifest-rule-semantic" narrative={story}
    segment={story.segment.manifest-rule} media={manifest-rule-media.media} language="es"/>
  <whisperx:SemanticTake id="real-estate-rule-semantic" narrative={story}
    segment={story.segment.real-estate-rule} media={real-estate-rule-media.media} language="es"/>
  <whisperx:SemanticTake id="bitcoin-rule-semantic" narrative={story}
    segment={story.segment.bitcoin-rule} media={bitcoin-rule-media.media} language="es"/>

  <adjust:SemanticTake id="manifest-rule-corrected" source={manifest-rule-semantic.take}>
    <adjust:Anchor at={story.moment.aja} frame="63"/>
  </adjust:SemanticTake>

  <speech:Track id="speech" visual-frame={full-frame}
    visual-appearance={recipes.speech.visual} visual-z="10">
    <speech:Take source={manifest-rule-corrected.take}/>
    <speech:Take source={real-estate-rule-semantic.take}/>
    <speech:Take source={bitcoin-rule-semantic.take}/>
  </speech:Track>

  <audio-track:Track id="music-bed" semantic={speech.semantic}>
    <audio-track:Clip source={soundtrack-media.media} during="program"
      playback="once-start" gain="0.12" fade-in="300ms" fade-out="600ms"/>
  </audio-track:Track>

  <audio-track:Track id="rule-reveal-sfx" semantic={speech.semantic}>
    <audio-track:Clip id="manifest-reveal-sfx" source={rule-reveal-sound-media.media}
      at={story.moment.manifest} for="20f" playback="once-start" gain="0.20"/>
    <audio-track:Clip id="real-estate-reveal-sfx" source={rule-reveal-sound-media.media}
      at={story.moment.real-estate} for="20f" playback="once-start" gain="0.20"/>
    <audio-track:Clip id="bitcoin-reveal-sfx" source={rule-reveal-sound-media.media}
      at={story.moment.bitcoin} for="20f" playback="once-start" gain="0.20"/>
  </audio-track:Track>

  <fonts:Stack id="caption-font" family="league-spartan" weight="900" style="normal"/>
  <caption-fine:Style id="caption-boy-style" recipe={recipes.caption.boy}
    font={caption-font}/>
  <caption-fine:Style id="caption-wife-style" recipe={recipes.caption.wife}
    font={caption-font}/>
  <caption:Program id="caption-program" document={story.caption}
    narrative={story} default={caption-boy-style}>
    <caption:Use role="WIFE" style={caption-wife-style}/>
  </caption:Program>
  <caption-fine:Track id="captions" document={story.caption}
    semantic={speech.semantic} program={caption-program} regions={wife-heads}/>

  <emoji:Style id="rule-reveal-style" recipe={recipes.emoji.strip}/>
  <emoji:Track id="rule-reveal" semantic={speech.semantic} canvas={vertical}
    style={rule-reveal-style} placeholder={rule-placeholder} during="program">
    <emoji:Item id="manifest" icon={manifest-icon} at={story.moment.manifest}/>
    <emoji:Item id="real-estate" icon={real-estate-icon} at={story.moment.real-estate}/>
    <emoji:Item id="bitcoin" icon={bitcoin-icon} at={story.moment.bitcoin}/>
  </emoji:Track>

  <screen:Track id="rule-reveal-flashes" semantic={speech.semantic} canvas={vertical}>
    <screen:Flash id="manifest-flash" at={story.moment.manifest} for="8f" z="80"
      color="#FF4D6D" intensity="0.28" attack="2" hold="1" decay="5"/>
    <screen:Flash id="real-estate-flash" at={story.moment.real-estate} for="8f" z="80"
      color="#14A68A" intensity="0.28" attack="2" hold="1" decay="5"/>
    <screen:Flash id="bitcoin-flash" at={story.moment.bitcoin} for="8f" z="80"
      color="#F59E0B" intensity="0.28" attack="2" hold="1" decay="5"/>
  </screen:Track>

  <film:Film id="main" canvas={vertical} semantic={speech.semantic}
    appearance={recipes.film.vertical}>
    <film:Track source={speech.visual}/>
    <film:Track source={speech.audio}/>
    <film:Track source={captions.track}/>
    <film:Track source={rule-reveal.track}/>
    <film:Track source={rule-reveal-flashes.track}/>
    <film:Track source={music-bed.track}/>
    <film:Track source={rule-reveal-sfx.track}/>
  </film:Film>

  <render:Video id="final" composition={main.composition}
    semantic={speech.semantic}/>
</svml>
