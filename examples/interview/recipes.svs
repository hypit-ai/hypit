  emoji.strip {
    center-x: 0.5;
    top-y: 0.07;
    slot-size: 72;
    slot-gap: 10;
    padding-x: 18;
    padding-y: 14;
    background: #FFFDF7;
    border-color: #161616;
    border-width: 4;
    radius: 22;
    shadow-color: #000000B8;
    shadow-x: 9;
    shadow-y: 10;
    shadow-blur: 0;
    shadow-spread: 0;
    icon-size: 54;
    reveal-frames: 6;
