<?svml using="@hypit/markup@1"?>

<svml>
  <import as="audio" from="@hypit/audio-track@1"/>
  <import as="visual" from="@hypit/visual-track@1"/>
  <import from="@hypit/script@1"/>
  <import as="text" from="@hypit/text@1"/>
  <import as="media" from="@hypit/media@1"/>
  <import as="seedance" from="@hypit/seedance@1"/>
  <import as="gpt" from="@hypit/gpt-image@1"/>
  <import as="mediaop" from="@hypit/media-operations@1"/>
  <import as="whisperx" from="@hypit/whisperx@1"/>
  <import as="speechalign" from="@hypit/narrative-speech-alignment@1"/>
  <import as="semantic" from="@hypit/narrative-temporal@1"/>
  <import as="narrative-caption" from="@hypit/narrative-caption@1"/>
  <import as="time" from="@hypit/timeline-author@1"/>
  <import as="audio-track" from="@hypit/audio-track@1"/>
  <import as="caption" from="@hypit/caption@1"/>
  <import as="caption-fine" from="@hypit/caption-fine@1"/>
  <import as="fonts" from="@hypit/fontsource@1"/>
  <import as="space" from="@hypit/spatial@1"/>
  <import as="sequence" from="@hypit/spatial-sequence@1"/>
  <import as="flash" from="@interview/flash@1"/>
  <import as="film" from="@hypit/film@1"/>
  <import as="html" from="@hypit/html-video@1"/>
  <import as="emoji" from="@hypit/interview-emoji-reveal@1"/>
  <import as="recipes" source="./recipes.svs"/>
  <import as="interview-kit" source="@hypit/seedance-kits/street-interview"/>
  <import as="wojak-tracking" source="./wojak-tracking.regions.svml"/>

  <script id="story">
    <manifest-rule>
      <CHAD>Hey yo! || Is this Lamborghini || yours?
      <WOJAK>Um, || yeah.
      <CHAD>Give me three rules || to make your || first million.
      <WOJAK>OK || the || first one || is || @{manifest!} Manifest.
      <CHAD>You manifested || a Lamborghini?
      <WOJAK>I || whispered || it || to || myself || in || the || shower.
    </manifest-rule>

    <real-estate-rule>
      <CHAD>Did it really || work?
      <WOJAK>No. || But || rule two || did.
      <CHAD>Say it.
      <WOJAK>@{real-estate!} Real estate. || Buy || the || building, || and || charge || everyone || rent.
      <CHAD>But how did you || buy the building?
      <WOJAK>That's || rule three.
    </real-estate-rule>

    <bitcoin-rule>
      <CHAD>Wait what?
      <WOJAK>@{bitcoin!} Bitcoin. || I || pressed || the || wrong || button || in <2012 | twenty twelve> || and || made || six figures.
      <CHAD>So you || accidentally || bought Bitcoin?!
      <WOJAK>That's || manifesting, || bro.
    </bitcoin-rule>
  </script>

  <text:Value id="interviewer-view-prompt">A photograph with the texture of real iPhone footage. Generate a vertical street-interview frame, as one frame cut out of video actually shot on an iPhone: genuinely real rather than glossy, carrying the texture of video and not of a posed photograph. The background stays clearly visible, with no depth-of-field blur. Skin texture is fine and real, the light is natural, and no part of the picture is broken. The interviewer is a blond, bearded flat 2D line-art character with a long face, simple dot eyes, a black jacket, and a handheld microphone. Keep the illustrated contours and flat fills crisp against the photographic street.</text:Value>
  <gpt:Image id="interviewer-view" prompt={interviewer-view-prompt} aspect-ratio="9:16" resolution="2K"/>
  <text:Value id="guest-view-prompt">A photograph with the texture of real iPhone footage. Generate a vertical street-interview frame, as one frame cut out of video actually shot on an iPhone: genuinely real rather than glossy, carrying the texture of video and not of a posed photograph. The background stays clearly visible, with no depth-of-field blur. Skin texture is fine and real, the light is natural, and no part of the picture is broken. The guest is a black-clad flat 2D line-art meme character with a simple oval face, minimal drawn features, and a compact shoulder silhouette. Keep the illustrated contours and flat fills crisp against the photographic street.</text:Value>
  <gpt:Image id="guest-view" prompt={guest-view-prompt} aspect-ratio="9:16" resolution="2K"/>
  <text:Value id="shared-view-prompt">A photograph with the texture of real iPhone footage. Generate a vertical street-interview frame, as one frame cut out of video actually shot on an iPhone: genuinely real rather than glossy, carrying the texture of video and not of a posed photograph. The background stays clearly visible, with no depth-of-field blur. Skin texture is fine and real, the light is natural, and no part of the picture is broken. Show the blond-bearded flat 2D interviewer and the black-clad flat 2D guest together beside the blue Lamborghini, preserving their illustrated faces, hair, clothing, microphone, and left-right relationship against the photographic street.</text:Value>
  <gpt:Image id="shared-view" prompt={shared-view-prompt} aspect-ratio="9:16" resolution="2K"/>
  <media:Audio id="chad-voice" src="./assets/chad.wav"/>
  <media:Audio id="wojak-voice" src="./assets/wojak.wav"/>
  <media:Audio id="soundtrack" src="./assets/shared-soundtrack.m4a"/>
  <media:Audio id="rule-reveal-sound" src="./assets/rule-reveal.wav"/>
  <text:Value id="rule-placeholder-prompt">A clean, colorful 3D question-mark icon centered on a simple light background, with crisp edges and no readable text.</text:Value>
  <gpt:Image id="rule-placeholder" prompt={rule-placeholder-prompt} aspect-ratio="9:16" resolution="2K"/>
  <text:Value id="manifest-icon-prompt">A photograph with the texture of real iPhone footage. Generate a vertical medium close-up, as one frame cut out of video actually shot on an iPhone: genuinely real rather than glossy, carrying the texture of video and not of a posed photograph. The background stays clearly visible, with no depth-of-field blur. Skin texture is fine and real, the light is natural, and no part of the picture is broken. A carefully framed photorealistic image with the subject centered and the required object or pose clearly visible. Keep the background concise and unobtrusive.</text:Value>
  <gpt:Image id="manifest-icon" prompt={manifest-icon-prompt} aspect-ratio="1:1" resolution="1K"/>
  <text:Value id="real-estate-icon-prompt">A photograph with the texture of real iPhone footage. Generate a vertical medium close-up, as one frame cut out of video actually shot on an iPhone: genuinely real rather than glossy, carrying the texture of video and not of a posed photograph. The background stays clearly visible, with no depth-of-field blur. Skin texture is fine and real, the light is natural, and no part of the picture is broken. A carefully framed photorealistic image with the subject centered and the required object or pose clearly visible. Keep the background concise and unobtrusive.</text:Value>
  <gpt:Image id="real-estate-icon" prompt={real-estate-icon-prompt} aspect-ratio="1:1" resolution="1K"/>
  <text:Value id="bitcoin-icon-prompt">A photograph with the texture of real iPhone footage. Generate a vertical medium close-up, as one frame cut out of video actually shot on an iPhone: genuinely real rather than glossy, carrying the texture of video and not of a posed photograph. The background stays clearly visible, with no depth-of-field blur. Skin texture is fine and real, the light is natural, and no part of the picture is broken. A carefully framed photorealistic image with the subject centered and the required object or pose clearly visible. Keep the background concise and unobtrusive.</text:Value>
  <gpt:Image id="bitcoin-icon" prompt={bitcoin-icon-prompt} aspect-ratio="1:1" resolution="1K"/>

  <text:Value id="manifest-rule-action">
    CHAD is interviewer A, the blond bearded 2D character holding the microphone. WOJAK is guest B, the black-clad 2D character beside the Lamborghini. Preserve their identities, outfits, props, left-right relationship, street location, and supplied camera setups throughout.
    STYLE LOCK: CHAD and WOJAK remain exactly the same flat 2D line-art meme characters shown in the references, with crisp black contour lines, simple drawn facial features, and flat color fills. Their faces, hair, clothing, hands, and body shapes remain visibly illustrated in every frame and every expression. The street, building, trees, and Lamborghini remain photographic, preserving the deliberate 2D-character-on-photographic-background mixed-media composition.
    Begin in the exact shared two-person camera setup from @image3 and hold that complete frame for CHAD's “Hey yo! Is this Lamborghini yours?” WOJAK initially glances down toward the car, then raises his head and looks at CHAD as the question lands.
    Hard cut directly to the exact WOJAK camera setup from @image2 and hold that complete frame for “Um, yeah.” WOJAK gives a small hesitant nod.
    Hard cut directly to the exact shared camera setup from @image3 and hold that complete frame for CHAD's “Give me three rules to make your first million.” CHAD speaks with natural explanatory hand gestures while keeping the microphone in the same hand.
    Hard cut directly to the exact WOJAK camera setup from @image2 and hold that complete frame for “OK, the first one is manifest.” WOJAK tilts his head and rests one hand lightly against his chin.
    Hard cut directly to the exact CHAD camera setup from @image1 and hold that complete frame for “You manifested a Lamborghini?” CHAD makes a visibly surprised hand gesture while asking.
    Hard cut directly to the exact WOJAK camera setup from @image2 and hold that complete frame for “I whispered it to myself in the shower.” WOJAK remains in the same street setup, leans slightly toward the microphone, and makes a small confidential whispering gesture beside his mouth.
  </text:Value>

  <text:Value id="real-estate-rule-action">
    CHAD is interviewer A, the blond bearded 2D character holding the microphone. WOJAK is guest B, the black-clad 2D character beside the Lamborghini. Preserve their identities, outfits, props, left-right relationship, street location, and supplied camera setups throughout.
    STYLE LOCK: CHAD and WOJAK remain exactly the same flat 2D line-art meme characters shown in the references, with crisp black contour lines, simple drawn facial features, and flat color fills. Their faces, hair, clothing, hands, and body shapes remain visibly illustrated in every frame and every expression. The street, building, trees, and Lamborghini remain photographic, preserving the deliberate 2D-character-on-photographic-background mixed-media composition.
    Begin in the exact shared two-person camera setup from @image3 and hold that complete frame for CHAD's “Did it really work?” CHAD uses a natural questioning hand gesture.
    Hard cut directly to the exact WOJAK camera setup from @image2 and hold that complete frame for “No. But rule two did.” WOJAK shakes his head on “No,” then looks at CHAD meaningfully as he delivers the second sentence.
    Hard cut directly to the exact shared camera setup from @image3 and hold that complete frame for CHAD's short line, “Say it.”
    Hard cut directly to the exact WOJAK camera setup from @image2 and hold that complete frame for “Real estate. Buy the building, and charge everyone rent.” WOJAK loosely plants one hand on his hip and lightly waves the other as he speaks, becoming unexpectedly bold and expansive.
    Hard cut directly to the exact CHAD camera setup from @image1 and hold that complete frame for “But how did you buy the building?” CHAD asks with visible disbelief.
    Hard cut directly to the exact WOJAK camera setup from @image2 and hold that complete frame for “That's rule three.” WOJAK folds his arms, tilts his head, and gives a small knowing smile.
  </text:Value>

  <text:Value id="bitcoin-rule-action">
    CHAD is interviewer A, the blond bearded 2D character holding the microphone. WOJAK is guest B, the black-clad 2D character beside the Lamborghini. Preserve their identities, outfits, props, left-right relationship, street location, and supplied camera setups throughout.
    STYLE LOCK: CHAD and WOJAK remain exactly the same flat 2D line-art meme characters shown in the references, with crisp black contour lines, simple drawn facial features, and flat color fills. Their faces, hair, clothing, hands, and body shapes remain visibly illustrated in every frame and every expression. The street, building, trees, and Lamborghini remain photographic, preserving the deliberate 2D-character-on-photographic-background mixed-media composition.
    Begin in the exact shared two-person camera setup from @image3 and hold that complete frame for CHAD's “Wait what?” CHAD makes a questioning hand gesture.
    Hard cut directly to the exact WOJAK camera setup from @image2 and hold that complete frame for “Bitcoin. I pressed the wrong button in twenty twelve and made six figures.” WOJAK raises one finger while explaining, then makes a broad emphatic hand gesture to show how much money he made.
    Hard cut directly to the exact CHAD camera setup from @image1 and hold that complete frame for “So you accidentally bought Bitcoin?” CHAD reacts with astonished disbelief.
    Hard cut directly to the exact WOJAK camera setup from @image2 and hold that complete frame for “That's manifesting, bro.” WOJAK tilts his head with a smug, friendly expression and gives CHAD a small confident nod.
  </text:Value>

  <text:Render id="manifest-rule-prompt"
    template={interview-kit.street-interview-v1}
    recipe={recipes.interview.street}>
    <text:Set name="dialogue" text={story.segment.manifest-rule.dialogue}/>
    <text:Set name="action" text={manifest-rule-action}/>
  </text:Render>
  <text:Render id="real-estate-rule-prompt"
    template={interview-kit.street-interview-v1}
    recipe={recipes.interview.street}>
    <text:Set name="dialogue" text={story.segment.real-estate-rule.dialogue}/>
    <text:Set name="action" text={real-estate-rule-action}/>
  </text:Render>
  <text:Render id="bitcoin-rule-prompt"
    template={interview-kit.street-interview-v1}
    recipe={recipes.interview.street}>
    <text:Set name="dialogue" text={story.segment.bitcoin-rule.dialogue}/>
    <text:Set name="action" text={bitcoin-rule-action}/>
  </text:Render>

  <seedance:ReferenceVideo id="manifest-rule-take"
    model="mini" prompt={manifest-rule-prompt}
    duration="10"
    resolution="720p" aspect-ratio="9:16" generate-audio="true">
    <seedance:Reference image={interviewer-view.image} person-reference="true"/>
    <seedance:Reference image={guest-view.image} person-reference="true"/>
    <seedance:Reference image={shared-view.image} person-reference="true"/>
    <seedance:Reference audio={chad-voice}/>
    <seedance:Reference audio={wojak-voice}/>
  </seedance:ReferenceVideo>

  <seedance:ReferenceVideo id="real-estate-rule-take"
    model="mini" prompt={real-estate-rule-prompt}
    duration="8"
    resolution="720p" aspect-ratio="9:16" generate-audio="true">
    <seedance:Reference image={interviewer-view.image} person-reference="true"/>
    <seedance:Reference image={guest-view.image} person-reference="true"/>
    <seedance:Reference image={shared-view.image} person-reference="true"/>
    <seedance:Reference audio={chad-voice}/>
    <seedance:Reference audio={wojak-voice}/>
  </seedance:ReferenceVideo>

  <seedance:ReferenceVideo id="bitcoin-rule-take"
    model="mini" prompt={bitcoin-rule-prompt}
    duration="8"
    resolution="720p" aspect-ratio="9:16" generate-audio="true">
    <seedance:Reference image={interviewer-view.image} person-reference="true"/>
    <seedance:Reference image={guest-view.image} person-reference="true"/>
    <seedance:Reference image={shared-view.image} person-reference="true"/>
    <seedance:Reference audio={chad-voice}/>
    <seedance:Reference audio={wojak-voice}/>
  </seedance:ReferenceVideo>

  <space:Canvas id="vertical" width="720" height="1280"/>
  <space:Frame id="full-frame" within={vertical.bounds}
    left="0%" top="0%" right="100%" bottom="100%"/>
  <time:Clock id="clock" frame-rate="30"/>

  <mediaop:Prepare id="soundtrack-media" source={soundtrack}
    video="none" audio="default" span-authority="audio"/>
  <mediaop:Prepare id="rule-reveal-sound-media" source={rule-reveal-sound}
    video="none" audio="default" span-authority="audio"/>

  <mediaop:Prepare id="manifest-rule-media" source={manifest-rule-take.video}
    video="primary-moving" audio="default" span-authority="video"/>
  <mediaop:Prepare id="real-estate-rule-media" source={real-estate-rule-take.video}
    video="primary-moving" audio="default" span-authority="video"/>
  <mediaop:Prepare id="bitcoin-rule-media" source={bitcoin-rule-take.video}
    video="primary-moving" audio="default" span-authority="video"/>

  <whisperx:Transcription id="manifest-rule-semantic-transcription" media={manifest-rule-media.media} language="en"/>
  <speechalign:Alignment id="manifest-rule-semantic" narrative={story}
    segment={story.segment.manifest-rule} domain={manifest-rule-media.domain} evidence={manifest-rule-semantic-transcription.transcript}/>
  <whisperx:Transcription id="real-estate-rule-semantic-transcription" media={real-estate-rule-media.media} language="en"/>
  <speechalign:Alignment id="real-estate-rule-semantic" narrative={story}
    segment={story.segment.real-estate-rule} domain={real-estate-rule-media.domain} evidence={real-estate-rule-semantic-transcription.transcript}/>
  <whisperx:Transcription id="bitcoin-rule-semantic-transcription" media={bitcoin-rule-media.media} language="en"/>
  <speechalign:Alignment id="bitcoin-rule-semantic" narrative={story}
    segment={story.segment.bitcoin-rule} domain={bitcoin-rule-media.domain} evidence={bitcoin-rule-semantic-transcription.transcript}/>

  <time:Timeline id="speech" clock={clock} end="bitcoin-rule-semantic.end">
    <time:Window id="manifest-rule-semantic" from="start" for={manifest-rule-media.extent}/>
    <time:Window id="real-estate-rule-semantic" from="manifest-rule-semantic.end" for={real-estate-rule-media.extent}/>
    <time:Window id="bitcoin-rule-semantic" from="real-estate-rule-semantic.end" for={bitcoin-rule-media.extent}/>
  </time:Timeline>


  <semantic:Projection id="story-time" narrative={story} timeline={speech.timeline}>
    <semantic:Map alignment={manifest-rule-semantic.alignment} domain={manifest-rule-media.domain} window={speech.manifest-rule-semantic}/>
    <semantic:Map alignment={real-estate-rule-semantic.alignment} domain={real-estate-rule-media.domain} window={speech.real-estate-rule-semantic}/>
    <semantic:Map alignment={bitcoin-rule-semantic.alignment} domain={bitcoin-rule-media.domain} window={speech.bitcoin-rule-semantic}/>
  </semantic:Projection>
  <semantic:Instant id="moment-manifest-cue" projection={story-time} at={story.moment.manifest}/>
  <semantic:Instant id="moment-real-estate-cue" projection={story-time} at={story.moment.real-estate}/>
  <semantic:Instant id="moment-bitcoin-cue" projection={story-time} at={story.moment.bitcoin}/>
  <time:Window id="manifest-reveal-sfx-window" timeline={speech.timeline} from={moment-manifest-cue} for="20f"/>
  <time:Window id="real-estate-reveal-sfx-window" timeline={speech.timeline} from={moment-real-estate-cue} for="20f"/>
  <time:Window id="bitcoin-reveal-sfx-window" timeline={speech.timeline} from={moment-bitcoin-cue} for="20f"/>
  <time:Window id="manifest-flash-window" timeline={speech.timeline} from={moment-manifest-cue} for="8f"/>
  <time:Window id="real-estate-flash-window" timeline={speech.timeline} from={moment-real-estate-cue} for="8f"/>
  <time:Window id="bitcoin-flash-window" timeline={speech.timeline} from={moment-bitcoin-cue} for="8f"/>

  <sequence:TimelineRegions id="wojak-heads" document={wojak-tracking.heads}
    timeline={speech.timeline} canvas={vertical.canvas}/>
  <audio:Track id="speech-sound" timeline={speech.timeline}>
    <audio:Clip id="manifest-rule-semantic-source" source={manifest-rule-media.media} during={speech.manifest-rule-semantic}/>
    <audio:Clip id="real-estate-rule-semantic-source" source={real-estate-rule-media.media} during={speech.real-estate-rule-semantic}/>
    <audio:Clip id="bitcoin-rule-semantic-source" source={bitcoin-rule-media.media} during={speech.bitcoin-rule-semantic}/>
  </audio:Track>
  <visual:Track id="speech-picture" timeline={speech.timeline}>
    <visual:Clip id="manifest-rule-semantic-source" media={manifest-rule-media.media} during={speech.manifest-rule-semantic} frame={full-frame} fit="cover"/>
    <visual:Clip id="real-estate-rule-semantic-source" media={real-estate-rule-media.media} during={speech.real-estate-rule-semantic} frame={full-frame} fit="cover"/>
    <visual:Clip id="bitcoin-rule-semantic-source" media={bitcoin-rule-media.media} during={speech.bitcoin-rule-semantic} frame={full-frame} fit="cover"/>
  </visual:Track>

  <audio-track:Track id="music-bed" timeline={speech.timeline}>
    <audio-track:Clip source={soundtrack-media.media} during={speech.window}
      gain="0.12" fade-in="300ms" fade-out="600ms"/>
  </audio-track:Track>

  <audio-track:Track id="rule-reveal-sfx" timeline={speech.timeline}>
    <audio-track:Clip id="manifest-reveal-sfx" source={rule-reveal-sound-media.media} during={manifest-reveal-sfx-window} gain="0.20"/>
    <audio-track:Clip id="real-estate-reveal-sfx" source={rule-reveal-sound-media.media} during={real-estate-reveal-sfx-window} gain="0.20"/>
    <audio-track:Clip id="bitcoin-reveal-sfx" source={rule-reveal-sound-media.media} during={bitcoin-reveal-sfx-window} gain="0.20"/>
  </audio-track:Track>

  <fonts:Face id="caption-font" package="@fontsource-variable/league-spartan" weight="900" style="normal"/>
  <caption-fine:Style id="caption-chad-style" recipe={recipes.caption.boy}
    font={caption-font}/>
  <caption-fine:Style id="caption-wojak-style" recipe={recipes.caption.wojak}
    font={caption-font}/>

  <narrative-caption:Timing id="caption-timing" document={story.caption} binding={story.caption-binding} projection={story-time}/>
  <caption-fine:Caption id="captions" document={story.caption} timing={caption-timing}
    timeline={speech.timeline} within={vertical.bounds} regions={wojak-heads}>
    <caption-fine:Use style={caption-chad-style}/>
    <caption-fine:Use role="WOJAK" style={caption-wojak-style}/>
    <caption-fine:Follow role="WOJAK" series="wojak-head" missing="hide"/>
  </caption-fine:Caption>

  <emoji:Style id="rule-reveal-style" recipe={recipes.emoji.strip}/>
  <emoji:EmojiReveal id="rule-reveal" timeline={speech.timeline} within={vertical.bounds}
    style={rule-reveal-style} placeholder={rule-placeholder.image} during={speech.window}>
    <emoji:Item id="manifest" icon={manifest-icon.image} at={moment-manifest-cue}/>
    <emoji:Item id="real-estate" icon={real-estate-icon.image} at={moment-real-estate-cue}/>
    <emoji:Item id="bitcoin" icon={bitcoin-icon.image} at={moment-bitcoin-cue}/>
  </emoji:EmojiReveal>

  <flash:Flash id="manifest-flash" timeline={speech.timeline} within={vertical.bounds}
    during={manifest-flash-window}
    color="#FF4D6D" intensity="0.28" attack="2" hold="1" decay="5"/>
  <flash:Flash id="real-estate-flash" timeline={speech.timeline} within={vertical.bounds}
    during={real-estate-flash-window}
    color="#14A68A" intensity="0.28" attack="2" hold="1" decay="5"/>
  <flash:Flash id="bitcoin-flash" timeline={speech.timeline} within={vertical.bounds}
    during={bitcoin-flash-window}
    color="#F59E0B" intensity="0.28" attack="2" hold="1" decay="5"/>

  <film:Film id="main" canvas={vertical.canvas} timeline={speech.timeline}
    appearance={recipes.film.vertical}>
    <film:Track id="speech-picture" source={speech-picture.visual}/>
    <film:Track source={speech-sound.audio}/>
    <film:Track id="captions" source={captions.visual}/>
    <film:Track id="rule-reveal" source={rule-reveal.visual}/>
    <film:Track id="manifest-flash" source={manifest-flash.visual}/>
    <film:Track id="real-estate-flash" source={real-estate-flash.visual}/>
    <film:Track id="bitcoin-flash" source={bitcoin-flash.visual}/>
    <film:Track source={music-bed.audio}/>
    <film:Track source={rule-reveal-sfx.audio}/>
  </film:Film>

  <html:Video id="final" composition={main.composition}/>
</svml>
