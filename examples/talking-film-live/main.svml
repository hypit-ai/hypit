<?svml using="@svml/text@1"?>

<svml>
  <import from="@svml/script@1"/>
  <import as="media" from="@svml/media@1"/>
  <import as="estimate" from="@svml/estimate@1"/>
  <import as="seedance" from="@svml/seedance@1"/>
  <import as="speech" from="@svml/speech@1"/>
  <import as="whisperx" from="@svml/whisperx@1"/>
  <import as="caption" from="@svml/caption@1"/>
  <import as="caption-ai" from="@svml/caption-gemini@1"/>
  <import as="text" from="@svml/text-track@1"/>
  <import as="film" from="@svml/film@1"/>
  <import as="render" from="@svml/hyperframes-render@1"/>
  <import as="studio" source="./studio.svs"/>

  <script id="story">
    <opening>
      <HOST>Video editing begins with meaning, not a pile of clips on a timeline.</opening>
    <answer>
      <HOST>Then every caption and visual can arrive at @callout exactly the right moment @/callout.</answer>
  </script>

  <media:Image id="presenter" src="./assets/presenter.png"/>

  <estimate:Speech
    id="opening-duration"
    source={story.segment.opening.speech}
    language="en"
    pace="normal"
    padding="0.3"
    min="4"
    max="15"
    rounding="ceil"
  />

  <estimate:Speech
    id="answer-duration"
    source={story.segment.answer.speech}
    language="en"
    pace="normal"
    padding="0.3"
    min="4"
    max="15"
    rounding="ceil"
  />

  <seedance:Prompt id="opening-direction">
    Vertical medium close-up of the reference presenter in a quiet daylight studio.
    She looks directly into camera and speaks in a calm, clear, conversational voice.
    Natural breathing, restrained movement, locked camera, no text in the scene.
  </seedance:Prompt>

  <seedance:Prompt id="answer-direction">
    Continue with the same reference presenter, studio and calm female voice.
    Vertical medium close-up, direct eye contact, slightly more assured delivery,
    restrained movement, locked camera, no text in the scene.
  </seedance:Prompt>

  <seedance:Speech
    id="opening-take"
    model="mini"
    dialogue={story.segment.opening.dialogue}
    prompt={opening-direction}
    duration={opening-duration.duration}
    resolution="480p"
    aspect-ratio="9:16"
  >
    <seedance:Reference image={presenter} role="character"/>
  </seedance:Speech>

  <seedance:Speech
    id="answer-take"
    model="mini"
    dialogue={story.segment.answer.dialogue}
    prompt={answer-direction}
    duration={answer-duration.duration}
    resolution="480p"
    aspect-ratio="9:16"
  >
    <seedance:Reference image={presenter} role="character"/>
  </seedance:Speech>

  <speech:Spine id="speech">
    <speech:Take source={opening-take} segment={story.segment.opening}/>
    <speech:Take source={answer-take} segment={story.segment.answer}/>
  </speech:Spine>

  <whisperx:Alignment id="timing" narrative={story} audio={speech.audio}/>

  <caption:Style id="primary-caption" appearance={studio.caption.primary}>
    <caption:Cues>Use short complete semantic phrases of two to five words. Never cross sentence boundaries.</caption:Cues>
    <caption:Field id="important" type="boolean" min-per-cue="0" max-per-cue="2">
      Select at most two words whose emphasis best communicates this Cue.
    </caption:Field>
  </caption:Style>

  <caption:Program id="caption-program" narrative={story} default={primary-caption}/>
  <caption-ai:Planner
    id="caption-plan"
    narrative={story}
    program={caption-program}
    model="gemini-2.5-flash"
  />

  <caption:Track
    id="captions"
    narrative={story}
    map={timing.map}
    program={caption-program}
    plan={caption-plan.plan}
  />

  <text:Track id="callout" space={speech.space} map={timing.map}>
    <text:Item
      text="EXACTLY THE RIGHT MOMENT"
      during={story.selection.callout}
      appearance={studio.text.callout}
    />
  </text:Track>

  <film:Film id="main" space={speech.space} appearance={studio.film.vertical}>
    <film:Track source={speech.visual}/>
    <film:Track source={speech.audioTrack}/>
    <film:Track source={captions.track}/>
    <film:Track source={callout.track}/>
  </film:Film>

  <render:Video id="final" composition={main.composition}/>
</svml>
