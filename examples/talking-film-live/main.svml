<?svml using="@hypit/markup@1"?>

<svml>
  <import from="@hypit/script@1"/>
  <import as="wording" from="@hypit/text@1"/>
  <import as="media" from="@hypit/media@1"/>
  <import as="pipeline" from="@hypit/media-pipeline@1"/>
  <import as="estimate" from="@hypit/estimate@1"/>
  <import as="seedance" from="@hypit/seedance@1"/>
  <import as="speech" from="@hypit/speech-track@1"/>
  <import as="whisperx" from="@hypit/whisperx@1"/>
  <import as="caption" from="@hypit/caption@1"/>
  <import as="caption-fine" from="@hypit/caption-fine@1"/>
  <import as="caption-ai" from="@hypit/caption-gemini@1"/>
  <import as="fonts" from="@hypit/fonts-open@1"/>
  <import as="text" from="@hypit/typography-track@1"/>
  <import as="space" from="@hypit/spatial@1"/>
  <import as="program" from="@hypit/program-space@1"/>
  <import as="film" from="@hypit/film@1"/>
  <import as="render" from="@hypit/render-hyperframes@1"/>
  <import as="recipes" source="./recipes.svs"/>

  <script id="story">
    <opening>
      <HOST>Video editing begins with meaning, not a pile of clips on a timeline.</opening>
    <answer>
      <HOST>Then every caption and visual can arrive at @callout exactly the right moment @/callout.</answer>
  </script>

  <media:Image id="presenter" src="./assets/presenter.png"/>

  <estimate:Speech
    id="opening-duration"
    source={story.segment.opening.speech}
    language="en"
    pace="normal"
    min="4"
    max="15"
    rounding="round"
  />

  <estimate:Speech
    id="answer-duration"
    source={story.segment.answer.speech}
    language="en"
    pace="normal"
    min="4"
    max="15"
    rounding="round"
  />

  <wording:Value id="opening-direction">
    Vertical medium close-up of the reference presenter in a quiet daylight studio.
    She looks directly into camera and speaks in a calm, clear, conversational voice.
    Natural breathing, restrained movement, locked camera, no text in the scene.
    Spoken dialogue — say exactly: Video editing begins with meaning, not a pile of clips on a timeline.
  </wording:Value>

  <wording:Value id="answer-direction">
    Continue with the same reference presenter, studio and calm female voice.
    Vertical medium close-up, direct eye contact, slightly more assured delivery,
    restrained movement, locked camera, no text in the scene.
    Spoken dialogue — say exactly: Then every caption and visual can arrive at exactly the right moment.
  </wording:Value>

  <seedance:ReferenceVideo
    id="opening-take"
    model="mini"
    prompt={opening-direction}
    duration={opening-duration.duration}
    resolution="480p"
    aspect-ratio="9:16"
    generate-audio="true"
  >
    <seedance:Reference image={presenter}/>
  </seedance:ReferenceVideo>

  <seedance:ReferenceVideo
    id="answer-take"
    model="mini"
    prompt={answer-direction}
    duration={answer-duration.duration}
    resolution="480p"
    aspect-ratio="9:16"
    generate-audio="true"
  >
    <seedance:Reference image={presenter}/>
  </seedance:ReferenceVideo>

  <space:Canvas id="vertical" width="480" height="854"/>
  <program:Clock id="clock" frame-rate="30"/>
  <space:Frame id="speech-frame" within={vertical} left="0%" top="0%" right="100%" bottom="100%"/>

  <pipeline:Normalize id="opening-media" source={opening-take.video}
    video="primary-moving" audio="default" span-authority="video" clock={clock}/>
  <pipeline:Normalize id="answer-media" source={answer-take.video}
    video="primary-moving" audio="default" span-authority="video" clock={clock}/>
  <whisperx:SemanticTake id="opening-semantic" narrative={story}
    segment={story.segment.opening} media={opening-media.media}/>
  <whisperx:SemanticTake id="answer-semantic" narrative={story}
    segment={story.segment.answer} media={answer-media.media}/>

  <speech:Track id="speech"
    visual-frame={speech-frame} visual-appearance={recipes.speech.visual} visual-z="0">
    <speech:Take source={opening-semantic.take}/>
    <speech:Take source={answer-semantic.take}/>
  </speech:Track>

  <fonts:Stack id="caption-font" family="inter" weight="700" style="normal"/>
  <caption-fine:Style id="primary-caption" recipe={recipes.caption.primary} font={caption-font}/>

  <caption:Program id="caption-program" display={story.caption} default={primary-caption}/>
  <caption-ai:Planner
    id="caption-plan"
    display={story.caption}
    program={caption-program}
    model="gemini-2.5-flash"
  />

  <caption-fine:Track
    id="captions"
    display={story.caption}
    correspondence={story.caption.correspondence}
    semantic={speech.semantic}
    program={caption-program}
    plan={caption-plan.plan}
  />

  <space:Frame id="callout-frame" within={vertical}
    left="8%" top="10%" right="92%" bottom="20%"/>

  <text:Style id="callout-style" recipe={recipes.text.callout} font={caption-font}/>
  <text:Track id="callout" semantic={speech.semantic}>
    <text:Area
      id="callout-copy"
      placement={callout-frame}
      style={callout-style}
      during={story.selection.callout}
    >
      EXACTLY THE RIGHT MOMENT
    </text:Area>
  </text:Track>

  <film:Film id="main" canvas={vertical} semantic={speech.semantic} appearance={recipes.film.vertical}>
    <film:Track source={speech.visual}/>
    <film:Track source={speech.audio}/>
    <film:Track source={captions.track}/>
    <film:Track source={callout.track}/>
  </film:Film>

  <render:Video id="final" composition={main.composition} semantic={speech.semantic}/>
</svml>
