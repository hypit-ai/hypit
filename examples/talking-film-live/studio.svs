<?svml using="@narratage/svs@1"?>

<sheet version="1">
  film.vertical {
    background: #09090B;
  }

  speech.visual { fit: cover; }

  caption.primary {
    cue-min-words: 2;
    cue-max-words: 5;
    stack-order: 70;
    x: 0.08;
    y: 0.74;
    width: 0.84;
    size: 30;
    line-height: 1;
    align: center;
    fill: #FFFFFF;
    background: #09090BCC;
    padding: 10 14;
    radius: 12;
  }

  text.callout {
    stack-order: 85;
    weight: 900;
    size: 27;
    align: center;
    fill: #FFF16A;
    tracking: -0.5;
  }
</sheet>
