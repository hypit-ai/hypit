<?xml version="1.0" encoding="UTF-8"?>
<svml id="studio-demo" name="Hypit NLE Studio" root="main">
  <composition id="main" name="Main Programme" width="1920" height="1080">
    <track id="picture-base" name="Picture · Base" kind="picture" enabled="true">
      <present id="interview" name="Interview" source="media" start="0/1" duration="18/1" enabled="true">
        <media path="media/interview.media.json" />
        <source-time>
          <linear target-start="0/1" target-end="18/1" source-start="0/1" rate="1/1" />
        </source-time>
        <picture>
          <layout x="0" y="0" width="1920" height="1080" fit="cover" />
        </picture>
        <audio />
      </present>
    </track>
    <track id="picture-overlay" name="Picture · Overlay" kind="picture" enabled="true">
      <present id="opening-title" name="A new way to edit" source="component" start="1/1" duration="5/1" enabled="true">
        <component package="@hypit/studio-components" symbol="Title" />
        <parameters>{"eyebrow":"HYPIT","title":"A new way to edit","accent":"#73e6b5"}</parameters>
        <source-time>
          <linear target-start="0/1" target-end="5/1" source-start="0/1" rate="1/1" />
        </source-time>
        <picture>
          <layout x="120" y="124" width="1680" height="300" fit="contain" />
        </picture>
      </present>
      <present id="b-roll" name="Workbench detail" source="media" start="7/1" duration="7/1" enabled="true">
        <media path="media/workbench.media.json" />
        <source-time>
          <linear target-start="0/1" target-end="7/1" source-start="3/1" rate="1/1" />
        </source-time>
        <picture>
          <layout x="1090" y="590" width="710" height="400" fit="cover" />
        </picture>
      </present>
    </track>
    <track id="picture-adjust" name="Adjust · Programme" kind="picture" enabled="true">
      <adjust id="programme-look" name="Programme Look" package="@hypit/studio-operators" symbol="Colour" start="0/1" duration="18/1" enabled="true">
        <parameters>{"contrast":1.08,"saturation":0.94,"temperature":-2}</parameters>
        <control-time>
          <linear target-start="0/1" target-end="18/1" source-start="0/1" rate="1/1" />
        </control-time>
      </adjust>
    </track>
    <track id="audio-main" name="Audio · Main" kind="audio" enabled="true">
      <present id="music" name="Room tone and music" source="media" start="0/1" duration="18/1" enabled="true">
        <media path="media/music.media.json" />
        <source-time>
          <linear target-start="0/1" target-end="18/1" source-start="0/1" rate="1/1" />
        </source-time>
        <audio />
      </present>
    </track>
  </composition>
</svml>
