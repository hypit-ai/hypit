<?xml version="1.0" encoding="UTF-8"?>
<svml id="studio-trailer" name="Hypit NLE Studio Trailer" root="trailer">
  <composition id="trailer" name="Trailer" width="1920" height="1080">
    <track id="picture" name="Picture" kind="picture" enabled="true">
      <present id="title" name="Hypit Project" source="media" start="0/1" duration="5/1" enabled="true">
        <media path="media/title/title.media.json" />
        <source-time>
          <linear target-start="0/1" target-end="5/1" source-start="0/1" rate="1/1" />
        </source-time>
        <picture>
          <layout x="0" y="0" width="1920" height="1080" fit="contain" />
        </picture>
      </present>
    </track>
  </composition>
</svml>
