  <time:Window id="sfx-montage-3-window" timeline={program.timeline} from={segment-opening-end-plus-9f} until={segment-opening-end-plus-13f}/>
  <time:Window id="sfx-montage-4-window" timeline={program.timeline} from={segment-opening-end-plus-14f} until={segment-opening-end-plus-28f}/>
  <narrative-caption:Timing id="caption-timing" document={copy.story.caption}
    binding={copy.story.caption-binding} projection={story-time}/>
  <mediaop:Normalize id="ranking-clone-media" source={assets.ranking-clone} clock={assets.clock} video="primary-moving" audio="none" span-authority="video"/>
  <mediaop:Normalize id="swap-virtual-media" source={assets.swap-virtual} clock={assets.clock} video="primary-moving" audio="none" span-authority="video"/>
  <mediaop:Normalize id="swap-language-media" source={assets.swap-language} clock={assets.clock} video="primary-moving" audio="none" span-authority="video"/>
  <mediaop:Normalize id="swap-topic-media" source={assets.swap-topic} clock={assets.clock} video="primary-moving" audio="none" span-authority="video"/>
  <mediaop:Normalize id="swap-product-media" source={assets.swap-product} clock={assets.clock} video="primary-moving" audio="none" span-authority="video"/>
  <mediaop:Normalize id="swap-vehicle-media" source={assets.swap-vehicle} clock={assets.clock} video="primary-moving" audio="none" span-authority="video"/>

  <!-- Opening chrome and independent montage -->
  <gfx:Title id="opening-title" timeline={program.timeline} within={assets.canvas.bounds} font={assets.display-font} during={opening-title-window} bounce-at={moment-opening-brand-cue} color="#fa67aa" title-y="0.58" title="Hypit" subtitle="一分钟了解" seconds="60"/>
  <gfx:Flag id="road-flag" x="0.035" width="0.93" height="0.21" y="0.752" timeline={program.timeline} within={assets.canvas.bounds} logo={assets.flag-logo} during={road-flag-window}/>
  <gfx:Flag id="closing-road-flag" x="0.035" width="0.93" height="0.21" y="0.752" timeline={program.timeline} within={assets.canvas.bounds} logo={assets.flag-logo} during={closing-road-flag-window}/>
  <gfx:Timer flag-amplitude="0.06" logo={assets.flag-logo} id="series-timer" timeline={program.timeline} within={assets.canvas.bounds} font={assets.display-font} during={series-timer-window} stop-at={moment-outro-overtime-cue} flag-color="#fa67aa" title="Hypit" subtitle="VIDEO FRAMEWORK" seconds="60"/>
  <gfx:Stage id="opening-montage" push-rate="0.025" timeline={program.timeline} within={assets.canvas.bounds} during={opening-montage-window}>
    <gfx:Item id="image-1" image={assets.montage-1} during={montage-image-1-window}/>
    <gfx:Item id="image-2" image={assets.montage-2} during={montage-image-2-window}/>
    <gfx:Item id="image-3" image={assets.montage-3} during={montage-image-3-window}/>
    <gfx:Item id="image-4" image={assets.montage-4} during={montage-image-4-window}/>
  </gfx:Stage>

  <!-- Project Presenter: component-local Uses select framing without changing playback -->
  <spatial:Frame id="full-frame" within={assets.canvas.bounds} left="0%" top="0%" right="100%" bottom="100%"/>
  <spatial:AnchoredFrame id="host-inset" within={assets.canvas.bounds} x="93%" y="13.5%" width="330px" height="330px" anchor="top-right"/>
  <gfx:PresenterFrame id="host-hidden" frame={full-frame} appearance={look.media.hidden}/>
  <gfx:PresenterFrame id="host-full" frame={full-frame} appearance={look.media.full}/>
  <gfx:PortraitInset id="host-small" frame={host-inset}/>
  <gfx:Pullback id="opening-pullback" scale="1.5"/>
  <gfx:FadeOut id="host-fade"/>
  <spatial:Frame id="upper-frame" within={assets.canvas.bounds} left="0%" top="0%" right="100%" bottom="48%"/>
  <gfx:PresenterFrame id="host-upper" frame={upper-frame} appearance={look.media.upper}/>
  <gfx:Reframe id="host-rise" from={full-frame} to={upper-frame}/>
  <gfx:PortraitTransition id="host-resume" from={full-frame} to={host-inset}/>
  <gfx:Presenter id="presenter" timeline={program.timeline} within={assets.canvas.bounds}>
    <gfx:Source id="opening-source" media={opening-media.media} window={program.opening}/>
    <gfx:Source id="introduction-source" media={introduction-media.media} window={program.introduction}/>
    <gfx:Source id="competitors-source" media={competitors-media.media} window={program.competitors}/>
    <gfx:Source id="two-roads-source" media={two-roads-media.media} window={program.two-roads}/>
