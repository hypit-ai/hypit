<?svml using="@hypit/markup@1"?>
<svml>

  <import as="media" from="@hypit/media@1"/>
  <import as="copy" source="./script.svml"/>
  <import as="assets" source="./assets.svml"/>
  <import as="direction" source="./direction.svml"/>
  <import as="seedance" from="@hypit/seedance@1"/>
  <import as="mediaop" from="@hypit/media-operations@1"/>
  <import as="whisperx" from="@hypit/whisperx@1"/>
  <import as="speechalign" from="@hypit/narrative-speech-alignment@1"/>
  <import as="semantic" from="@hypit/narrative-temporal@1"/>
  <import as="time" from="@hypit/timeline-author@1"/>
  <import as="webscene" from="@explainer/web-scenes@1"/>
  <import as="launch" from="@explainer/launch-scenes@1"/>
  <import as="visual" from="@hypit/visual-track@1"/>
  <import as="audio" from="@hypit/audio-track@1"/>
  <import as="caption" from="@hypit/caption@1"/>
  <import as="narrative-caption" from="@hypit/narrative-caption@1"/>
  <import as="linecaption" from="@explainer/single-line-captions@1"/>
  <import as="caption-fine" from="@hypit/caption-fine@1"/>
  <import as="film" from="@hypit/film@1"/>
  <import as="html" from="@hypit/html-video@1"/>
  <import as="look" source="../recipes/composition.svs"/>
  <import as="gfx" from="@explainer/opening-system@1"/>
  <import as="spatial" from="@hypit/spatial@1"/>

  <!-- Prepared material outputs: explicit Run reuse boundaries -->
  <mediaop:Normalize id="bgm-media" source={assets.bgm-source} clock={assets.clock} video="none" audio="default" span-authority="audio"/>
  <mediaop:Normalize id="web-hypit-media" source={assets.web-hypit} clock={assets.clock} video="primary-moving" audio="none" span-authority="video"/>
  <mediaop:Normalize id="web-creatify-media" source={assets.web-creatify} clock={assets.clock} video="primary-moving" audio="none" span-authority="video"/>
  <mediaop:Normalize id="web-higgsfield-media" source={assets.web-higgsfield} clock={assets.clock} video="primary-moving" audio="none" span-authority="video"/>
  <seedance:ReferenceVideo id="opening-generation" model="mini" prompt={direction.opening-prompt} duration="5" resolution="720p" aspect-ratio="9:16" generate-audio="true">
    <seedance:Reference image={assets.presenter-reference} person-reference="true"/>
    <seedance:Reference audio={assets.voice-reference}/>
  </seedance:ReferenceVideo>
  <mediaop:Normalize id="opening-media" source={opening-generation.video} clock={assets.clock} video="primary-moving" audio="default" span-authority="video"/>
  <whisperx:Transcription id="opening-transcription" media={opening-media.media} language="zh"/>
  <speechalign:Alignment id="opening" narrative={copy.story}
    segment={copy.story.segment.opening} domain={opening-media.domain} evidence={opening-transcription.transcript}/>
  <seedance:ReferenceVideo id="introduction-generation" model="mini" prompt={direction.introduction-prompt} duration="11" resolution="720p" aspect-ratio="9:16" generate-audio="true">
    <seedance:Reference image={assets.presenter-reference} person-reference="true"/>
    <seedance:Reference audio={assets.voice-reference}/>
  </seedance:ReferenceVideo>
  <mediaop:Normalize id="introduction-media" source={introduction-generation.video} clock={assets.clock} video="primary-moving" audio="default" span-authority="video"/>
  <whisperx:Transcription id="introduction-transcription" media={introduction-media.media} language="zh"/>
  <speechalign:Alignment id="introduction" narrative={copy.story}
    segment={copy.story.segment.introduction} domain={introduction-media.domain} evidence={introduction-transcription.transcript}/>
  <seedance:ReferenceVideo id="competitors-generation" model="mini" prompt={direction.competitors-prompt} duration="8" resolution="720p" aspect-ratio="9:16" generate-audio="true">
    <seedance:Reference image={assets.presenter-reference} person-reference="true"/>
    <seedance:Reference audio={assets.voice-reference}/>
  </seedance:ReferenceVideo>
  <mediaop:Normalize id="competitors-media" source={competitors-generation.video} clock={assets.clock} video="primary-moving" audio="default" span-authority="video"/>
  <whisperx:Transcription id="competitors-transcription" media={competitors-media.media} language="zh"/>
  <speechalign:Alignment id="competitors" narrative={copy.story}
    segment={copy.story.segment.competitors} domain={competitors-media.domain} evidence={competitors-transcription.transcript}/>
  <seedance:ReferenceVideo id="two-roads-generation" model="mini" prompt={direction.two-roads-prompt} duration="6" resolution="720p" aspect-ratio="9:16" generate-audio="true">
    <seedance:Reference image={assets.presenter-reference} person-reference="true"/>
    <seedance:Reference audio={assets.voice-reference}/>
  </seedance:ReferenceVideo>
  <mediaop:Normalize id="two-roads-media" source={two-roads-generation.video} clock={assets.clock} video="primary-moving" audio="default" span-authority="video"/>
  <whisperx:Transcription id="two-roads-transcription" media={two-roads-media.media} language="zh"/>
  <speechalign:Alignment id="two-roads" narrative={copy.story}
    segment={copy.story.segment.two-roads} domain={two-roads-media.domain} evidence={two-roads-transcription.transcript}/>
  <seedance:ReferenceVideo id="editor-road-generation" model="mini" prompt={direction.editor-road-prompt} duration="8" resolution="720p" aspect-ratio="9:16" generate-audio="true">
    <seedance:Reference image={assets.presenter-reference} person-reference="true"/>
    <seedance:Reference audio={assets.voice-reference}/>
  </seedance:ReferenceVideo>
  <mediaop:Normalize id="editor-road-media" source={editor-road-generation.video} clock={assets.clock} video="primary-moving" audio="default" span-authority="video"/>
  <whisperx:Transcription id="editor-road-transcription" media={editor-road-media.media} language="zh"/>
  <speechalign:Alignment id="editor-road" narrative={copy.story}
    segment={copy.story.segment.editor-road} domain={editor-road-media.domain} evidence={editor-road-transcription.transcript}/>
  <seedance:ReferenceVideo id="keyframe-cost-generation" model="mini" prompt={direction.keyframe-cost-prompt} duration="13" resolution="720p" aspect-ratio="9:16" generate-audio="true">
    <seedance:Reference image={assets.presenter-reference} person-reference="true"/>
    <seedance:Reference audio={assets.voice-reference}/>
  </seedance:ReferenceVideo>
  <mediaop:Normalize id="keyframe-cost-media" source={keyframe-cost-generation.video} clock={assets.clock} video="primary-moving" audio="default" span-authority="video"/>
  <whisperx:Transcription id="keyframe-cost-transcription" media={keyframe-cost-media.media} language="zh"/>
  <speechalign:Alignment id="keyframe-cost" narrative={copy.story}
    segment={copy.story.segment.keyframe-cost} domain={keyframe-cost-media.domain} evidence={keyframe-cost-transcription.transcript}/>
  <seedance:ReferenceVideo id="code-road-generation" model="mini" prompt={direction.code-road-prompt} duration="6" resolution="720p" aspect-ratio="9:16" generate-audio="true">
    <seedance:Reference image={assets.presenter-reference} person-reference="true"/>
    <seedance:Reference audio={assets.voice-reference}/>
  </seedance:ReferenceVideo>
  <mediaop:Normalize id="code-road-media" source={code-road-generation.video} clock={assets.clock} video="primary-moving" audio="default" span-authority="video"/>
  <whisperx:Transcription id="code-road-transcription" media={code-road-media.media} language="zh"/>
  <speechalign:Alignment id="code-road" narrative={copy.story}
    segment={copy.story.segment.code-road} domain={code-road-media.domain} evidence={code-road-transcription.transcript}/>
  <seedance:ReferenceVideo id="reuse-cost-generation" model="mini" prompt={direction.reuse-cost-prompt} duration="8" resolution="720p" aspect-ratio="9:16" generate-audio="true">
    <seedance:Reference image={assets.presenter-reference} person-reference="true"/>
    <seedance:Reference audio={assets.voice-reference}/>
  </seedance:ReferenceVideo>
  <mediaop:Normalize id="reuse-cost-media" source={reuse-cost-generation.video} clock={assets.clock} video="primary-moving" audio="default" span-authority="video"/>
  <whisperx:Transcription id="reuse-cost-transcription" media={reuse-cost-media.media} language="zh"/>
  <speechalign:Alignment id="reuse-cost" narrative={copy.story}
    segment={copy.story.segment.reuse-cost} domain={reuse-cost-media.domain} evidence={reuse-cost-transcription.transcript}/>
  <seedance:ReferenceVideo id="timing-cost-generation" model="mini" prompt={direction.timing-cost-prompt} duration="8" resolution="720p" aspect-ratio="9:16" generate-audio="true">
    <seedance:Reference image={assets.presenter-reference} person-reference="true"/>
    <seedance:Reference audio={assets.voice-reference}/>
  </seedance:ReferenceVideo>
  <mediaop:Normalize id="timing-cost-media" source={timing-cost-generation.video} clock={assets.clock} video="primary-moving" audio="default" span-authority="video"/>
  <whisperx:Transcription id="timing-cost-transcription" media={timing-cost-media.media} language="zh"/>
  <speechalign:Alignment id="timing-cost" narrative={copy.story}
    segment={copy.story.segment.timing-cost} domain={timing-cost-media.domain} evidence={timing-cost-transcription.transcript}/>
  <seedance:ReferenceVideo id="water-break-generation" model="mini" prompt={direction.water-break-prompt} duration="4" resolution="720p" aspect-ratio="9:16" generate-audio="true">
    <seedance:Reference image={assets.presenter-reference} person-reference="true"/>
    <seedance:Reference audio={assets.voice-reference}/>
  </seedance:ReferenceVideo>
  <mediaop:Normalize id="water-break-media" source={water-break-generation.video} clock={assets.clock} video="primary-moving" audio="default" span-authority="video"/>
  <whisperx:Transcription id="water-break-transcription" media={water-break-media.media} language="zh"/>
  <speechalign:Alignment id="water-break" narrative={copy.story}
    segment={copy.story.segment.water-break} domain={water-break-media.domain} evidence={water-break-transcription.transcript}/>
  <seedance:ReferenceVideo id="synthesis-generation" model="mini" prompt={direction.synthesis-prompt} duration="5" resolution="720p" aspect-ratio="9:16" generate-audio="true">
    <seedance:Reference image={assets.presenter-reference} person-reference="true"/>
    <seedance:Reference audio={assets.voice-reference}/>
  </seedance:ReferenceVideo>
  <mediaop:Normalize id="synthesis-media" source={synthesis-generation.video} clock={assets.clock} video="primary-moving" audio="default" span-authority="video"/>
  <whisperx:Transcription id="synthesis-transcription" media={synthesis-media.media} language="zh"/>
  <speechalign:Alignment id="synthesis" narrative={copy.story}
    segment={copy.story.segment.synthesis} domain={synthesis-media.domain} evidence={synthesis-transcription.transcript}/>
  <seedance:ReferenceVideo id="components-generation" model="mini" prompt={direction.components-prompt} duration="12" resolution="720p" aspect-ratio="9:16" generate-audio="true">
    <seedance:Reference image={assets.presenter-reference} person-reference="true"/>
    <seedance:Reference audio={assets.voice-reference}/>
  </seedance:ReferenceVideo>
  <mediaop:Normalize id="components-media" source={components-generation.video} clock={assets.clock} video="primary-moving" audio="default" span-authority="video"/>
  <whisperx:Transcription id="components-transcription" media={components-media.media} language="zh"/>
  <speechalign:Alignment id="components" narrative={copy.story}
    segment={copy.story.segment.components} domain={components-media.domain} evidence={components-transcription.transcript}/>
  <seedance:ReferenceVideo id="semantic-time-generation" model="mini" prompt={direction.semantic-time-prompt} duration="5" resolution="720p" aspect-ratio="9:16" generate-audio="true">
    <seedance:Reference image={assets.presenter-reference} person-reference="true"/>
    <seedance:Reference audio={assets.voice-reference}/>
  </seedance:ReferenceVideo>
  <mediaop:Normalize id="semantic-time-media" source={semantic-time-generation.video} clock={assets.clock} video="primary-moving" audio="default" span-authority="video"/>
  <whisperx:Transcription id="semantic-time-transcription" media={semantic-time-media.media} language="zh"/>
  <speechalign:Alignment id="semantic-time" narrative={copy.story}
    segment={copy.story.segment.semantic-time} domain={semantic-time-media.domain} evidence={semantic-time-transcription.transcript}/>
  <seedance:ReferenceVideo id="semantic-demo-generation" model="mini" prompt={direction.semantic-demo-prompt} duration="10" resolution="720p" aspect-ratio="9:16" generate-audio="true">
    <seedance:Reference image={assets.presenter-reference} person-reference="true"/>
    <seedance:Reference audio={assets.voice-reference}/>
  </seedance:ReferenceVideo>
  <mediaop:Normalize id="semantic-demo-media" source={semantic-demo-generation.video} clock={assets.clock} video="primary-moving" audio="default" span-authority="video"/>
  <whisperx:Transcription id="semantic-demo-transcription" media={semantic-demo-media.media} language="zh"/>
  <speechalign:Alignment id="semantic-demo" narrative={copy.story}
    segment={copy.story.segment.semantic-demo} domain={semantic-demo-media.domain} evidence={semantic-demo-transcription.transcript}/>
  <seedance:ReferenceVideo id="result-generation" model="mini" prompt={direction.result-prompt} duration="8" resolution="720p" aspect-ratio="9:16" generate-audio="true">
    <seedance:Reference image={assets.presenter-reference} person-reference="true"/>
    <seedance:Reference audio={assets.voice-reference}/>
  </seedance:ReferenceVideo>
  <mediaop:Normalize id="result-media" source={result-generation.video} clock={assets.clock} video="primary-moving" audio="default" span-authority="video"/>
  <whisperx:Transcription id="result-transcription" media={result-media.media} language="zh"/>
  <speechalign:Alignment id="result" narrative={copy.story}
    segment={copy.story.segment.result} domain={result-media.domain} evidence={result-transcription.transcript}/>
  <seedance:ReferenceVideo id="reference-reveal-generation" model="mini" prompt={direction.reference-reveal-prompt} duration="5" resolution="720p" aspect-ratio="9:16" generate-audio="true">
    <seedance:Reference image={assets.presenter-reference} person-reference="true"/>
    <seedance:Reference audio={assets.voice-reference}/>
  </seedance:ReferenceVideo>
  <mediaop:Normalize id="reference-reveal-media" source={reference-reveal-generation.video} clock={assets.clock} video="primary-moving" audio="default" span-authority="video"/>
  <whisperx:Transcription id="reference-reveal-transcription" media={reference-reveal-media.media} language="zh"/>
  <speechalign:Alignment id="reference-reveal" narrative={copy.story}
    segment={copy.story.segment.reference-reveal} domain={reference-reveal-media.domain} evidence={reference-reveal-transcription.transcript}/>
  <seedance:ReferenceVideo id="closing-generation" model="mini" prompt={direction.closing-prompt} duration="11" resolution="720p" aspect-ratio="9:16" generate-audio="true">
    <seedance:Reference image={assets.presenter-reference} person-reference="true"/>
    <seedance:Reference audio={assets.voice-reference}/>
  </seedance:ReferenceVideo>
  <mediaop:Normalize id="closing-media" source={closing-generation.video} clock={assets.clock} video="primary-moving" audio="default" span-authority="video"/>
  <whisperx:Transcription id="closing-transcription" media={closing-media.media} language="zh"/>
  <speechalign:Alignment id="closing" narrative={copy.story}
    segment={copy.story.segment.closing} domain={closing-media.domain} evidence={closing-transcription.transcript}/>
  <mediaop:Normalize id="code-demo-media" source={assets.code-demo} clock={assets.clock} video="primary-moving" audio="none" span-authority="video"/>
  <mediaop:Normalize id="readme-demo-media" source={assets.readme-demo} clock={assets.clock} video="primary-moving" audio="none" span-authority="video"/>
  <mediaop:Normalize id="price-creatify-media" source={assets.price-creatify} clock={assets.clock} video="primary-moving" audio="none" span-authority="video"/>
  <mediaop:Normalize id="price-higgsfield-media" source={assets.price-higgsfield} clock={assets.clock} video="primary-moving" audio="none" span-authority="video"/>
  <mediaop:Normalize id="templates-creatify-media" source={assets.templates-creatify} clock={assets.clock} video="primary-moving" audio="none" span-authority="video"/>
  <mediaop:Normalize id="templates-higgsfield-media" source={assets.templates-higgsfield} clock={assets.clock} video="primary-moving" audio="none" span-authority="video"/>
  <mediaop:Normalize id="case-creatify-media" source={assets.case-creatify} clock={assets.clock} video="primary-moving" audio="none" span-authority="video"/>
  <mediaop:Normalize id="case-higgsfield-media" source={assets.case-higgsfield} clock={assets.clock} video="primary-moving" audio="none" span-authority="video"/>
  <mediaop:Normalize id="reference-ranking-media" source={assets.reference-ranking} clock={assets.clock} video="primary-moving" audio="none" span-authority="video"/>
  <mediaop:Normalize id="reference-podcast-media" source={assets.reference-podcast} clock={assets.clock} video="primary-moving" audio="none" span-authority="video"/>
  <mediaop:Normalize id="reference-interview-media" source={assets.reference-interview} clock={assets.clock} video="primary-moving" audio="none" span-authority="video"/>
  <mediaop:Normalize id="hypit-ranking-media" source={assets.hypit-ranking} clock={assets.clock} video="primary-moving" audio="none" span-authority="video"/>
  <mediaop:Normalize id="hypit-podcast-media" source={assets.hypit-podcast} clock={assets.clock} video="primary-moving" audio="none" span-authority="video"/>
  <mediaop:Normalize id="hypit-interview-media" source={assets.hypit-interview} clock={assets.clock} video="primary-moving" audio="none" span-authority="video"/>

  <!-- One Timeline: placed Takes, opening gap and silent ending -->
  <time:Timeline id="program" clock={assets.clock} end="closing.end+2s">
    <time:Window id="opening" from="start" for={opening-media.extent}/>
    <time:Window id="introduction" from="opening.end+1.5s" for={introduction-media.extent}/>
    <time:Window id="competitors" from="introduction.end" for={competitors-media.extent}/>
    <time:Window id="two-roads" from="competitors.end" for={two-roads-media.extent}/>
    <time:Window id="editor-road" from="two-roads.end" for={editor-road-media.extent}/>
    <time:Window id="keyframe-cost" from="editor-road.end" for={keyframe-cost-media.extent}/>
    <time:Window id="code-road" from="keyframe-cost.end" for={code-road-media.extent}/>
    <time:Window id="reuse-cost" from="code-road.end" for={reuse-cost-media.extent}/>
    <time:Window id="timing-cost" from="reuse-cost.end" for={timing-cost-media.extent}/>
    <time:Window id="water-break" from="timing-cost.end" for={water-break-media.extent}/>
    <time:Window id="synthesis" from="water-break.end" for={synthesis-media.extent}/>
    <time:Window id="components" from="synthesis.end" for={components-media.extent}/>
    <time:Window id="semantic-time" from="components.end" for={semantic-time-media.extent}/>
    <time:Window id="semantic-demo" from="semantic-time.end" for={semantic-demo-media.extent}/>
    <time:Window id="result" from="semantic-demo.end" for={result-media.extent}/>
    <time:Window id="reference-reveal" from="result.end" for={reference-reveal-media.extent}/>
    <time:Window id="closing" from="reference-reveal.end" for={closing-media.extent}/>
  </time:Timeline>


  <semantic:Projection id="story-time" narrative={copy.story} timeline={program.timeline}>
    <semantic:Map alignment={opening.alignment} domain={opening-media.domain} window={program.opening}/>
    <semantic:Map alignment={introduction.alignment} domain={introduction-media.domain} window={program.introduction}/>
    <semantic:Map alignment={competitors.alignment} domain={competitors-media.domain} window={program.competitors}/>
    <semantic:Map alignment={two-roads.alignment} domain={two-roads-media.domain} window={program.two-roads}/>
    <semantic:Map alignment={editor-road.alignment} domain={editor-road-media.domain} window={program.editor-road}/>
    <semantic:Map alignment={keyframe-cost.alignment} domain={keyframe-cost-media.domain} window={program.keyframe-cost}/>
    <semantic:Map alignment={code-road.alignment} domain={code-road-media.domain} window={program.code-road}/>
    <semantic:Map alignment={reuse-cost.alignment} domain={reuse-cost-media.domain} window={program.reuse-cost}/>
    <semantic:Map alignment={timing-cost.alignment} domain={timing-cost-media.domain} window={program.timing-cost}/>
    <semantic:Map alignment={water-break.alignment} domain={water-break-media.domain} window={program.water-break}/>
    <semantic:Map alignment={synthesis.alignment} domain={synthesis-media.domain} window={program.synthesis}/>
    <semantic:Map alignment={components.alignment} domain={components-media.domain} window={program.components}/>
    <semantic:Map alignment={semantic-time.alignment} domain={semantic-time-media.domain} window={program.semantic-time}/>
    <semantic:Map alignment={semantic-demo.alignment} domain={semantic-demo-media.domain} window={program.semantic-demo}/>
    <semantic:Map alignment={result.alignment} domain={result-media.domain} window={program.result}/>
    <semantic:Map alignment={reference-reveal.alignment} domain={reference-reveal-media.domain} window={program.reference-reveal}/>
    <semantic:Map alignment={closing.alignment} domain={closing-media.domain} window={program.closing}/>
  </semantic:Projection>
  <semantic:Instant id="moment-begin-cue" projection={story-time} at={copy.story.moment.begin}/>
  <semantic:Instant id="moment-opening-brand-cue" projection={story-time} at={copy.story.moment.opening-brand}/>
  <semantic:Instant id="moment-road-overview-cue" projection={story-time} at={copy.story.moment.road-overview}/>
  <semantic:Instant id="segment-timing-cost-end" projection={story-time} at={copy.story.segment.timing-cost} boundary="end"/>
  <semantic:Instant id="segment-synthesis-start" projection={story-time} at={copy.story.segment.synthesis} boundary="start"/>
  <semantic:Instant id="segment-closing-start" projection={story-time} at={copy.story.segment.closing} boundary="start"/>
  <semantic:Instant id="moment-outro-overtime-cue" projection={story-time} at={copy.story.moment.outro-overtime}/>
  <semantic:Instant id="segment-opening-end" projection={story-time} at={copy.story.segment.opening} boundary="end"/>
  <semantic:Instant id="segment-opening-end-plus-1-5s-base" projection={story-time} at={copy.story.segment.opening} boundary="end"/>
  <time:Instant id="segment-opening-end-plus-1-5s" timeline={program.timeline} at={segment-opening-end-plus-1-5s-base} offset="+1.5s"/>
  <semantic:Instant id="segment-opening-end-plus-0f-base" projection={story-time} at={copy.story.segment.opening} boundary="end"/>
  <time:Instant id="segment-opening-end-plus-0f" timeline={program.timeline} at={segment-opening-end-plus-0f-base} offset="+0f"/>
  <semantic:Instant id="segment-opening-end-plus-5f-base" projection={story-time} at={copy.story.segment.opening} boundary="end"/>
  <time:Instant id="segment-opening-end-plus-5f" timeline={program.timeline} at={segment-opening-end-plus-5f-base} offset="+5f"/>
  <semantic:Instant id="segment-opening-end-plus-9f-base" projection={story-time} at={copy.story.segment.opening} boundary="end"/>
  <time:Instant id="segment-opening-end-plus-9f" timeline={program.timeline} at={segment-opening-end-plus-9f-base} offset="+9f"/>
  <semantic:Instant id="segment-opening-end-plus-14f-base" projection={story-time} at={copy.story.segment.opening} boundary="end"/>
  <time:Instant id="segment-opening-end-plus-14f" timeline={program.timeline} at={segment-opening-end-plus-14f-base} offset="+14f"/>
  <semantic:Instant id="segment-opening-end-plus-45f-base" projection={story-time} at={copy.story.segment.opening} boundary="end"/>
  <time:Instant id="segment-opening-end-plus-45f" timeline={program.timeline} at={segment-opening-end-plus-45f-base} offset="+45f"/>
  <semantic:Instant id="segment-introduction-start" projection={story-time} at={copy.story.segment.introduction} boundary="start"/>
  <semantic:Window id="segment-opening" projection={story-time} during={copy.story.segment.opening}/>
  <semantic:Window id="segment-two-roads" projection={story-time} during={copy.story.segment.two-roads}/>
  <semantic:Instant id="segment-two-roads-start" projection={story-time} at={copy.story.segment.two-roads} boundary="start"/>
  <semantic:Instant id="segment-two-roads-start-plus-1s-base" projection={story-time} at={copy.story.segment.two-roads} boundary="start"/>
  <time:Instant id="segment-two-roads-start-plus-1s" timeline={program.timeline} at={segment-two-roads-start-plus-1s-base} offset="+1s"/>
  <semantic:Instant id="moment-road-half-cue" projection={story-time} at={copy.story.moment.road-half}/>
  <semantic:Instant id="segment-two-roads-end" projection={story-time} at={copy.story.segment.two-roads} boundary="end"/>
  <semantic:Window id="segment-water-break" projection={story-time} during={copy.story.segment.water-break}/>
  <semantic:Instant id="moment-resume-cue" projection={story-time} at={copy.story.moment.resume}/>
  <semantic:Window id="segment-closing" projection={story-time} during={copy.story.segment.closing}/>
  <semantic:Instant id="segment-closing-start-plus-1s-base" projection={story-time} at={copy.story.segment.closing} boundary="start"/>
  <time:Instant id="segment-closing-start-plus-1s" timeline={program.timeline} at={segment-closing-start-plus-1s-base} offset="+1s"/>
  <semantic:Instant id="moment-outro-github-cue" projection={story-time} at={copy.story.moment.outro-github}/>
