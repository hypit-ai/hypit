<?svml using="@hypit/recipe@1"?>
<sheet version="1">
  film.main { background: #090f1b; }
  media.hidden { fit: cover; opacity: 0; }
  media.full { fit: cover; clip: frame; }
  media.upper { fit: cover; frame-y: 0.3; content-y: 0.3; clip: frame; }
  caption.primary {
 x: 0.5; y: 0.79; width: 0.90; height: 0.13;
    anchor-x: center; anchor-y: bottom; align: center; block-align: end; inline-size: fixed;
    wrap: word; size: 68; line-height: 1.1; fill: #EDE7DE; stroke-color: #10121e; stroke-width: 6;
  shadow-color: #2b1f30;
  shadow-opacity: 1;
  shadow-x: 4;
  shadow-y: 5;
  shadow-blur: 0;
  shadow-spread: 1;
    background: #00000000; padding: "0"; radius: 0;
    karaoke: off; cue-enter: fade; cue-enter-frames: 2; cue-enter-start-scale: 0.94;
    cue-exit: none; lead-frames: 0; tail-frames: 0; handoff: cut;
  }
</sheet>
