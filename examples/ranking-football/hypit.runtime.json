{
  "format": "hypit.runtime-local@1",
  "dataRoot": ".hypit/runtimes/local",
  "credentials": {
    "os": {
      "use": "@hypit/credential-store-os"
    }
  },
  "endpoints": {
    "hypihub.football-ranking": {
      "use": "@hypit/provider-hypihub",
      "pool": "generation",
      "config": {
        "baseUrl": "https://hypit.ai",
        "apiKey": {
          "store": "os",
          "key": "hypihub.oauth"
        },
        "defaultConcurrency": 4,
        "requestTimeoutMs": 120000
      }
    },
    "media.football-ranking": {
      "use": "@hypit/provider-media-local",
      "pool": "media",
      "config": {
        "defaultConcurrency": 2
      }
    },
    "whisperx.football-ranking": {
      "use": "@hypit/provider-whisperx-local",
      "pool": "alignment",
      "config": {
        "defaultConcurrency": 1
      }
    },
    "hyperframes.football-ranking": {
      "use": "@hypit/provider-hyperframes-local",
      "pool": "render",
      "config": {
        "workers": 2,
        "quality": "standard",
        "defaultConcurrency": 1
      }
    }
  }
}
