{
  "format": "hypit.runtime-local@1",
  "dataRoot": ".hypit/runtimes/local",
  "credentials": {
    "os": {
      "use": "@hypit/credential-store-os"
    },
    "env": {
      "use": "@hypit/credential-store-env"
    }
  },
  "endpoints": {
    "kie.default": {
      "use": "@hypit/provider-kie",
      "pool": "generation",
      "config": {
        "apiKey": {
          "store": "env",
          "key": "KIE_API_KEY"
        },
        "defaultConcurrency": 10
      }
    },
    "media.local": {
      "use": "@hypit/provider-media-local",
      "pool": "media",
      "config": {
        "defaultConcurrency": 2
      }
    },
    "whisperx.local": {
      "use": "@hypit/provider-whisperx-local",
      "pool": "alignment",
      "config": {
        "defaultConcurrency": 1
      }
    },
    "hyperframes.local": {
      "use": "@hypit/provider-hyperframes-local",
      "pool": "render",
      "config": {
        "workers": 2,
        "quality": "standard",
        "defaultConcurrency": 1
      }
    }
  }
}
