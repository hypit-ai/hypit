<?svml using="@hypit/markup@1"?>

<svml>
  <import from="@hypit/script@1"/>
  <import as="audio" from="@hypit/audio-track@1"/>
  <import as="text" from="@hypit/text@1"/>
  <import as="asset" from="@hypit/media@1"/>
  <import as="gpt" from="@hypit/gpt-image@1"/>
  <import as="seedance" from="@hypit/seedance@1"/>
  <import as="mediaop" from="@hypit/media-operations@1"/>
  <import as="whisperx" from="@hypit/whisperx@1"/>
  <import as="speechalign" from="@hypit/narrative-speech-alignment@1"/>
  <import as="semantic" from="@hypit/narrative-temporal@1"/>
  <import as="narrative-caption" from="@hypit/narrative-caption@1"/>
  <import as="time" from="@hypit/timeline-author@1"/>
  <import as="visual" from="@hypit/visual-track@1"/>
  <import as="audio-track" from="@hypit/audio-track@1"/>
  <import as="caption" from="@hypit/caption@1"/>
  <import as="caption-fine" from="@hypit/caption-fine@1"/>
  <import as="fonts" from="@hypit/fontsource@1"/>
  <import as="space" from="@hypit/spatial@1"/>
  <import as="ranking" from="@hypit/ranking@1"/>
  <import as="film" from="@hypit/film@1"/>
  <import as="html" from="@hypit/html-video@1"/>
  <import as="recipes" source="./hybrid-recipes.svs"/>
  <import as="speaker-kit" source="@hypit/seedance-kits/speaker"/>

  <!-- The Program projection owns the complete board lifetime. Each discussed
       footballer's complete Segment projects its disjoint reveal window, so
       TierBoard consumes windows without finding frames. Cue boundaries are author intent. -->
  <script id="story">
    <ronaldo>
      <HOST>Ronaldo is <D | Dee> tier. || Bro has @{hair-gel} more || hair gel than @{trophy} trophies || at this point.@{/trophy}@{/hair-gel} || Built like || @{greek-god} a Greek god, || plays like || @{greek-tragedy} a Greek tragedy.@{/greek-tragedy}@{/greek-god} || But hey, || at least @{penaldo-social} he's got || the most followers || on Instagram.@{/penaldo-social}
    </ronaldo>
    <messi>
      <HOST>Messi? Man won || a World Cup || @{tired-dad} looking like || somebody's tired dad.@{/tired-dad} || Walks around || @{walks-around} for 89 minutes, || touches the ball || three times, || and somehow || @{hat-trick} you just watched || a hat trick.@{/hat-trick}@{/walks-around} || Definitely <S | Ess> tier.
    </messi>
  </script>

  <text:Value id="presenter-prompt">A photograph with the texture of real iPhone footage. Generate a vertical medium close-up, as one frame cut out of video actually shot on an iPhone: genuinely real rather than glossy, carrying the texture of video and not of a posed photograph. The background stays clearly visible, with no depth-of-field blur. Skin texture is fine and real, the light is natural, and no part of the picture is broken. A small orange tabby cat with round dark eyes, a pink nose, white muzzle, and short striped fur wears a bright yellow banana costume and a black spiked Hypit cap while holding a black handheld microphone. Keep the cat face, paws, costume silhouette, and microphone fully visible.</text:Value>
  <gpt:Image id="presenter" prompt={presenter-prompt} aspect-ratio="9:16" resolution="2K"/>
  <asset:Audio id="presenter-voice" src="./assets/cat.wav"/>
  <asset:Audio id="soundtrack" src="./assets/shared-soundtrack.m4a"/>
  <asset:Video id="accepted-ronaldo" src="./reused/ronaldo.mp4"/>
  <asset:Video id="accepted-messi" src="./reused/messi.mp4"/>
  <asset:Audio id="ranking-appear-sfx" src="./assets/ranking-appear.wav"/>
  <asset:Audio id="ranking-move-sfx" src="./assets/ranking-move.wav"/>
  <text:Value id="ronaldo-icon-prompt">A photograph with the texture of real iPhone footage. Generate a close portrait, as one frame cut out of video actually shot on an iPhone: genuinely real rather than glossy, carrying the texture of video and not of a posed photograph. The background stays clearly visible, with no depth-of-field blur. Skin texture is fine and real, the light is natural, and no part of the picture is broken. tan Portuguese footballer in his late thirties with an angular rectangular face, high cheekbones, thick dark eyebrows, narrow brown eyes, a straight prominent nose, a square jaw, and a clean-shaven face. His short dark hair is faded at the sides and brushed sharply back from the forehead; he has a muscular neck, very broad athletic shoulders, and a focused expression. He wears a plain red shirt.. Keep the portrait centered, shoulders visible, and use a simple neutral background with no readable text or logos.</text:Value>
  <gpt:Image id="ronaldo-icon" prompt={ronaldo-icon-prompt} aspect-ratio="1:1" resolution="1K"/>
  <text:Value id="messi-icon-prompt">A photograph with the texture of real iPhone footage. Generate a close portrait, as one frame cut out of video actually shot on an iPhone: genuinely real rather than glossy, carrying the texture of video and not of a posed photograph. The background stays clearly visible, with no depth-of-field blur. Skin texture is fine and real, the light is natural, and no part of the picture is broken. light-skinned Argentine footballer in his late thirties with a rounded oval face, soft brown eyes, thick brows, a straight nose, and a full neatly trimmed brown beard. His short brown hair is cropped close at the sides and brushed forward on top; he has a compact athletic neck and shoulders and a calm expression. He wears a plain sky-blue shirt.. Keep the portrait centered, shoulders visible, and use a simple neutral background with no readable text or logos.</text:Value>
  <gpt:Image id="messi-icon" prompt={messi-icon-prompt} aspect-ratio="1:1" resolution="1K"/>
  <text:Value id="yamal-icon-prompt">A photograph with the texture of real iPhone footage. Generate a close portrait, as one frame cut out of video actually shot on an iPhone: genuinely real rather than glossy, carrying the texture of video and not of a posed photograph. The background stays clearly visible, with no depth-of-field blur. Skin texture is fine and real, the light is natural, and no part of the picture is broken. young Spanish footballer with medium-brown skin, a youthful round face, dark almond-shaped eyes, thick brows, a broad nose, full lips, and a bright open expression. His short tight dark curls have a clean fade at the sides; he has a lean athletic neck and shoulders. He wears a plain blue-and-red shirt.. Keep the portrait centered, shoulders visible, and use a simple neutral background with no readable text or logos.</text:Value>
  <gpt:Image id="yamal-icon" prompt={yamal-icon-prompt} aspect-ratio="1:1" resolution="1K"/>
  <text:Value id="haaland-icon-prompt">A photograph with the texture of real iPhone footage. Generate a close portrait, as one frame cut out of video actually shot on an iPhone: genuinely real rather than glossy, carrying the texture of video and not of a posed photograph. The background stays clearly visible, with no depth-of-field blur. Skin texture is fine and real, the light is natural, and no part of the picture is broken. very tall fair-skinned Scandinavian footballer with a long rectangular face, pale blue eyes, straight light brows, a broad forehead, a straight nose, and a clean-shaven jaw. His long blond hair is parted near the center and falls past his ears; he has an unusually long neck and very broad shoulders and a neutral expression. He wears a plain light-blue shirt.. Keep the portrait centered, shoulders visible, and use a simple neutral background with no readable text or logos.</text:Value>
  <gpt:Image id="haaland-icon" prompt={haaland-icon-prompt} aspect-ratio="1:1" resolution="1K"/>
  <text:Value id="de-bruyne-icon-prompt">A photograph with the texture of real iPhone footage. Generate a close portrait, as one frame cut out of video actually shot on an iPhone: genuinely real rather than glossy, carrying the texture of video and not of a posed photograph. The background stays clearly visible, with no depth-of-field blur. Skin texture is fine and real, the light is natural, and no part of the picture is broken. fair-skinned Belgian footballer in his early thirties with an angular long face, pale blue eyes, light brows, a straight nose, and light ginger stubble along the jaw. His short ginger-blond hair is brushed back with slightly tousled texture; he has a lean athletic neck and shoulders and an intent expression. He wears a plain sky-blue shirt.. Keep the portrait centered, shoulders visible, and use a simple neutral background with no readable text or logos.</text:Value>
  <gpt:Image id="de-bruyne-icon" prompt={de-bruyne-icon-prompt} aspect-ratio="1:1" resolution="1K"/>
  <text:Value id="bellingham-icon-prompt">A photograph with the texture of real iPhone footage. Generate a close portrait, as one frame cut out of video actually shot on an iPhone: genuinely real rather than glossy, carrying the texture of video and not of a posed photograph. The background stays clearly visible, with no depth-of-field blur. Skin texture is fine and real, the light is natural, and no part of the picture is broken. young Black English footballer with medium-dark brown skin, an oval face, dark brown eyes, thick brows, a broad nose, full lips, and a broad friendly smile. His short tight curls are shaped into a neat taper fade; he has a strong athletic neck and broad shoulders. He wears a plain white shirt.. Keep the portrait centered, shoulders visible, and use a simple neutral background with no readable text or logos.</text:Value>
  <gpt:Image id="bellingham-icon" prompt={bellingham-icon-prompt} aspect-ratio="1:1" resolution="1K"/>
  <text:Value id="kane-icon-prompt">A photograph with the texture of real iPhone footage. Generate a close portrait, as one frame cut out of video actually shot on an iPhone: genuinely real rather than glossy, carrying the texture of video and not of a posed photograph. The background stays clearly visible, with no depth-of-field blur. Skin texture is fine and real, the light is natural, and no part of the picture is broken. fair-skinned English footballer in his early thirties with a broad square face, blue-gray eyes, thick brows, a straight nose, and short ginger-brown stubble. His short brown hair is brushed forward with a subtle side part; he has a strong neck, broad athletic shoulders, and a serious expression. He wears a plain white shirt.. Keep the portrait centered, shoulders visible, and use a simple neutral background with no readable text or logos.</text:Value>
  <gpt:Image id="kane-icon" prompt={kane-icon-prompt} aspect-ratio="1:1" resolution="1K"/>
  <text:Value id="modric-icon-prompt">A photograph with the texture of real iPhone footage. Generate a close portrait, as one frame cut out of video actually shot on an iPhone: genuinely real rather than glossy, carrying the texture of video and not of a posed photograph. The background stays clearly visible, with no depth-of-field blur. Skin texture is fine and real, the light is natural, and no part of the picture is broken. light-skinned Croatian footballer in his late thirties with a narrow elongated face, light blue eyes, fine brows, a straight nose, and light stubble. His long light-brown hair is parted in the middle and falls to his shoulders; he has a lean neck and slim athletic shoulders and a composed expression. He wears a plain white shirt.. Keep the portrait centered, shoulders visible, and use a simple neutral background with no readable text or logos.</text:Value>
  <gpt:Image id="modric-icon" prompt={modric-icon-prompt} aspect-ratio="1:1" resolution="1K"/>
  <text:Value id="mbappe-icon-prompt">A photograph with the texture of real iPhone footage. Generate a close portrait, as one frame cut out of video actually shot on an iPhone: genuinely real rather than glossy, carrying the texture of video and not of a posed photograph. The background stays clearly visible, with no depth-of-field blur. Skin texture is fine and real, the light is natural, and no part of the picture is broken. young Black French footballer with deep brown skin, a broad oval face, dark brown eyes, thick brows, a broad nose, a strong jaw, and full lips. His black hair is close-cropped with a clean fade; he has a muscular neck, powerful athletic shoulders, and a focused expression. He wears a plain navy shirt.. Keep the portrait centered, shoulders visible, and use a simple neutral background with no readable text or logos.</text:Value>
  <gpt:Image id="mbappe-icon" prompt={mbappe-icon-prompt} aspect-ratio="1:1" resolution="1K"/>
  <text:Value id="neymar-icon-prompt">A photograph with the texture of real iPhone footage. Generate a close portrait, as one frame cut out of video actually shot on an iPhone: genuinely real rather than glossy, carrying the texture of video and not of a posed photograph. The background stays clearly visible, with no depth-of-field blur. Skin texture is fine and real, the light is natural, and no part of the picture is broken. tan Brazilian footballer in his early thirties with an oval face, expressive brown eyes, thick brows, a straight nose, defined cheekbones, and a neatly trimmed beard and mustache. His short dark hair has faded sides and a textured top swept slightly back; he has an athletic neck and shoulders and a lively expression. He wears a plain yellow shirt.. Keep the portrait centered, shoulders visible, and use a simple neutral background with no readable text or logos.</text:Value>
  <gpt:Image id="neymar-icon" prompt={neymar-icon-prompt} aspect-ratio="1:1" resolution="1K"/>
  <text:Value id="benzema-icon-prompt">A photograph with the texture of real iPhone footage. Generate a close portrait, as one frame cut out of video actually shot on an iPhone: genuinely real rather than glossy, carrying the texture of video and not of a posed photograph. The background stays clearly visible, with no depth-of-field blur. Skin texture is fine and real, the light is natural, and no part of the picture is broken. olive-skinned French-Algerian footballer in his mid-thirties with a broad square face, dark brown eyes, thick brows, a strong nose, heavy jaw, and a full dense beard. His head is shaved close; he has a thick neck, very broad muscular shoulders, and a calm serious expression. He wears a plain white shirt.. Keep the portrait centered, shoulders visible, and use a simple neutral background with no readable text or logos.</text:Value>
  <gpt:Image id="benzema-icon" prompt={benzema-icon-prompt} aspect-ratio="1:1" resolution="1K"/>

  <!-- The performed media supplies actual word timing. -->

  <text:Value id="ronaldo-action">
    Keep the handheld microphone in the same hand throughout, and use only the free hand for gestures. At the opening, widen his eyes and nod emphatically as he begins speaking. On "hair gel", deliberately run the free hand over his hair. On "Greek god", react with exaggerated surprise. On "Greek tragedy", shake his head with a mocking laugh. On "But hey", lean his body forward and raise the free index finger as if he has just thought of something. On the final sentence, give a sarcastic shrug.
  </text:Value>
  <text:Value id="messi-action">
    Keep the handheld microphone in the same hand throughout, and use only the free hand for gestures. Throughout the opening sentence, nod continuously in small rhythmic beats. On "tired dad", look both admiring and incredulous. On "Walks around", draw a small circle in the air with the free hand. On "touches the ball", point the free thumb toward the right side of frame. As he says the exact phrase "hat trick", look deeply impressed and lift and extend the free arm upward above shoulder level with the palm open toward the upper part of the frame. The prosody of "hat trick" is strict: put the primary lexical stress on HAT. Make HAT clearly higher, louder, longer, and more accented; make "trick" shorter, lighter, and lower. The pitch must fall sharply from HAT through "trick" and finish low and closed, as a confident statement. Do not stress TRICK, do not keep both words level, and absolutely do not use rising or question-like intonation. On the final sentence, give one firm affirmative nod.
  </text:Value>

  <!-- Comedy B-roll source images. Aspect ratio and resolution stay model
       parameters; semantic placement is authored separately in the Script. -->
  <text:Value id="broll-hair-gel-prompt">
    A photograph with the texture of real iPhone footage. Generate a carefully framed composition, as one frame cut out of video actually shot on an iPhone: genuinely real rather than glossy, carrying the texture of video and not of a posed photograph. The background stays clearly visible, with no depth-of-field blur. Skin texture is fine and real, the light is natural, and no part of the picture is broken. An absurdly polished commercial product photograph of a fictional men's hair gel: an unbranded black jar with a glossy ribbon of translucent gel squeezed out beside it. Next to the jar is the back of a man's head, cropped at the shoulders, with a sharply styled short haircut so overloaded with gel that every strand looks wet, mirror-shiny, and almost reflective. Crisp studio lighting, premium cosmetics advertising, realistic textures, deadpan visual comedy, no readable text, no logos.
  </text:Value>
  <text:Value id="broll-trophy-prompt">
    A photograph with the texture of real iPhone footage. Generate a carefully framed composition, as one frame cut out of video actually shot on an iPhone: genuinely real rather than glossy, carrying the texture of video and not of a posed photograph. The background stays clearly visible, with no depth-of-field blur. Skin texture is fine and real, the light is natural, and no part of the picture is broken. A surreal comedy photograph of a monumentally oversized championship trophy planted at the center spot of a real football stadium, towering over the goals and stands. Tiny groundskeepers and players stare up at it in disbelief. Gold metal, dramatic stadium floodlights, realistic grass, cinematic sports photography, ridiculous scale, no readable text, no logos.
  </text:Value>
  <text:Value id="broll-greek-god-prompt">
    A photograph with the texture of real iPhone footage. Generate a carefully framed composition, as one frame cut out of video actually shot on an iPhone: genuinely real rather than glossy, carrying the texture of video and not of a posed photograph. The background stays clearly visible, with no depth-of-field blur. Skin texture is fine and real, the light is natural, and no part of the picture is broken. A photorealistic museum-style photograph of a muscular ancient Greek plaster statue posing like an overly confident fashion influencer: chest out, chin raised, one hand on his hip, the other adjusting imaginary sunglasses. Classical curls, white gypsum surface, heroic anatomy, dramatic gallery lighting, straight-faced visual comedy, no text.
  </text:Value>
  <text:Value id="broll-greek-tragedy-prompt">
    A photograph with the texture of real iPhone footage. Generate a carefully framed composition, as one frame cut out of video actually shot on an iPhone: genuinely real rather than glossy, carrying the texture of video and not of a posed photograph. The background stays clearly visible, with no depth-of-field blur. Skin texture is fine and real, the light is natural, and no part of the picture is broken. A photorealistic production still from a classical Greek tragedy performed in an old opera house. A male actor in ancient robes kneels at center stage with his face buried in both hands, sobbing theatrically. A chorus of mourners surrounds him with raised hands, bowed heads, and black drapery. Painted temple scenery, smoky footlights, grand melodrama, emotionally excessive but historically theatrical, no modern objects, no text.
  </text:Value>
  <text:Value id="broll-penaldo-social-prompt">
    A tightly cropped screenshot of a fictional social-media profile interface in the familiar clean Instagram visual language. The profile name must read exactly "Penaldo". The statistics must clearly show exactly "4,122 posts" and "679 million followers". The circular profile picture shows only the back silhouette of a footballer striking a penalty kick, one leg extended toward the ball. Crisp authentic mobile UI, white background, black interface text, blue verification badge, polished parody, no other names or numbers.
  </text:Value>
  <text:Value id="broll-tired-dad-trophy-prompt">
    A photograph with the texture of real iPhone footage. Generate a carefully framed composition, as one frame cut out of video actually shot on an iPhone: genuinely real rather than glossy, carrying the texture of video and not of a posed photograph. The background stays clearly visible, with no depth-of-field blur. Skin texture is fine and real, the light is natural, and no part of the picture is broken. A photorealistic sports comedy photograph of a chubby, heavily bearded middle-aged uncle in a blue-and-white striped football jersey, panting hard and drenched in sweat while clutching the FIFA World Cup trophy against his chest. His cheeks are flushed, his eyes look exhausted yet reverent, and his belly presses against the jersey. Stadium grass and celebratory confetti, affectionate absurdity, realistic human anatomy, no text.
  </text:Value>
  <text:Value id="broll-walks-around-prompt">
    A photograph with the texture of real iPhone footage. Generate a carefully framed composition, as one frame cut out of video actually shot on an iPhone: genuinely real rather than glossy, carrying the texture of video and not of a posed photograph. The background stays clearly visible, with no depth-of-field blur. Skin texture is fine and real, the light is natural, and no part of the picture is broken. A photorealistic first-person POV from someone lounging on the grass of a football pitch with legs crossed. The lower edge of the viewer's own blue-and-white striped jersey is visible, along with shorts, knees, and cleats. Far away, two teams are playing an intense match: one team in blue-and-white shirts, the other in red. The relaxed spectator posture contrasts absurdly with the frantic game, natural daylight, realistic depth, no text.
  </text:Value>
  <text:Value id="broll-hat-trick-prompt">
    A photograph with the texture of real iPhone footage. Generate a carefully framed composition, as one frame cut out of video actually shot on an iPhone: genuinely real rather than glossy, carrying the texture of video and not of a posed photograph. The background stays clearly visible, with no depth-of-field blur. Skin texture is fine and real, the light is natural, and no part of the picture is broken. A surreal visual pun rendered as a polished studio photograph: one classic black-and-white football on a small pedestal, wearing three distinct elegant black top hats perched on it at playful angles. Dramatic spotlight, rich shadows, immaculate textures, whimsical deadpan comedy, an unmistakable hat-trick joke, no text, no logos.
  </text:Value>

  <gpt:Image id="broll-hair-gel" prompt={broll-hair-gel-prompt}
    aspect-ratio="4:3" resolution="2K"/>
  <gpt:Image id="broll-trophy" prompt={broll-trophy-prompt}
    aspect-ratio="1:1" resolution="2K"/>
  <gpt:Image id="broll-greek-god" prompt={broll-greek-god-prompt}
    aspect-ratio="3:4" resolution="2K"/>
  <gpt:Image id="broll-greek-tragedy" prompt={broll-greek-tragedy-prompt}
    aspect-ratio="4:3" resolution="2K"/>
  <gpt:Image id="broll-penaldo-social" prompt={broll-penaldo-social-prompt}
    aspect-ratio="21:9" resolution="2K"/>
  <gpt:Image id="broll-tired-dad-trophy" prompt={broll-tired-dad-trophy-prompt}
    aspect-ratio="4:3" resolution="2K"/>
  <gpt:Image id="broll-walks-around" prompt={broll-walks-around-prompt}
    aspect-ratio="4:3" resolution="2K"/>
  <gpt:Image id="broll-hat-trick" prompt={broll-hat-trick-prompt}
    aspect-ratio="1:1" resolution="2K"/>

  <text:Render id="ronaldo-prompt" template={speaker-kit.speaker-v1}
    recipe={recipes.speaker.host}>
    <text:Set name="dialogue" text={story.segment.ronaldo.dialogue}/>
    <text:Set name="action" text={ronaldo-action}/>
  </text:Render>
  <text:Render id="messi-prompt" template={speaker-kit.speaker-v1}
    recipe={recipes.speaker.host}>
    <text:Set name="dialogue" text={story.segment.messi.dialogue}/>
    <text:Set name="action" text={messi-action}/>
  </text:Render>

  <!-- The only two generated A-roll Takes in the author programme. -->
  <seedance:ReferenceVideo id="ronaldo-take" model="mini"
    prompt={ronaldo-prompt} duration="10"
    resolution="720p" aspect-ratio="9:16" generate-audio="true">
    <seedance:Reference image={presenter.image} person-reference="true"/>
    <seedance:Reference audio={presenter-voice}/>
  </seedance:ReferenceVideo>
  <seedance:ReferenceVideo id="messi-take" model="mini"
    prompt={messi-prompt} duration="10"
    resolution="720p" aspect-ratio="9:16" generate-audio="true">
    <seedance:Reference image={presenter.image} person-reference="true"/>
    <seedance:Reference audio={presenter-voice}/>
  </seedance:ReferenceVideo>

  <space:Canvas id="vertical" width="720" height="1280"/>
  <time:Clock id="clock" frame-rate="30"/>
  <mediaop:Prepare id="soundtrack-media" source={soundtrack}
    video="none" audio="default" span-authority="audio"/>
  <mediaop:Prepare id="ranking-appear-media" source={ranking-appear-sfx}
    video="none" audio="default" span-authority="audio"/>
  <mediaop:Prepare id="ranking-move-media" source={ranking-move-sfx}
    video="none" audio="default" span-authority="audio"/>
  <space:Frame id="speech-frame" within={vertical.bounds}
    left="0%" top="0%" right="100%" bottom="100%"/>
  <space:Frame id="column-frame" within={vertical.bounds}
    left="0%" top="10%" right="26%" bottom="67.5%"/>

  <!-- B-roll lives inside the lower board region. Deliberately varied card
       proportions and offsets keep the treatment playful without entering the
       caption band above it. Extents describe the generated image bytes. -->
  <space:Extent id="hair-gel-extent" width="2688" height="2016"/>
  <space:Extent id="trophy-extent" width="2048" height="2048"/>
  <space:Extent id="greek-god-extent" width="2016" height="2688"/>
  <space:Extent id="greek-tragedy-extent" width="2688" height="2016"/>
  <space:Extent id="penaldo-social-extent" width="2688" height="1152"/>
  <space:Extent id="tired-dad-extent" width="2336" height="1744"/>
  <space:Extent id="walks-around-extent" width="2688" height="2016"/>
  <space:Extent id="hat-trick-extent" width="2048" height="2048"/>

  <space:AspectFrame id="hair-gel-frame" within={vertical.bounds}
    x="34%" y="78%" width="58%" aspect={hair-gel-extent} anchor="center"/>
  <space:AspectFrame id="trophy-frame" within={vertical.bounds}
    x="73%" y="82%" width="42%" aspect={trophy-extent} anchor="center"/>
  <space:AspectFrame id="greek-god-frame" within={vertical.bounds}
    x="24%" y="78%" width="38%" aspect={greek-god-extent} anchor="center"/>
  <space:AspectFrame id="greek-tragedy-frame" within={vertical.bounds}
    x="63%" y="79%" width="66%" aspect={greek-tragedy-extent} anchor="center"/>
  <space:AspectFrame id="penaldo-social-frame" within={vertical.bounds}
    x="50%" y="78%" width="94%" aspect={penaldo-social-extent} anchor="center"/>
  <space:AspectFrame id="tired-dad-frame" within={vertical.bounds}
    x="58%" y="79%" width="62%" aspect={tired-dad-extent} anchor="center"/>
  <space:AspectFrame id="walks-around-frame" within={vertical.bounds}
    x="38%" y="79%" width="68%" aspect={walks-around-extent} anchor="center"/>
  <space:AspectFrame id="hat-trick-frame" within={vertical.bounds}
    x="72%" y="80%" width="46%" aspect={hat-trick-extent} anchor="center"/>

  <!-- Real Build path: generated video -> one shared preparation waist ->
       measured alignment. -->
  <mediaop:Prepare id="ronaldo-media" source={accepted-ronaldo}
    video="primary-moving" audio="default" span-authority="video"/>
  <mediaop:Prepare id="messi-media" source={accepted-messi}
    video="primary-moving" audio="default" span-authority="video"/>
  <whisperx:Transcription id="ronaldo-semantic-transcription" media={ronaldo-media.media} language="en"/>
  <speechalign:Alignment id="ronaldo-semantic" narrative={story}
    segment={story.segment.ronaldo} domain={ronaldo-media.domain} evidence={ronaldo-semantic-transcription.transcript}/>
  <whisperx:Transcription id="messi-semantic-transcription" media={messi-media.media} language="en"/>
  <speechalign:Alignment id="messi-semantic" narrative={story}
    segment={story.segment.messi} domain={messi-media.domain} evidence={messi-semantic-transcription.transcript}/>

  <time:Timeline id="speech" clock={clock} end="messi-semantic.end">
    <time:Window id="ronaldo-semantic" from="start" for={ronaldo-media.extent}/>
    <time:Window id="messi-semantic" from="ronaldo-semantic.end" for={messi-media.extent}/>
  </time:Timeline>


  <semantic:Projection id="story-time" narrative={story} timeline={speech.timeline}>
    <semantic:Map alignment={ronaldo-semantic.alignment} domain={ronaldo-media.domain} window={speech.ronaldo-semantic}/>
    <semantic:Map alignment={messi-semantic.alignment} domain={messi-media.domain} window={speech.messi-semantic}/>
  </semantic:Projection>
  <semantic:Window id="segment-ronaldo" projection={story-time} during={story.segment.ronaldo}/>
  <semantic:Window id="segment-messi" projection={story-time} during={story.segment.messi}/>
  <semantic:Window id="selection-hair-gel" projection={story-time} during={story.selection.hair-gel}/>
  <semantic:Window id="selection-trophy" projection={story-time} during={story.selection.trophy}/>
  <semantic:Window id="selection-greek-god" projection={story-time} during={story.selection.greek-god}/>
  <semantic:Window id="selection-greek-tragedy" projection={story-time} during={story.selection.greek-tragedy}/>
  <semantic:Window id="selection-penaldo-social" projection={story-time} during={story.selection.penaldo-social}/>
  <semantic:Window id="selection-tired-dad" projection={story-time} during={story.selection.tired-dad}/>
  <semantic:Window id="selection-walks-around" projection={story-time} during={story.selection.walks-around}/>
  <semantic:Window id="selection-hat-trick" projection={story-time} during={story.selection.hat-trick}/>
  <audio:Track id="speech-sound" timeline={speech.timeline}>
    <audio:Clip id="ronaldo-semantic-source" source={ronaldo-media.media} during={speech.ronaldo-semantic}/>
    <audio:Clip id="messi-semantic-source" source={messi-media.media} during={speech.messi-semantic}/>
  </audio:Track>
  <visual:Motion id="broll-left">
    <visual:Pose at="start" scale="0.7" opacity="0" easing="ease-out"/>
    <visual:Pose at="6f" scale="1" opacity="1"/>
    <visual:Pose at="end-4f" scale="1" opacity="1" easing="ease-in"/>
    <visual:Pose at="end" scale="1" opacity="0"/>
  </visual:Motion>
  <visual:Motion id="broll-right">
    <visual:Pose at="start" y="80" scale="0.92" opacity="0" easing="ease-out"/>
    <visual:Pose at="7f" y="0" scale="1" opacity="1"/>
    <visual:Pose at="end-4f" y="0" scale="1" opacity="1" easing="ease-in"/>
    <visual:Pose at="end" y="0" scale="0.94" opacity="1"/>
  </visual:Motion>
  <visual:Motion id="broll-wide">
    <visual:Pose at="start" scale="0.9" opacity="1" easing="ease-out"/>
    <visual:Pose at="6f" scale="1" opacity="1"/>
    <visual:Pose at="end-4f" scale="1" opacity="1" easing="ease-in"/>
    <visual:Pose at="end" scale="1" opacity="0"/>
  </visual:Motion>

  <visual:Track id="speech-picture" timeline={speech.timeline}>
    <visual:Clip id="ronaldo-semantic-source" media={ronaldo-media.media} during={speech.ronaldo-semantic} frame={speech-frame} fit="cover"/>
    <visual:Clip id="messi-semantic-source" media={messi-media.media} during={speech.messi-semantic} frame={speech-frame} fit="cover"/>
  </visual:Track>
  <audio-track:Track id="music-bed" timeline={speech.timeline}>
    <audio-track:Clip source={soundtrack-media.media} during={speech.window}
      gain="0.12" fade-in="300ms" fade-out="600ms"/>
  </audio-track:Track>

  <fonts:Face id="display-font" package="@fontsource-variable/montserrat" weight="900" style="normal"/>
  <fonts:Face id="column-font" package="@fontsource-variable/inter" weight="700" style="normal"/>
  <ranking:ColumnStyle id="column-style" recipe={recipes.ranking.football-column}
    font={column-font}/>
  <ranking:Column id="football-column" timeline={speech.timeline}
    within={vertical.bounds} frame={column-frame} during={speech.window} style={column-style}
    appear-sound={ranking-appear-media.media}
    move-sound={ranking-move-media.media}>
    <ranking:ColumnItem id="ronaldo" rank="1" label="Ronaldo"
      icon={ronaldo-icon.image} during={segment-ronaldo}/>
    <ranking:ColumnItem id="messi" rank="2" label="Messi"
      icon={messi-icon.image} during={segment-messi}/>
    <ranking:ColumnItem id="yamal" rank="3" label="Yamal" preset="true" icon={yamal-icon.image}/>
    <ranking:ColumnItem id="haaland" rank="4" label="Haaland" preset="true" icon={haaland-icon.image}/>
    <ranking:ColumnItem id="de-bruyne" rank="5" label="De Bruyne" preset="true" icon={de-bruyne-icon.image}/>
    <ranking:ColumnItem id="bellingham" rank="6" label="Bellingham" preset="true" icon={bellingham-icon.image}/>
    <ranking:ColumnItem id="kane" rank="7" label="Kane" preset="true" icon={kane-icon.image}/>
    <ranking:ColumnItem id="modric" rank="8" label="Modric" preset="true" icon={modric-icon.image}/>
    <ranking:ColumnItem id="mbappe" rank="9" label="Mbappe" preset="true" icon={mbappe-icon.image}/>
    <ranking:ColumnItem id="neymar" rank="10" label="Neymar" preset="true" icon={neymar-icon.image}/>
    <ranking:ColumnItem id="benzema" rank="11" label="Benzema" preset="true" icon={benzema-icon.image}/>
  </ranking:Column>

  <!-- Every Item consumes a projected Selection window. Later overlapping
       jokes use a higher explicit z on their own Clip occurrence. -->
  <visual:Track id="broll" timeline={speech.timeline}>
    <visual:Clip id="hair-gel" image={broll-hair-gel.image} picture="srgb"
      extent={hair-gel-extent} during={selection-hair-gel}
      frame={hair-gel-frame} fit="cover" treatment={recipes.media.hair-gel}
      motion={broll-left}/>
    <visual:Clip id="trophy" image={broll-trophy.image} picture="srgb"
      extent={trophy-extent} during={selection-trophy}
      frame={trophy-frame} fit="cover" treatment={recipes.media.trophy}
      motion={broll-right}/>
    <visual:Clip id="greek-god" image={broll-greek-god.image} picture="srgb"
      extent={greek-god-extent} during={selection-greek-god}
      frame={greek-god-frame} fit="cover" treatment={recipes.media.greek-god}
      motion={broll-left}/>
    <visual:Clip id="greek-tragedy" image={broll-greek-tragedy.image} picture="srgb"
      extent={greek-tragedy-extent} during={selection-greek-tragedy}
      frame={greek-tragedy-frame} fit="cover" treatment={recipes.media.greek-tragedy}
      motion={broll-right}/>
    <visual:Clip id="penaldo-social" image={broll-penaldo-social.image} picture="srgb"
      extent={penaldo-social-extent} during={selection-penaldo-social}
      frame={penaldo-social-frame} fit="cover" treatment={recipes.media.penaldo-social}
      motion={broll-wide}/>
    <visual:Clip id="tired-dad" image={broll-tired-dad-trophy.image} picture="srgb"
      extent={tired-dad-extent} during={selection-tired-dad}
      frame={tired-dad-frame} fit="cover" treatment={recipes.media.tired-dad}
      motion={broll-right}/>
    <visual:Clip id="walks-around" image={broll-walks-around.image} picture="srgb"
      extent={walks-around-extent} during={selection-walks-around}
      frame={walks-around-frame} fit="cover" treatment={recipes.media.walks-around}
      motion={broll-left}/>
    <visual:Clip id="hat-trick" image={broll-hat-trick.image} picture="srgb"
      extent={hat-trick-extent} during={selection-hat-trick}
      frame={hat-trick-frame} fit="cover" treatment={recipes.media.hat-trick}
      motion={broll-right}/>
  </visual:Track>

  <caption-fine:Style id="caption-style" recipe={recipes.caption.primary}
    font={display-font}/>

  <narrative-caption:Timing id="caption-timing" document={story.caption} binding={story.caption-binding} projection={story-time}/>
  <caption-fine:Caption id="captions" document={story.caption} timing={caption-timing}
    timeline={speech.timeline} within={vertical.bounds}>
    <caption-fine:Use style={caption-style}/>
  </caption-fine:Caption>

  <film:Film id="main" canvas={vertical.canvas} timeline={speech.timeline}
    appearance={recipes.film.vertical}>
    <film:Track id="speech-picture" source={speech-picture.visual}/>
    <film:Track source={speech-sound.audio}/>
    <film:Track id="football-column" source={football-column.visual}/>
    <film:Track source={football-column.audio}/>
    <film:Track id="broll" source={broll.visual}/>
    <film:Track id="captions" source={captions.visual}/>
    <film:Track source={music-bed.audio}/>
  </film:Film>
  <html:Video id="final" composition={main.composition}/>
</svml>
