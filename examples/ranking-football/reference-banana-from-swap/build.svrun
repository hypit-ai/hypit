  <file id="broll-2" type="@hypit/artifact@1#BlobArtifact" from="./accepted/brolls/1-2.png" media-type="image/png"/>
  <file id="broll-3" type="@hypit/artifact@1#BlobArtifact" from="./accepted/brolls/1-3.png" media-type="image/png"/>
  <file id="broll-4" type="@hypit/artifact@1#BlobArtifact" from="./accepted/brolls/1-4.png" media-type="image/png"/>
  <file id="broll-5" type="@hypit/artifact@1#BlobArtifact" from="./accepted/brolls/1-5.png" media-type="image/png"/>
  <file id="broll-6" type="@hypit/artifact@1#BlobArtifact" from="./accepted/brolls/1-6.png" media-type="image/png"/>
  <file id="broll-7" type="@hypit/artifact@1#BlobArtifact" from="./accepted/brolls/1-7.png" media-type="image/png"/>
