<?svml using="@hypit/markup@1"?>

<svml>
  <import from="@hypit/script@1"/>
  <import as="audio" from="@hypit/audio-track@1"/>
  <import as="text" from="@hypit/text@1"/>
  <import as="asset" from="@hypit/media@1"/>
  <import as="gpt" from="@hypit/gpt-image@1"/>
  <import as="seedance" from="@hypit/seedance@1"/>
  <import as="mediaop" from="@hypit/media-operations@1"/>
  <import as="whisperx" from="@hypit/whisperx@1"/>
  <import as="speechalign" from="@hypit/narrative-speech-alignment@1"/>
  <import as="semantic" from="@hypit/narrative-temporal@1"/>
  <import as="narrative-caption" from="@hypit/narrative-caption@1"/>
  <import as="time" from="@hypit/timeline-author@1"/>
  <import as="visual" from="@hypit/visual-track@1"/>
  <import as="audio-track" from="@hypit/audio-track@1"/>
  <import as="caption" from="@hypit/caption@1"/>
  <import as="caption-fine" from="@hypit/caption-fine@1"/>
  <import as="fonts" from="@hypit/fontsource@1"/>
  <import as="space" from="@hypit/spatial@1"/>
  <import as="ranking" from="@hypit/ranking@1"/>
  <import as="film" from="@hypit/film@1"/>
  <import as="html" from="@hypit/html-video@1"/>
  <import as="recipes" source="./column-recipes.svs"/>
  <import as="speaker-kit" source="@hypit/seedance-kits/speaker"/>

  <!-- Cue boundaries remain explicit author intent. The complete Messi and
       Ronaldo Segments are also the two disjoint Column reveal windows. -->
  <script id="story">
    <messi>
      <HOST>Messi is the bottom. || Five foot seven, || no muscles, || no speed, || just vibes. || @{pitch-pov} Man walks around || the pitch like || @{ikea-sign} he's lost in <IKEA | eye KEE uh>.@{/ikea-sign}@{/pitch-pov} || @{retirement-room} Went to Miami || and turned the league || into a retirement home.@{/retirement-room}
    </messi>
    <ronaldo>
      <HOST>Ronaldo? Bro is || 39 years old || @{rent-jump} and still jumps || higher than your rent.@{/rent-jump} || @{nine-hundred-goals} Nine hundred goals, || @{laboratory-body} a body built || in a laboratory, || @{museum-jawline} and a jawline || that belongs || in a museum.@{/museum-jawline}@{/laboratory-body}@{/nine-hundred-goals} || Absolutely the top one.
    </ronaldo>
  </script>

  <text:Value id="presenter-prompt">A photograph with the texture of real iPhone footage. Generate a vertical medium close-up, as one frame cut out of video actually shot on an iPhone: genuinely real rather than glossy, carrying the texture of video and not of a posed photograph. The background stays clearly visible, with no depth-of-field blur. Skin texture is fine and real, the light is natural, and no part of the picture is broken. A pale young woman with a narrow oval face, large gray eyes, straight brows, long jet-black hair with blunt bangs, and a slim shoulder line wears a black spiked cap, black choker, layered silver necklaces, and a black graphic top while holding a furry microphone. Keep her face, hair, shoulders, and microphone visible.</text:Value>
  <gpt:Image id="presenter" prompt={presenter-prompt} aspect-ratio="9:16" resolution="2K"/>
  <asset:Audio id="presenter-voice" src="./assets/goth.wav"/>
  <asset:Audio id="soundtrack" src="./assets/shared-soundtrack.m4a"/>
  <asset:Audio id="ranking-appear-sfx" src="./assets/ranking-appear.wav"/>
  <asset:Audio id="ranking-move-sfx" src="./assets/ranking-move.wav"/>
  <text:Value id="ronaldo-icon-prompt">A photograph with the texture of real iPhone footage. Generate a close portrait, as one frame cut out of video actually shot on an iPhone: genuinely real rather than glossy, carrying the texture of video and not of a posed photograph. The background stays clearly visible, with no depth-of-field blur. Skin texture is fine and real, the light is natural, and no part of the picture is broken. tan Portuguese footballer in his late thirties with an angular rectangular face, high cheekbones, thick dark eyebrows, narrow brown eyes, a straight prominent nose, a square jaw, and a clean-shaven face. His short dark hair is faded at the sides and brushed sharply back from the forehead; he has a muscular neck, very broad athletic shoulders, and a focused expression. He wears a plain red shirt.. Keep the portrait centered, shoulders visible, and use a simple neutral background with no readable text or logos.</text:Value>
  <gpt:Image id="ronaldo-icon" prompt={ronaldo-icon-prompt} aspect-ratio="1:1" resolution="1K"/>
  <text:Value id="messi-icon-prompt">A photograph with the texture of real iPhone footage. Generate a close portrait, as one frame cut out of video actually shot on an iPhone: genuinely real rather than glossy, carrying the texture of video and not of a posed photograph. The background stays clearly visible, with no depth-of-field blur. Skin texture is fine and real, the light is natural, and no part of the picture is broken. light-skinned Argentine footballer in his late thirties with a rounded oval face, soft brown eyes, thick brows, a straight nose, and a full neatly trimmed brown beard. His short brown hair is cropped close at the sides and brushed forward on top; he has a compact athletic neck and shoulders and a calm expression. He wears a plain sky-blue shirt.. Keep the portrait centered, shoulders visible, and use a simple neutral background with no readable text or logos.</text:Value>
  <gpt:Image id="messi-icon" prompt={messi-icon-prompt} aspect-ratio="1:1" resolution="1K"/>
  <text:Value id="mbappe-icon-prompt">A photograph with the texture of real iPhone footage. Generate a close portrait, as one frame cut out of video actually shot on an iPhone: genuinely real rather than glossy, carrying the texture of video and not of a posed photograph. The background stays clearly visible, with no depth-of-field blur. Skin texture is fine and real, the light is natural, and no part of the picture is broken. young Black French footballer with deep brown skin, a broad oval face, dark brown eyes, thick brows, a broad nose, a strong jaw, and full lips. His black hair is close-cropped with a clean fade; he has a muscular neck, powerful athletic shoulders, and a focused expression. He wears a plain navy shirt.. Keep the portrait centered, shoulders visible, and use a simple neutral background with no readable text or logos.</text:Value>
  <gpt:Image id="mbappe-icon" prompt={mbappe-icon-prompt} aspect-ratio="1:1" resolution="1K"/>
  <text:Value id="haaland-icon-prompt">A photograph with the texture of real iPhone footage. Generate a close portrait, as one frame cut out of video actually shot on an iPhone: genuinely real rather than glossy, carrying the texture of video and not of a posed photograph. The background stays clearly visible, with no depth-of-field blur. Skin texture is fine and real, the light is natural, and no part of the picture is broken. very tall fair-skinned Scandinavian footballer with a long rectangular face, pale blue eyes, straight light brows, a broad forehead, a straight nose, and a clean-shaven jaw. His long blond hair is parted near the center and falls past his ears; he has an unusually long neck and very broad shoulders and a neutral expression. He wears a plain light-blue shirt.. Keep the portrait centered, shoulders visible, and use a simple neutral background with no readable text or logos.</text:Value>
  <gpt:Image id="haaland-icon" prompt={haaland-icon-prompt} aspect-ratio="1:1" resolution="1K"/>
  <text:Value id="bellingham-icon-prompt">A photograph with the texture of real iPhone footage. Generate a close portrait, as one frame cut out of video actually shot on an iPhone: genuinely real rather than glossy, carrying the texture of video and not of a posed photograph. The background stays clearly visible, with no depth-of-field blur. Skin texture is fine and real, the light is natural, and no part of the picture is broken. young Black English footballer with medium-dark brown skin, an oval face, dark brown eyes, thick brows, a broad nose, full lips, and a broad friendly smile. His short tight curls are shaped into a neat taper fade; he has a strong athletic neck and broad shoulders. He wears a plain white shirt.. Keep the portrait centered, shoulders visible, and use a simple neutral background with no readable text or logos.</text:Value>
  <gpt:Image id="bellingham-icon" prompt={bellingham-icon-prompt} aspect-ratio="1:1" resolution="1K"/>
  <text:Value id="de-bruyne-icon-prompt">A photograph with the texture of real iPhone footage. Generate a close portrait, as one frame cut out of video actually shot on an iPhone: genuinely real rather than glossy, carrying the texture of video and not of a posed photograph. The background stays clearly visible, with no depth-of-field blur. Skin texture is fine and real, the light is natural, and no part of the picture is broken. fair-skinned Belgian footballer in his early thirties with an angular long face, pale blue eyes, light brows, a straight nose, and light ginger stubble along the jaw. His short ginger-blond hair is brushed back with slightly tousled texture; he has a lean athletic neck and shoulders and an intent expression. He wears a plain sky-blue shirt.. Keep the portrait centered, shoulders visible, and use a simple neutral background with no readable text or logos.</text:Value>
  <gpt:Image id="de-bruyne-icon" prompt={de-bruyne-icon-prompt} aspect-ratio="1:1" resolution="1K"/>
  <text:Value id="yamal-icon-prompt">A photograph with the texture of real iPhone footage. Generate a close portrait, as one frame cut out of video actually shot on an iPhone: genuinely real rather than glossy, carrying the texture of video and not of a posed photograph. The background stays clearly visible, with no depth-of-field blur. Skin texture is fine and real, the light is natural, and no part of the picture is broken. young Spanish footballer with medium-brown skin, a youthful round face, dark almond-shaped eyes, thick brows, a broad nose, full lips, and a bright open expression. His short tight dark curls have a clean fade at the sides; he has a lean athletic neck and shoulders. He wears a plain blue-and-red shirt.. Keep the portrait centered, shoulders visible, and use a simple neutral background with no readable text or logos.</text:Value>
  <gpt:Image id="yamal-icon" prompt={yamal-icon-prompt} aspect-ratio="1:1" resolution="1K"/>
  <text:Value id="kane-icon-prompt">A photograph with the texture of real iPhone footage. Generate a close portrait, as one frame cut out of video actually shot on an iPhone: genuinely real rather than glossy, carrying the texture of video and not of a posed photograph. The background stays clearly visible, with no depth-of-field blur. Skin texture is fine and real, the light is natural, and no part of the picture is broken. fair-skinned English footballer in his early thirties with a broad square face, blue-gray eyes, thick brows, a straight nose, and short ginger-brown stubble. His short brown hair is brushed forward with a subtle side part; he has a strong neck, broad athletic shoulders, and a serious expression. He wears a plain white shirt.. Keep the portrait centered, shoulders visible, and use a simple neutral background with no readable text or logos.</text:Value>
  <gpt:Image id="kane-icon" prompt={kane-icon-prompt} aspect-ratio="1:1" resolution="1K"/>
  <text:Value id="modric-icon-prompt">A photograph with the texture of real iPhone footage. Generate a close portrait, as one frame cut out of video actually shot on an iPhone: genuinely real rather than glossy, carrying the texture of video and not of a posed photograph. The background stays clearly visible, with no depth-of-field blur. Skin texture is fine and real, the light is natural, and no part of the picture is broken. light-skinned Croatian footballer in his late thirties with a narrow elongated face, light blue eyes, fine brows, a straight nose, and light stubble. His long light-brown hair is parted in the middle and falls to his shoulders; he has a lean neck and slim athletic shoulders and a composed expression. He wears a plain white shirt.. Keep the portrait centered, shoulders visible, and use a simple neutral background with no readable text or logos.</text:Value>
  <gpt:Image id="modric-icon" prompt={modric-icon-prompt} aspect-ratio="1:1" resolution="1K"/>
  <text:Value id="neymar-icon-prompt">A photograph with the texture of real iPhone footage. Generate a close portrait, as one frame cut out of video actually shot on an iPhone: genuinely real rather than glossy, carrying the texture of video and not of a posed photograph. The background stays clearly visible, with no depth-of-field blur. Skin texture is fine and real, the light is natural, and no part of the picture is broken. tan Brazilian footballer in his early thirties with an oval face, expressive brown eyes, thick brows, a straight nose, defined cheekbones, and a neatly trimmed beard and mustache. His short dark hair has faded sides and a textured top swept slightly back; he has an athletic neck and shoulders and a lively expression. He wears a plain yellow shirt.. Keep the portrait centered, shoulders visible, and use a simple neutral background with no readable text or logos.</text:Value>
  <gpt:Image id="neymar-icon" prompt={neymar-icon-prompt} aspect-ratio="1:1" resolution="1K"/>

  <text:Value id="messi-action">
    Keep the handheld microphone in the same hand throughout and use only the free hand for gestures. On "Messi is the bottom", lower the free palm toward the floor and give one deadpan downward nod. On "Five foot seven", hold the free hand low as if marking a short height. Give three small counting beats through "no muscles, no speed, just vibes", ending with a loose shoulder shrug and an amused half-smile on "just vibes". On "Man walks around", slowly draw a lazy circle in the air. On "lost in IKEA", glance left and right with a puzzled squint, then point uncertainly off frame. On "retirement home", briefly hunch the shoulders and mime one slow old-man step with the free hand before finishing with a knowing smirk.
  </text:Value>
  <text:Value id="ronaldo-action">
    Keep the handheld microphone in the same hand throughout and use only the free hand for gestures. Keep the presenter's face, skin, hair, clothing, body, microphone, room, lighting, and natural human appearance continuous and unchanged from the first frame to the last. Open with a skeptical raised eyebrow on "Ronaldo?" and one emphatic nod on "39 years old". On "still jumps higher than your rent", drive the free hand sharply upward above shoulder level and follow it with the eyes, then land the punchline with a sarcastic grin. Present "Nine hundred goals" with one broad, confident sweep of the free hand. On "a body built in a laboratory", briefly flex the free arm, tap the bicep once, and immediately return to a relaxed natural speaking posture while keeping the face animated. On "jawline", trace the edge of the jaw once with the free index finger. On "museum", turn the free palm outward as if presenting an expensive exhibit offscreen, raise one eyebrow, and keep talking naturally. On "Absolutely the top one", raise one index finger decisively and finish with a firm nod.
  </text:Value>

  <!-- Aspect ratio is model configuration, never prose hidden in the prompt. -->
  <text:Value id="broll-pitch-pov-prompt">
    A photograph with the texture of real iPhone footage. Generate a carefully framed composition, as one frame cut out of video actually shot on an iPhone: genuinely real rather than glossy, carrying the texture of video and not of a posed photograph. The background stays clearly visible, with no depth-of-field blur. Skin texture is fine and real, the light is natural, and no part of the picture is broken. A photorealistic first-person POV from someone lounging lazily on the grass of a football pitch with legs crossed. The lower edge of the viewer's own blue-and-white striped football jersey is visible. In the distance, two teams play an intense match, one in blue and white and the other in red. The relaxed spectator posture contrasts absurdly with the frantic game, natural daylight, realistic depth, deadpan sports comedy, no readable text, no logos.
  </text:Value>
  <text:Value id="broll-ikea-sign-prompt">
    A photograph with the texture of real iPhone footage. Generate a carefully framed composition, as one frame cut out of video actually shot on an iPhone: genuinely real rather than glossy, carrying the texture of video and not of a posed photograph. The background stays clearly visible, with no depth-of-field blur. Skin texture is fine and real, the light is natural, and no part of the picture is broken. A deadpan comedy photograph of a monumental blue-and-white striped storefront sign standing beside a football training ground. The sign must read exactly "IKEA" in large clean yellow capital letters. Stark commercial architecture, bright daylight, crisp realistic materials, absurdly oversized wayfinding sign, no people, no other readable text.
  </text:Value>
  <text:Value id="broll-retirement-room-prompt">
    A photograph with the texture of real iPhone footage. Generate a carefully framed composition, as one frame cut out of video actually shot on an iPhone: genuinely real rather than glossy, carrying the texture of video and not of a posed photograph. The background stays clearly visible, with no depth-of-field blur. Skin texture is fine and real, the light is natural, and no part of the picture is broken. A photorealistic professional football locker room after practice, with open lockers, wooden benches, boots and blue towels. The room has been absurdly taken over by elderly mobility equipment: scattered walking canes, walkers, wheelchairs, a mobility scooter, orthopedic cushions and reading glasses. No people, realistic stadium facilities, dry visual comedy, no readable text, no logos.
  </text:Value>
  <text:Value id="broll-rent-jump-prompt">
    A surreal editorial sports image of a fictional gel-haired footballer in a red jersey leaping cleanly over a huge, extremely steep rising data curve as if it were a hurdle. The athlete is frozen at the apex with dramatic athletic form while the graph shoots upward beneath him. Bold abstract background, cinematic lighting, energetic meme composition, no axis labels, no numbers, no readable text, no logos.
  </text:Value>
  <text:Value id="broll-nine-hundred-prompt">
    A polished satirical football analytics report card. The dominant centerpiece must read exactly "900 GOALS", with the number 900 enormous and unmistakable. Surround it with minimal clean data bars, goal markers and subtle stadium-grid details, high contrast sports-broadcast design, no player portrait, no logos, no other words or numbers.
  </text:Value>
  <text:Value id="broll-laboratory-body-prompt">
    A photograph with the texture of real iPhone footage. Generate a carefully framed composition, as one frame cut out of video actually shot on an iPhone: genuinely real rather than glossy, carrying the texture of video and not of a posed photograph. The background stays clearly visible, with no depth-of-field blur. Skin texture is fine and real, the light is natural, and no part of the picture is broken. A photorealistic museum-safe bronze sculpture of a fictional Greek champion seen from behind, wearing a modest classical athletic singlet and knee-length training shorts, standing on a pedestal in a futuristic biomedical laboratory and flexing both arms in a double-biceps bodybuilding pose. Glass instruments, cool laboratory lights and clinical equipment surround the fully clothed heroic bronze figure. Family-friendly straight-faced visual comedy, realistic metal patina, no readable text, no logos.
  </text:Value>
  <text:Value id="broll-museum-jawline-prompt">
    A tight funny studio headshot of a fictional sigma tough guy looking slightly upward into the camera. He has a cartoonishly exaggerated square jawline, a confident smile and his left eyebrow raised at the viewer. Slick hair, dramatic beauty lighting, crisp realistic skin, intentionally over-serious internet-meme masculinity, no readable text, no logos.
  </text:Value>

  <gpt:Image id="broll-pitch-pov" prompt={broll-pitch-pov-prompt}
    aspect-ratio="4:3" resolution="2K"/>
  <gpt:Image id="broll-ikea-sign" prompt={broll-ikea-sign-prompt}
    aspect-ratio="1:1" resolution="2K"/>
  <gpt:Image id="broll-retirement-room" prompt={broll-retirement-room-prompt}
    aspect-ratio="4:3" resolution="2K"/>
  <gpt:Image id="broll-rent-jump" prompt={broll-rent-jump-prompt}
    aspect-ratio="4:3" resolution="2K"/>
  <gpt:Image id="broll-nine-hundred" prompt={broll-nine-hundred-prompt}
    aspect-ratio="1:1" resolution="2K"/>
  <gpt:Image id="broll-laboratory-body" prompt={broll-laboratory-body-prompt}
    aspect-ratio="3:4" resolution="2K"/>
  <gpt:Image id="broll-museum-jawline" prompt={broll-museum-jawline-prompt}
    aspect-ratio="1:1" resolution="2K"/>

  <text:Render id="messi-prompt" template={speaker-kit.speaker-v1}
    recipe={recipes.speaker.host}>
    <text:Set name="dialogue" text={story.segment.messi.dialogue}/>
    <text:Set name="action" text={messi-action}/>
  </text:Render>
  <text:Render id="ronaldo-prompt" template={speaker-kit.speaker-v1}
    recipe={recipes.speaker.host}>
    <text:Set name="dialogue" text={story.segment.ronaldo.dialogue}/>
    <text:Set name="action" text={ronaldo-action}/>
  </text:Render>

  <seedance:ReferenceVideo id="messi-take" model="mini"
    prompt={messi-prompt} duration="10"
    resolution="720p" aspect-ratio="9:16" generate-audio="true">
    <seedance:Reference image={presenter.image} person-reference="true"/>
    <seedance:Reference audio={presenter-voice}/>
  </seedance:ReferenceVideo>
  <seedance:ReferenceVideo id="ronaldo-take" model="mini"
    prompt={ronaldo-prompt} duration="10"
    resolution="720p" aspect-ratio="9:16" generate-audio="true">
    <seedance:Reference image={presenter.image} person-reference="true"/>
    <seedance:Reference audio={presenter-voice}/>
  </seedance:ReferenceVideo>

  <space:Canvas id="vertical" width="720" height="1280"/>
  <time:Clock id="clock" frame-rate="30"/>
  <mediaop:Prepare id="soundtrack-media" source={soundtrack}
    video="none" audio="default" span-authority="audio"/>
  <mediaop:Prepare id="ranking-appear-media" source={ranking-appear-sfx}
    video="none" audio="default" span-authority="audio"/>
  <mediaop:Prepare id="ranking-move-media" source={ranking-move-sfx}
    video="none" audio="default" span-authority="audio"/>
  <space:Frame id="speech-frame" within={vertical.bounds}
    left="0%" top="0%" right="100%" bottom="100%"/>
  <space:Frame id="column-frame" within={vertical.bounds}
    left="0%" top="10%" right="26%" bottom="67.5%"/>

  <space:Extent id="pitch-pov-extent" width="2688" height="2016"/>
  <space:Extent id="ikea-sign-extent" width="2048" height="2048"/>
  <space:Extent id="retirement-room-extent" width="2688" height="2016"/>
  <space:Extent id="rent-jump-extent" width="2688" height="2016"/>
  <space:Extent id="nine-hundred-extent" width="2048" height="2048"/>
  <space:Extent id="laboratory-body-extent" width="2016" height="2688"/>
  <space:Extent id="museum-jawline-extent" width="2048" height="2048"/>

  <!-- These straight-edged cards occupy the same right-side stage as the
       active Column item. They have no border, rounded mask or sustain motion. -->
  <space:AspectFrame id="pitch-pov-frame" within={vertical.bounds}
    x="50%" y="72%" width="74%" aspect={pitch-pov-extent} anchor="center"/>
  <space:AspectFrame id="ikea-sign-frame" within={vertical.bounds}
    x="75%" y="79%" width="50%" aspect={ikea-sign-extent} anchor="center"/>
  <space:AspectFrame id="retirement-room-frame" within={vertical.bounds}
    x="52%" y="75%" width="88%" aspect={retirement-room-extent} anchor="center"/>
  <space:AspectFrame id="rent-jump-frame" within={vertical.bounds}
    x="52%" y="75%" width="78%" aspect={rent-jump-extent} anchor="center"/>
  <space:AspectFrame id="nine-hundred-frame" within={vertical.bounds}
    x="25%" y="72%" width="50%" aspect={nine-hundred-extent} anchor="center"/>
  <space:AspectFrame id="laboratory-body-frame" within={vertical.bounds}
    x="50%" y="68%" width="46%" aspect={laboratory-body-extent} anchor="center"/>
  <space:AspectFrame id="museum-jawline-frame" within={vertical.bounds}
    x="75%" y="78%" width="50%" aspect={museum-jawline-extent} anchor="center"/>

  <mediaop:Prepare id="messi-media" source={messi-take.video}
    video="primary-moving" audio="default" span-authority="video"/>
  <mediaop:Prepare id="ronaldo-media" source={ronaldo-take.video}
    video="primary-moving" audio="default" span-authority="video"/>
  <whisperx:Transcription id="messi-semantic-transcription" media={messi-media.media} language="en"/>
  <speechalign:Alignment id="messi-semantic" narrative={story}
    segment={story.segment.messi} domain={messi-media.domain} evidence={messi-semantic-transcription.transcript}/>
  <whisperx:Transcription id="ronaldo-semantic-transcription" media={ronaldo-media.media} language="en"/>
  <speechalign:Alignment id="ronaldo-semantic" narrative={story}
    segment={story.segment.ronaldo} domain={ronaldo-media.domain} evidence={ronaldo-semantic-transcription.transcript}/>

  <time:Timeline id="speech" clock={clock} end="ronaldo-semantic.end">
    <time:Window id="messi-semantic" from="start" for={messi-media.extent}/>
    <time:Window id="ronaldo-semantic" from="messi-semantic.end" for={ronaldo-media.extent}/>
  </time:Timeline>


  <semantic:Projection id="story-time" narrative={story} timeline={speech.timeline}>
    <semantic:Map alignment={messi-semantic.alignment} domain={messi-media.domain} window={speech.messi-semantic}/>
    <semantic:Map alignment={ronaldo-semantic.alignment} domain={ronaldo-media.domain} window={speech.ronaldo-semantic}/>
  </semantic:Projection>
  <semantic:Window id="segment-ronaldo" projection={story-time} during={story.segment.ronaldo}/>
  <semantic:Window id="segment-messi" projection={story-time} during={story.segment.messi}/>
  <semantic:Window id="selection-pitch-pov" projection={story-time} during={story.selection.pitch-pov}/>
  <semantic:Window id="selection-ikea-sign" projection={story-time} during={story.selection.ikea-sign}/>
  <semantic:Window id="selection-retirement-room" projection={story-time} during={story.selection.retirement-room}/>
  <semantic:Window id="selection-rent-jump" projection={story-time} during={story.selection.rent-jump}/>
  <semantic:Window id="selection-nine-hundred-goals" projection={story-time} during={story.selection.nine-hundred-goals}/>
  <semantic:Window id="selection-laboratory-body" projection={story-time} during={story.selection.laboratory-body}/>
  <semantic:Window id="selection-museum-jawline" projection={story-time} during={story.selection.museum-jawline}/>
  <audio:Track id="speech-sound" timeline={speech.timeline}>
    <audio:Clip id="messi-semantic-source" source={messi-media.media} during={speech.messi-semantic}/>
    <audio:Clip id="ronaldo-semantic-source" source={ronaldo-media.media} during={speech.ronaldo-semantic}/>
  </audio:Track>
  <visual:Motion id="broll-motion">
    <visual:Pose at="start" scale="0.7" opacity="0" easing="ease-out"/>
    <visual:Pose at="6f" scale="1" opacity="1"/>
    <visual:Pose at="end-4f" scale="1" opacity="1" easing="ease-in"/>
    <visual:Pose at="end" scale="1" opacity="0"/>
  </visual:Motion>

  <visual:Track id="speech-picture" timeline={speech.timeline}>
    <visual:Clip id="messi-semantic-source" media={messi-media.media} during={speech.messi-semantic} frame={speech-frame} fit="cover"/>
    <visual:Clip id="ronaldo-semantic-source" media={ronaldo-media.media} during={speech.ronaldo-semantic} frame={speech-frame} fit="cover"/>
  </visual:Track>
  <audio-track:Track id="music-bed" timeline={speech.timeline}>
    <audio-track:Clip source={soundtrack-media.media} during={speech.window}
      gain="0.12" fade-in="300ms" fade-out="600ms"/>
  </audio-track:Track>

  <fonts:Face id="display-font" package="@fontsource-variable/montserrat" weight="900" style="normal"/>
  <fonts:Face id="column-font" package="@fontsource-variable/inter" weight="700" style="normal"/>
  <ranking:ColumnStyle id="column-style" recipe={recipes.ranking.football-column}
    font={column-font}/>
  <ranking:Column id="football-column" timeline={speech.timeline}
    within={vertical.bounds} frame={column-frame} during={speech.window} style={column-style}
    appear-sound={ranking-appear-media.media}
    move-sound={ranking-move-media.media}>
    <ranking:ColumnItem id="ronaldo" rank="1" label="Ronaldo"
      icon={ronaldo-icon.image} during={segment-ronaldo}/>
    <ranking:ColumnItem id="mbappe" rank="2" label="Mbappe"
      preset="true" icon={mbappe-icon.image}/>
    <ranking:ColumnItem id="haaland" rank="3" label="Haaland"
      preset="true" icon={haaland-icon.image}/>
    <ranking:ColumnItem id="bellingham" rank="4" label="Bellingham"
      preset="true" icon={bellingham-icon.image}/>
    <ranking:ColumnItem id="de-bruyne" rank="5" label="De Bruyne"
      preset="true" icon={de-bruyne-icon.image}/>
    <ranking:ColumnItem id="yamal" rank="6" label="Yamal"
      preset="true" icon={yamal-icon.image}/>
    <ranking:ColumnItem id="kane" rank="7" label="Kane"
      preset="true" icon={kane-icon.image}/>
    <ranking:ColumnItem id="modric" rank="8" label="Modric"
      preset="true" icon={modric-icon.image}/>
    <ranking:ColumnItem id="neymar" rank="9" label="Neymar"
      preset="true" icon={neymar-icon.image}/>
    <ranking:ColumnItem id="messi" rank="10" label="Messi"
      icon={messi-icon.image} during={segment-messi}/>
  </ranking:Column>

  <visual:Track id="broll" timeline={speech.timeline}>
    <visual:Clip id="pitch-pov" image={broll-pitch-pov.image}
      extent={pitch-pov-extent} during={selection-pitch-pov}
      frame={pitch-pov-frame} fit="cover" treatment={recipes.media.pitch-pov}
      motion={broll-motion}/>
    <visual:Clip id="ikea-sign" image={broll-ikea-sign.image}
      extent={ikea-sign-extent} during={selection-ikea-sign}
      frame={ikea-sign-frame} fit="cover" treatment={recipes.media.ikea-sign}
      motion={broll-motion}/>
    <visual:Clip id="retirement-room" image={broll-retirement-room.image}
      extent={retirement-room-extent} during={selection-retirement-room}
      frame={retirement-room-frame} fit="cover" treatment={recipes.media.retirement-room}
      motion={broll-motion}/>
    <visual:Clip id="rent-jump" image={broll-rent-jump.image}
      extent={rent-jump-extent} during={selection-rent-jump}
      frame={rent-jump-frame} fit="cover" treatment={recipes.media.rent-jump}
      motion={broll-motion}/>
    <visual:Clip id="nine-hundred-goals" image={broll-nine-hundred.image}
      extent={nine-hundred-extent} during={selection-nine-hundred-goals}
      frame={nine-hundred-frame} fit="cover" treatment={recipes.media.nine-hundred}
      motion={broll-motion}/>
    <visual:Clip id="laboratory-body" image={broll-laboratory-body.image}
      extent={laboratory-body-extent} during={selection-laboratory-body}
      frame={laboratory-body-frame} fit="cover" treatment={recipes.media.laboratory-body}
      motion={broll-motion}/>
    <visual:Clip id="museum-jawline" image={broll-museum-jawline.image}
      extent={museum-jawline-extent} during={selection-museum-jawline}
      frame={museum-jawline-frame} fit="cover" treatment={recipes.media.museum-jawline}
      motion={broll-motion}/>
  </visual:Track>

  <caption-fine:Style id="caption-style" recipe={recipes.caption.primary}
    font={display-font}/>

  <narrative-caption:Timing id="caption-timing" document={story.caption} binding={story.caption-binding} projection={story-time}/>
  <caption-fine:Caption id="captions" document={story.caption} timing={caption-timing}
    timeline={speech.timeline} within={vertical.bounds}>
    <caption-fine:Use style={caption-style}/>
  </caption-fine:Caption>

  <film:Film id="main" canvas={vertical.canvas} timeline={speech.timeline}
    appearance={recipes.film.vertical}>
    <film:Track id="speech-picture" source={speech-picture.visual}/>
    <film:Track source={speech-sound.audio}/>
    <film:Track id="football-column" source={football-column.visual}/>
    <film:Track source={football-column.audio}/>
    <film:Track id="broll" source={broll.visual}/>
    <film:Track id="captions" source={captions.visual}/>
    <film:Track source={music-bed.audio}/>
  </film:Film>
  <html:Video id="final" composition={main.composition}
    timeline={speech.timeline}/>
</svml>
