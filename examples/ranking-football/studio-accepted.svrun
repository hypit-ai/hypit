<?svml using="@hypit/run-markup@1"?>
<svrun version="1">
  <author source="./reference.svml"/>
  <import from="@hypit/mock-media@1" as="mock"/>
  <import from="@hypit/semantic-take-estimate@1" as="estimate"/>
  <target output="final.video"/>
  <fragment id="mock-0" using="estimate:semantic-take"><input name="narrative" from="story"/><input name="segment" from="story.segment.ronaldo"/><input name="media" from="ronaldo-media.media"/><input name="policy" from="ronaldo-preview-duration.policy"/></fragment>
  <file id="mock-file-0" type="@hypit/artifact@1#BlobArtifact" from="./accepted/videos/1-1.mp4" media-type="video/mp4"/>
  <fragment id="mock-2" using="estimate:semantic-take"><input name="narrative" from="story"/><input name="segment" from="story.segment.messi"/><input name="media" from="messi-media.media"/><input name="policy" from="ronaldo-preview-duration.policy"/></fragment>
  <file id="mock-file-1" type="@hypit/artifact@1#BlobArtifact" from="./accepted/videos/1-2.mp4" media-type="video/mp4"/>
  <file id="mock-file-2" type="@hypit/artifact@1#BlobArtifact" from="./accepted/brolls/1-8.png" media-type="image/png"/>
  <file id="mock-file-3" type="@hypit/artifact@1#BlobArtifact" from="./accepted/brolls/1-7.png" media-type="image/png"/>
  <file id="mock-file-4" type="@hypit/artifact@1#BlobArtifact" from="./accepted/brolls/1-6.png" media-type="image/png"/>
  <file id="mock-file-5" type="@hypit/artifact@1#BlobArtifact" from="./accepted/brolls/1-5.png" media-type="image/png"/>
  <file id="mock-file-6" type="@hypit/artifact@1#BlobArtifact" from="./accepted/brolls/1-4.png" media-type="image/png"/>
  <file id="mock-file-7" type="@hypit/artifact@1#BlobArtifact" from="./accepted/brolls/1-3.png" media-type="image/png"/>
  <file id="mock-file-8" type="@hypit/artifact@1#BlobArtifact" from="./accepted/brolls/1-2.png" media-type="image/png"/>
  <file id="mock-file-9" type="@hypit/artifact@1#BlobArtifact" from="./accepted/brolls/1-1.png" media-type="image/png"/>
  <satisfy output="ronaldo-semantic.take" candidate="mock-0.take"/>
  <satisfy output="ronaldo-take.video" candidate="mock-file-0"/>
  <satisfy output="messi-semantic.take" candidate="mock-2.take"/>
  <satisfy output="messi-take.video" candidate="mock-file-1"/>
  <satisfy output="broll-hat-trick.image" candidate="mock-file-2"/>
  <satisfy output="broll-walks-around.image" candidate="mock-file-3"/>
  <satisfy output="broll-tired-dad-trophy.image" candidate="mock-file-4"/>
  <satisfy output="broll-penaldo-social.image" candidate="mock-file-5"/>
  <satisfy output="broll-greek-tragedy.image" candidate="mock-file-6"/>
  <satisfy output="broll-greek-god.image" candidate="mock-file-7"/>
  <satisfy output="broll-trophy.image" candidate="mock-file-8"/>
  <satisfy output="broll-hair-gel.image" candidate="mock-file-9"/>

</svrun>
