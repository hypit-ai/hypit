<!--
  SVML authoring golden fixture.
  Script, Film and HyperFrames Render Surfaces are implemented. The intervening
  generation, Speech and Track Surfaces remain the package-local design target.
-->
<svml>
  <import from="@svml/script@1"/>
  <import as="media" from="@svml/media@1"/>
  <import as="seedance" from="@svml/seedance@1"/>
  <import as="speech" from="@svml/speech@1"/>
  <import as="whisperx" from="@svml/whisperx@1"/>
  <import as="caption" from="@svml/caption-gemini@1"/>
  <import as="broll" from="@svml/broll@1"/>
  <import as="text" from="@svml/text-track@1"/>
  <import as="film" from="@svml/film@1"/>
  <import as="render" from="@svml/hyperframes-render@1"/>
  <import as="studio" from="./studio.svs" using="@svml/svs@1"/>

  <script>
    @alice-shot
    <opening>
      <ALICE> What if a video could be edited by meaning instead of a timeline?
    </opening>
    @/alice-shot

    @bob-shot
    <answer>
      <BOB> Then the script becomes the source. @product-demo
            <SVML | semantic video markup language> lets every visual know why it is there
            @/product-demo.
    </answer>
    @/bob-shot
  </script>

  <!-- Content and directions are declared once, before any generation uses them. -->
  <media:Image id="alice-reference" src="./assets/alice.png"/>
  <media:Image id="bob-reference" src="./assets/bob.png"/>
  <media:Image id="product-reference" src="./assets/product.png"/>

  <seedance:Prompt id="alice-direction">
    Locked medium close-up. Alice speaks directly to camera in a quiet daylight studio.
    Calm, curious delivery; natural breathing and restrained hand movement.
  </seedance:Prompt>

  <seedance:Prompt id="bob-direction">
    Locked medium close-up. Bob answers from a warm editorial workspace.
    Precise, assured delivery; hold eye contact and keep the background still.
  </seedance:Prompt>

  <seedance:Prompt id="product-direction">
    A clean vertical product film: the written script becomes semantic regions, then those
    regions assemble into a finished video. No readable UI text and no camera shake.
  </seedance:Prompt>

  <!-- The author explicitly chooses Seedance Mini. Runtime only binds a matching endpoint. -->
  <seedance:Speech
    id="alice-take"
    model="mini"
    script={script.segment.opening}
    prompt={alice-direction}
  >
    <seedance:Reference image={alice-reference} role="character"/>
  </seedance:Speech>

  <seedance:Speech
    id="bob-take"
    model="mini"
    script={script.segment.answer}
    prompt={bob-direction}
  >
    <seedance:Reference image={bob-reference} role="character"/>
  </seedance:Speech>

  <!-- Ordered generated Takes become one audio basis plus its peer visual/audio Tracks. -->
  <speech:Spine id="speech" narrative={script} appearance={studio.speech.full}>
    <speech:Take source={alice-take}/>
    <speech:Take source={bob-take}/>
  </speech:Spine>

  <!-- One explicit WhisperX path: request, normalize and deterministic Script alignment. -->
  <whisperx:Alignment id="timing" narrative={script} audio={speech.audio}/>

  <seedance:Video
    id="product-motion"
    model="mini"
    prompt={product-direction}
  >
    <seedance:Reference image={product-reference} role="subject"/>
  </seedance:Video>

  <broll:Track id="product-broll" map={timing.map}>
    <broll:Item
      source={product-motion.video}
      during={script.selection.product-demo}
      appearance={studio.broll.product}
    />
  </broll:Track>

  <!-- This imported package explicitly chooses Gemini cue planning; it cannot rewrite Script. -->
  <caption:Track
    id="captions"
    narrative={script}
    map={timing.map}
    grouping={studio.caption.short-cues}
    appearance={studio.caption.dialogue}
  >
    <caption:Role role="ALICE" appearance={studio.caption.alice}/>
    <caption:Role role="BOB" appearance={studio.caption.bob}/>
  </caption:Track>

  <text:Track id="titles" space={speech.space}>
    <text:Item
      text="EDIT MEANING, NOT TIMELINES"
      during="full"
      appearance={studio.text.title}
    />
  </text:Track>

  <!-- Child order is organizational. Every Present carries its own absolute stack position. -->
  <film:Film id="main" space={speech.space} appearance={studio.film.vertical}>
    <film:Track source={speech.visual}/>
    <film:Track source={speech.audioTrack}/>
    <film:Track source={product-broll.visual}/>
    <film:Track source={captions.track}/>
    <film:Track source={titles.track}/>
  </film:Film>

  <!-- Rendering is an explicit Hyperframes capability, not an implicit Film side effect. -->
  <render:Video id="final" composition={main.composition}/>
</svml>
