<?svml using="@narratage/text@1"?>

<!--
  SVML authoring golden fixture.
  All provider-free author Surfaces are implemented. This golden intentionally
  explicitly names caption-gemini because paid cue planning is author-selected,
  not a Runtime guess.
-->
<svml>
  <import from="@narratage/script@1"/>
  <import as="media" from="@narratage/media@1"/>
  <import as="seedance" from="@narratage/seedance@1"/>
  <import as="speech" from="@narratage/speech-spine@1"/>
  <import as="whisperx" from="@narratage/whisperx@1"/>
  <import as="caption" from="@narratage/caption@1"/>
  <import as="caption-fine" from="@narratage/caption-fine@1"/>
  <import as="caption-ai" from="@narratage/caption-gemini@1"/>
  <import as="pipeline" from="@narratage/media-pipeline@1"/>
  <import as="media-track" from="@narratage/media-track@1"/>
  <import as="text" from="@narratage/text-track@1"/>
  <import as="space" from="@narratage/spatial@1"/>
  <import as="film" from="@narratage/film@1"/>
  <import as="render" from="@narratage/render-hyperframes@1"/>
  <import as="studio" source="./studio.svs"/>

  <script>
    @alice-shot
    <opening>
      <ALICE> What if a video could be edited by meaning instead of a timeline?
    </opening>
    @/alice-shot

    @bob-shot
    <answer>
      <BOB> Then the script becomes the source. @product-demo
            <SVML | semantic video markup language> lets every visual know why it is there
            @/product-demo.
    </answer>
    @/bob-shot
  </script>

  <!-- Content and directions are declared once, before any generation uses them. -->
  <media:Image id="alice-reference" src="./assets/alice.png"/>
  <media:Image id="bob-reference" src="./assets/bob.png"/>
  <media:Image id="product-reference" src="./assets/product.png"/>

  <space:Canvas id="vertical" width="1080" height="1920"/>
  <space:Frame id="title-frame" within={vertical}
    left="6%" top="6%" right="6%" bottom="84%"/>
  <space:Frame id="product-frame" within={vertical}
    left="8%" top="20%" right="8%" bottom="32%"/>

  <seedance:Prompt id="alice-direction">
    Locked medium close-up. Alice speaks directly to camera in a quiet daylight studio.
    Calm, curious delivery; natural breathing and restrained hand movement.
  </seedance:Prompt>

  <seedance:Prompt id="bob-direction">
    Locked medium close-up. Bob answers from a warm editorial workspace.
    Precise, assured delivery; hold eye contact and keep the background still.
  </seedance:Prompt>

  <seedance:Prompt id="product-direction">
    A clean vertical product film: the written script becomes semantic regions, then those
    regions assemble into a finished video. No readable UI text and no camera shake.
  </seedance:Prompt>

  <!-- Complete styles are declared once. Selection and use remain separate. -->
  <caption-fine:Style id="dialogue-caption" recipe={studio.caption.dialogue}/>

  <caption-fine:Style id="alice-caption" recipe={studio.caption.alice}/>

  <caption-fine:Style id="bob-caption" recipe={studio.caption.bob}/>

  <caption:Program id="caption-program" display={script.caption} default={dialogue-caption}>
    <caption:Use role="ALICE" style={alice-caption}/>
    <caption:Use role="BOB" style={bob-caption}/>
    <!-- Ordered whole-style replacement: no complement Selection is required. -->
    <caption:Use words={script.caption.selection.product-demo} style={dialogue-caption}/>
  </caption:Program>

  <caption-ai:Planner
    id="caption-plan"
    display={script.caption}
    program={caption-program}
    model="gemini-2.5-flash"
  />

  <!-- The author explicitly chooses Seedance Mini. Runtime only binds a matching endpoint. -->
  <seedance:Speech
    id="alice-take"
    model="mini"
    dialogue={script.segment.opening.dialogue}
    prompt={alice-direction}
    duration="8"
  >
    <seedance:Reference image={alice-reference} role="character"/>
  </seedance:Speech>

  <seedance:Speech
    id="bob-take"
    model="mini"
    dialogue={script.segment.answer.dialogue}
    prompt={bob-direction}
    duration="8"
  >
    <seedance:Reference image={bob-reference} role="character"/>
  </seedance:Speech>

  <!-- Ordered generated Takes become one audio basis plus its peer visual/audio Tracks. -->
  <speech:Spine id="speech" canvas={vertical}>
    <speech:Take source={alice-take} segment={script.segment.opening}/>
    <speech:Take source={bob-take} segment={script.segment.answer}/>
  </speech:Spine>

  <!-- One explicit WhisperX path: request, normalize and deterministic Script alignment. -->
  <whisperx:Alignment id="timing" narrative={script} audio={speech.audio}/>

  <seedance:Video
    id="product-motion"
    model="mini"
    prompt={product-direction}
    duration="5"
  >
    <seedance:Reference image={product-reference} role="subject"/>
  </seedance:Video>

  <pipeline:Normalize id="product-media" source={product-motion.video}
    video="primary-moving" audio="none" span-authority="video" frame-rate="30"/>

  <media-track:Track id="product-broll" map={timing.map}
    space={speech.space} canvas={vertical}>
    <media-track:Item
      source={product-media.media}
      during={script.selection.product-demo}
      frame={product-frame}
      appearance={studio.media.product}
      motion={studio.motion.product}
    />
  </media-track:Track>

  <!-- This imported package explicitly chooses Gemini cue planning; it cannot rewrite Script. -->
  <caption-fine:Track
    id="captions"
    display={script.caption}
    correspondence={script.caption.correspondence}
    map={timing.map}
    space={speech.space}
    program={caption-program}
    plan={caption-plan.plan}
  />

  <text:Track id="titles" space={speech.space}>
    <text:Item
      text="EDIT MEANING, NOT TIMELINES"
      during="full"
      frame={title-frame}
      appearance={studio.text.title}
    />
  </text:Track>

  <!-- Child order is organizational. Every Present carries its own absolute stack position. -->
  <film:Film id="main" canvas={vertical} space={speech.space} appearance={studio.film.vertical}>
    <film:Track source={speech.visual}/>
    <film:Track source={speech.audioTrack}/>
    <film:Track source={product-broll.visual}/>
    <film:Track source={captions.track}/>
    <film:Track source={titles.track}/>
  </film:Film>

  <!-- Rendering is an explicit Hyperframes capability, not an implicit Film side effect. -->
  <render:Video id="final" composition={main.composition}/>
</svml>
