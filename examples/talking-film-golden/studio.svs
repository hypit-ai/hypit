<?svml using="@narratage/svs@1"?>

<sheet version="1" id="studio">

  /* Exact font bytes become FontArtifactRef values during author lowering. */
  font.inter-semibold {
    src: ./assets/Inter-SemiBold.woff2;
    weight: 600;
    style: normal;
  }

  font.inter-black {
    src: ./assets/Inter-Black.woff2;
    weight: 900;
    style: normal;
  }

  film.vertical {
    background: #09090B;
  }

  speech.full {
    stack-order: 10;
    x: 0;
    y: 0;
    width: 1;
    height: 1;
    fit: cover;
  }

  media.product {
    stack-order: 40;
    fit: contain;
    playback: hold-start;
    frame-paint: #111116;
    clip: rounded;
    radius: 28;
  }

  motion.product {
    enter: slide;
    enter-frames: 8;
    enter-direction: up;
    enter-easing: ease-out;
    exit: fade;
    exit-frames: 6;
    exit-easing: ease-in;
  }

  caption.short-cues {
    model: gemini-2.5-flash;
    max-words: 5;
    max-lines: 2;
  }

  caption.dialogue {
    cue-min-words: 2;
    cue-max-words: 5;
    stack-order: 70;
    x: 0.08;
    y: 0.76;
    width: 0.84;
    size: 58;
    line-height: 0.96;
    align: center;
    fill: #FFFFFF;
    background: #09090BCC;
    padding: 16 24;
    radius: 18;
  }

  caption.alice {
    cue-min-words: 2;
    cue-max-words: 5;
    stack-order: 70;
    x: 0.08;
    y: 0.76;
    width: 0.84;
    size: 58;
    line-height: 0.96;
    align: center;
    fill: #73FBD3;
    background: #09090BCC;
    padding: 16 24;
    radius: 18;
  }

  caption.bob {
    cue-min-words: 2;
    cue-max-words: 5;
    stack-order: 70;
    x: 0.08;
    y: 0.76;
    width: 0.84;
    size: 58;
    line-height: 0.96;
    align: center;
    fill: #FFD166;
    background: #09090BCC;
    padding: 16 24;
    radius: 18;
  }

  text.title {
    stack-order: 90;
    weight: 900;
    size: 64;
    align: center;
    fill: #FFFFFF;
    tracking: -1;
  }

</sheet>
