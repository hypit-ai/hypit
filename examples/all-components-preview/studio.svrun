<?svml using="@hypit/run-markup@1"?>

<svrun version="1">
  <author source="./main.svml"/>
  <target output="final.video"/>

  <!-- Studio opens only from explicit, already materialized projection inputs.
       These two files also make the exact media bytes referenced by the
       SemanticTake candidates available to HyperFrames. -->
  <file id="studio-opening-video" type="@hypit/artifact@1#BlobArtifact"
    from="../../docs/public/regen-ranking/avatar-1.mp4" media-type="video/mp4"/>
  <file id="studio-closing-video" type="@hypit/artifact@1#BlobArtifact"
    from="../../docs/public/regen-ranking/avatar-2.mp4" media-type="video/mp4"/>

  <value id="studio-opening-take" type="@hypit/speech@1#SemanticTake"
    from="./fixtures/studio-opening-take.json"/>
  <value id="studio-closing-take" type="@hypit/speech@1#SemanticTake"
    from="./fixtures/studio-closing-take.json"/>
  <value id="studio-caption-plan" type="@hypit/caption@1#CaptionPlan"
    from="./fixtures/studio-caption-plan.json"/>

  <satisfy output="opening-semantic.take" candidate="studio-opening-take"/>
  <satisfy output="closing-semantic.take" candidate="studio-closing-take"/>
  <satisfy output="cue-plan.plan" candidate="studio-caption-plan"/>
</svrun>
