<?svml using="@narratage/svs@1"?>

<sheet version="1">
  film.vertical { background: #05060a; }
  speech.visual { fit: cover; }

  /* The board: a dark panel on the left third, one row per app, filling from the
     bottom rank upward as each name is spoken. */
  ranking.board {
    board-background: #070810EF;
    board-border-color: #FFFFFF2E; board-border-width: 1; board-radius: 6;
    board-shadow-x: 0; board-shadow-y: 6; board-shadow-blur: 18; board-shadow-spread: 0;
    board-shadow-color: #00000059;
    rank-colors: #ff3f56|#ffa72d|#eadc2a|#84c654|#31add0;
    padding: 18; row-height: 74; row-gap: 10;
    icon-size: 58; icon-radius: 13; icon-fit: contain;
    stage-x: 0.5; stage-y: 0.5; stage-size: 96;
    font-size: 34; font-weight: 900; text-color: #FFFFFF; line-height: 1.1;
    appear-frames: 11; move-frames: 13; motion-easing: ease-out;
    board-stack: 20; item-stack: 30; stage-stack: 25;
  }

  /* A cutaway replaces the shot, so it carries no box treatment. */
  /* A card sits inside the picture, so it keeps a box treatment. */
  /* A deck: the card being spoken about sits front, the ones before and after
     it stepping back behind it. */
  deck.stack {
    visible-previous: 2; visible-next: 2;
    current-x: 0.5; current-y: 0.5; current-scale: 1; current-opacity: 1; current-stacking: 50;
    previous-x-step: -0.16; previous-scale-step: 0.86; previous-opacity-step: 0.7;
    previous-rotation-step: -5; previous-stacking-step: -6;
    next-x-step: 0.16; next-scale-step: 0.86; next-opacity-step: 0.7;
    next-rotation-step: 5; next-stacking-step: -6;
    reflow-frames: 9; reflow-easing: ease-out;
  }

  media.card {
    stack-order: 60; fit: cover; clip: rounded; radius: 18; padding: 10 10;
    frame-paint: #14141c;
  }
  motion.card {
    enter: fade; enter-frames: 2; enter-easing: linear;
    exit: fade; exit-frames: 2; exit-easing: linear;
  }

  text.title {
    stack-order: 90;
    weight: 900; size: 62; align: center; fill: #FFFFFF; tracking: -1;
    padding: 14 22;
  }

  caption.base {
    cue-min-words: 1; cue-max-words: 3;
    stack-order: 70; x: 0.68; y: 0.56; width: 0.6; anchor-x: center; anchor-y: top;
    size: 50; line-height: 1.05; align: center;
    fill: #FFFFFF; stroke-color: #05060A; stroke-width: 2;
    shadow-color: #000000; shadow-opacity: 0.72; shadow-x: 0; shadow-y: 2; shadow-blur: 6;
    background: #00000000; border-color: #00000000; border-width: 0; padding: 0 0; radius: 0;
    karaoke: current; karaoke-transition: step; active-fill: #FFD34A;
    cue-enter: fade; cue-enter-frames: 2; cue-exit: fade; cue-exit-frames: 2;
  }
</sheet>
