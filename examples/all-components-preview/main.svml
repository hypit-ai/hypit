<?svml using="@hypit/markup@1"?>

<svml>
  <import from="@hypit/script@1"/>
  <import as="wording" from="@hypit/text@1"/>
  <import as="seedance" from="@hypit/seedance@1"/>
  <import as="media" from="@hypit/media@1"/>
  <import as="pipeline" from="@hypit/media-pipeline@1"/>
  <import as="gpt" from="@hypit/gpt-image@1"/>
  <import as="speech" from="@hypit/speech-track@1"/>
  <import as="whisperx" from="@hypit/whisperx@1"/>
  <import as="media-track" from="@hypit/media-track@1"/>
  <import as="ranking" from="@hypit/ranking@1"/>
  <import as="screen" from="@hypit/screen-overlay@1"/>
  <import as="deck" from="@hypit/deck-track@1"/>
  <import as="caption" from="@hypit/caption@1"/>
  <import as="caption-fine" from="@hypit/caption-fine@1"/>
  <import as="caption-ai" from="@hypit/caption-gemini@1"/>
  <import as="fonts" from="@hypit/fonts-open@1"/>
  <import as="text" from="@hypit/typography-track@1"/>
  <import as="space" from="@hypit/spatial@1"/>
  <import as="program" from="@hypit/program-space@1"/>
  <import as="film" from="@hypit/film@1"/>
  <import as="render" from="@hypit/render-hyperframes@1"/>
  <import as="recipes" source="./recipes.svs"/>

  <!-- One Script, written so every Track below is placed by something said
       rather than by a timecode: a Segment per take, a Selection per cutaway
       and per board row, and Moments for the deck. -->
  <script id="story">
    <opening>
      <HOST>@board This is every component at once. @title A card cuts in
        here@/title, @overlay the picture flashes@/overlay, and the board fills
        as each one is named.
      <HOST>@spatial Spatial.@/spatial @deal-one! @typography Typography.@/typography @deal-two!
    </opening>
    <closing>
      <HOST>@ranking Ranking.@/ranking @deal-three! @captions Captions.@/captions @deal-four!
      <HOST>That is the whole of it@/board. @done!
    </closing>
  </script>

  <space:Canvas id="vertical" width="1080" height="1920"/>
  <program:Clock id="clock" frame-rate="30"/>
  <space:Frame id="full" within={vertical} left="0%" top="0%" right="100%" bottom="100%"/>
  <!-- A board fills from its bottom edge upward, so the Frame is sized to the
       rows it holds: four rows, three gaps and the Recipe's padding. A taller
       Frame would leave the rows floating at the bottom of an empty box. -->
  <space:Frame id="board-frame" within={vertical} left="4%" top="14%" right="38%" bottom="32.85%"/>
  <space:Frame id="card-frame" within={vertical} left="10%" top="60%" right="90%" bottom="86%"/>
  <space:Frame id="title-frame" within={vertical} left="0%" top="6%" right="100%" bottom="13%"/>

  <!-- A generated take, so the preview has something with no material behind it
       and a reference picture to stand in with. -->
  <wording:Value id="direction">A presenter talking straight to camera, plain background.</wording:Value>
  <wording:Value id="look">A friendly presenter in a plain grey studio, waist up, facing camera,
    soft even light, neutral expression.</wording:Value>
  <gpt:Image id="presenter" prompt={look} aspect-ratio="9:16" resolution="2K"/>
  <seedance:ReferenceVideo id="take-opening" model="mini" prompt={direction} duration="8"
    generate-audio="true">
    <seedance:Reference image={presenter.image}/>
  </seedance:ReferenceVideo>
  <seedance:ReferenceVideo id="take-closing" model="mini" prompt={direction} duration="8"
    generate-audio="true">
    <seedance:Reference image={presenter.image}/>
  </seedance:ReferenceVideo>

  <!-- Pictures on disk, so the Media Track and the board have real material. -->
  <media:Image id="card-shot" src="./fixtures/card.svg" media-type="image/svg+xml"/>
  <media:Image id="icon-spatial" src="./fixtures/icon.svg" media-type="image/svg+xml"/>
  <media:Image id="icon-type" src="./fixtures/icon.svg" media-type="image/svg+xml"/>
  <media:Image id="icon-ranking" src="./fixtures/icon.svg" media-type="image/svg+xml"/>
  <media:Image id="icon-caption" src="./fixtures/icon.svg" media-type="image/svg+xml"/>
  <space:Extent id="portrait" width="540" height="960"/>
  <space:Extent id="square" width="192" height="192"/>

  <pipeline:Normalize id="opening-media" source={take-opening.video}
    video="primary-moving" audio="default" span-authority="video" clock={clock}/>
  <pipeline:Normalize id="closing-media" source={take-closing.video}
    video="primary-moving" audio="default" span-authority="video" clock={clock}/>
  <whisperx:SemanticTake id="opening-semantic" narrative={story}
    segment={story.segment.opening} media={opening-media.media}/>
  <whisperx:SemanticTake id="closing-semantic" narrative={story}
    segment={story.segment.closing} media={closing-media.media}/>

  <speech:Track id="speech"
    visual-frame={full} visual-appearance={recipes.speech.visual} visual-z="0">
    <speech:Take source={opening-semantic.take}/>
    <speech:Take source={closing-semantic.take}/>
  </speech:Track>

  <fonts:Stack id="ui-font" family="inter" weight="700" style="normal"/>

  <!-- A board whose overall lifetime and per-row reveal windows both come
       directly from Selections in the Script. -->
  <ranking:ColumnStyle id="board-style" recipe={recipes.ranking.board} font={ui-font}/>
  <ranking:Column id="board" semantic={speech.semantic} canvas={vertical} frame={board-frame}
    during={story.selection.board} style={board-style}>
    <ranking:ColumnItem id="row-spatial" rank="1" label="Spatial" icon={icon-spatial}
      during={story.selection.spatial}/>
    <ranking:ColumnItem id="row-type" rank="2" label="Typography" icon={icon-type}
      during={story.selection.typography}/>
    <ranking:ColumnItem id="row-ranking" rank="3" label="Ranking" icon={icon-ranking}
      during={story.selection.ranking}/>
    <ranking:ColumnItem id="row-caption" rank="4" label="Captions" icon={icon-caption}
      during={story.selection.captions}/>
  </ranking:Column>

  <!-- A card, held for exactly as long as its Selection is spoken. -->
  <media-track:Track id="cards" semantic={speech.semantic} canvas={vertical}>
    <media-track:Item id="card" image={card-shot} extent={portrait}
      during={story.selection.title} frame={card-frame}
      appearance={recipes.media.card} motion={recipes.motion.card}/>
  </media-track:Track>

  <!-- A treatment over the whole picture, placed by a Selection like anything else. -->
  <screen:Track id="effects" semantic={speech.semantic} canvas={vertical}>
    <screen:Flash during={story.selection.overlay} z="80"
      color="#ffffff" intensity="0.6" attack="2" hold="2" decay="6"/>
  </screen:Track>

  <!-- A deck, one card per board row, stepping forward as each is named. The
       preview was never taught about this Track; it appears because the package
       produces one. -->
  <space:Frame id="deck-frame" within={vertical} left="44%" top="60%" right="98%" bottom="88%"/>
  <deck:DepthStack id="deck" semantic={speech.semantic} canvas={vertical}
    frame={deck-frame} appearance={recipes.deck.stack} until={story.moment.done}>
    <deck:Card id="card-spatial" source={icon-spatial} extent={square} at={story.moment.deal-one}/>
    <deck:Card id="card-type" source={icon-type} extent={square} at={story.moment.deal-two}/>
    <deck:Card id="card-ranking" source={icon-ranking} extent={square} at={story.moment.deal-three}/>
    <deck:Card id="card-caption" source={icon-caption} extent={square} at={story.moment.deal-four}/>
  </deck:DepthStack>

  <text:Style id="title-style" recipe={recipes.text.title} font={ui-font}/>
  <text:Track id="titles" semantic={speech.semantic}>
    <text:Area id="headline" placement={title-frame} style={title-style} during="program">
      EVERY COMPONENT AT ONCE
    </text:Area>
  </text:Track>

  <caption-fine:Style id="base-caption" recipe={recipes.caption.base} font={ui-font}/>
  <caption:Program id="caption-program" display={story.caption} default={base-caption}/>
  <caption-ai:Planner id="cue-plan" display={story.caption} program={caption-program}
    model="gemini-2.5-flash"/>
  <caption-fine:Track id="captions" display={story.caption}
    correspondence={story.caption.correspondence}
    semantic={speech.semantic}
    plan={cue-plan.plan} program={caption-program}/>

  <film:Film id="main" canvas={vertical} semantic={speech.semantic} appearance={recipes.film.vertical}>
    <film:Track source={speech.visual}/>
    <film:Track source={speech.audio}/>
    <film:Track source={board.visual}/>
    <film:Track source={cards.visual}/>
    <film:Track source={effects.track}/>
    <film:Track source={deck.track}/>
    <film:Track source={titles.track}/>
    <film:Track source={captions.track}/>
  </film:Film>
  <render:Video id="final" composition={main.composition} semantic={speech.semantic}/>
</svml>
