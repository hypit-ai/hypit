<?svml using="@hypit/run-markup@1"?>

<svrun version="1">
  <author source="./main.svml"/>
  <target output="final.video"/>

  <!-- The presenter frame this project generated, kept beside the Source so a
       preview shows the real shot without reaching for a Runtime. -->
  <file id="accepted-presenter" type="@hypit/artifact@1#BlobArtifact"
    from="./assets/presenter.png" media-type="image/png"/>
  <satisfy output="presenter.image" candidate="accepted-presenter"/>
</svrun>
