<?svml using="@narratage/run-markup@1"?>

<svrun version="1">
  <author source="./main.svml"/>
  <target output="final.video"/>

  <!-- The presenter frame this project already generated. Naming the Build is
       how a Source reuses an accepted shot; there is no path to write. -->
  <build-record id="accepted-presenter"
    build="sha256:6aea2d417b84985d09824ab9621939925854dc5fe7a8c606ce9aba8b14ef4191"
    output="presenter.image"/>
  <satisfy output="presenter.image" candidate="accepted-presenter"/>
</svrun>
