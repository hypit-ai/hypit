<?svml using="@hypit/markup@1"?>
<svml>
  <import as="time" from="@hypit/timeline-author@1"/>
  <import as="spatial" from="@hypit/spatial@1"/>
  <import as="media" from="@hypit/media@1"/>
  <import as="fonts" from="@hypit/fontsource@1"/>
  <import as="chat" from="@example/chat-scene@1"/>
  <import as="film" from="@hypit/film@1"/>
  <import as="html" from="@hypit/html-video@1"/>
  <import as="style" source="./chat.svs"/>

  <time:Clock id="animation-clock" frame-rate="30"/>
  <time:Timeline id="animation" clock={animation-clock} end="8s">
    <time:Instant id="question" at="0.5s"/>
    <time:Instant id="reply" at="2s"/>
    <time:Instant id="turn" at="3.5s"/>
    <time:Instant id="reveal" at="5.2s"/>
  </time:Timeline>
  <spatial:Canvas id="canvas" width="540" height="960"/>
  <fonts:Face id="font-face" package="@fontsource-variable/inter" weight="600" style="normal"/>
  <media:FontStack id="font" primary={font-face}/>
  <chat:Scene id="conversation" timeline={animation.timeline} within={canvas.bounds} font={font}
    during={animation.window} title="Launch crew">
    <chat:Message id="question" sender="Maya" side="left" at={animation.question} text="Are we ready to launch?"/>
    <chat:Message id="reply" sender="Leo" side="right" at={animation.reply} text="The video is ready."/>
    <chat:Message id="turn" sender="Maya" side="left" at={animation.turn} text="Great. One tiny change..."/>
    <chat:Message id="reveal" sender="Leo" side="right" at={animation.reveal} text="I left the whole scene editable."/>
  </chat:Scene>
  <film:Film id="main" canvas={canvas.canvas} timeline={animation.timeline} appearance={style.film.main}>
    <film:Track id="conversation" source={conversation.visual}/>
  </film:Film>
  <html:Video id="final" composition={main.composition}/>
</svml>
