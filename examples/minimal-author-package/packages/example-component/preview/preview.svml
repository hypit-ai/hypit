<?svml using="@hypit/markup@1"?>

<!-- A complete catalogue Source. Its Run is ordinary: Studio can open it once the required media
     Candidates are supplied, and a normal Build of the same Run can regenerate the catalogue frame. -->
<svml>

  <import as="media" from="@hypit/media@1"/>
  <import as="visual" from="@hypit/visual-track@1"/>
  <import as="audio" from="@hypit/audio-track@1"/>
  <import from="@hypit/script@1"/>
  <import as="wording" from="@hypit/text@1"/>
  <import as="seedance" from="@hypit/seedance@1"/>
  <import as="mediaop" from="@hypit/media-operations@1"/>
  <import as="time" from="@hypit/timeline-author@1"/>
  <import as="whisperx" from="@hypit/whisperx@1"/>
  <import as="speechalign" from="@hypit/narrative-speech-alignment@1"/>
  <import as="semantic" from="@hypit/narrative-temporal@1"/>
  <import as="space" from="@hypit/spatial@1"/>
  <import as="film" from="@hypit/film@1"/>
  <import as="html" from="@hypit/html-video@1"/>
  <import as="example" from="@example/example-component@1"/>
  <import as="recipes" source="./recipes.svs"/>

  <script id="story">
    <showcase><HOST>A deterministic example surface for the package catalogue.</showcase>
  </script>

  <space:Canvas id="vertical" width="720" height="1280"/>
  <time:Clock id="clock" frame-rate="30"/>
  <space:Frame id="speech-frame" within={vertical.bounds} left="0%" top="0%" right="100%" bottom="100%"/>

  <wording:Value id="direction">A neutral catalogue card in a quiet studio.</wording:Value>
  <seedance:TextVideo id="take" model="mini" prompt={direction} duration="4" generate-audio="true"/>
  <mediaop:Prepare id="take-media" source={take.video} recipe={recipes.media.aroll}/>
  <whisperx:Transcription id="showcase-semantic-transcription" media={take-media.media} language="en"/>
  <speechalign:Alignment id="showcase-semantic" narrative={story}
    segment={story.segment.showcase} domain={take-media.domain} evidence={showcase-semantic-transcription.transcript}/>
  <time:Timeline id="speech" clock={clock} end="showcase-semantic.end">
    <time:Window id="showcase-semantic" from="start" for={take-media.extent}/>
  </time:Timeline>


  <semantic:Projection id="story-time" narrative={story} timeline={speech.timeline}>
    <semantic:Map alignment={showcase-semantic.alignment} domain={take-media.domain} window={speech.showcase-semantic}/>
  </semantic:Projection>
  <audio:Track id="speech-sound" timeline={speech.timeline}>
    <audio:Clip id="showcase-semantic-source" source={take-media.media} during={speech.showcase-semantic}/>
  </audio:Track>
  <visual:Track id="speech-picture" timeline={speech.timeline}>
    <visual:Clip id="showcase-semantic-source" media={take-media.media} during={speech.showcase-semantic} frame={speech-frame} fit="cover"/>
  </visual:Track>

  <example:Box id="box" timeline={speech.timeline} within={vertical.bounds}/>
  <film:Film id="main" canvas={vertical.canvas} timeline={speech.timeline} appearance={recipes.film.vertical}>
    <film:Track id="speech-picture" source={speech-picture.visual}/>
    <film:Track source={speech-sound.audio}/>
    <film:Track id="box" source={box.visual}/>
  </film:Film>
  <html:Video id="final" composition={main.composition} timeline={speech.timeline}/>
</svml>
