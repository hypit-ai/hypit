<?svml using="@hypit/markup@1"?>

<!-- A complete, self-contained catalogue Source. The generated take is preview-mocked; the
     remaining deterministic graph is compiled and rendered through the normal Studio path. -->
<svml>
  <import from="@hypit/script@1"/>
  <import as="wording" from="@hypit/text@1"/>
  <import as="seedance" from="@hypit/seedance@1"/>
  <import as="pipeline" from="@hypit/media-pipeline@1"/>
  <import as="speech" from="@hypit/speech-track@1"/>
  <import as="whisperx" from="@hypit/whisperx@1"/>
  <import as="estimate" from="@hypit/estimate@1"/>
  <import as="space" from="@hypit/spatial@1"/>
  <import as="program" from="@hypit/program-space@1"/>
  <import as="film" from="@hypit/film@1"/>
  <import as="render" from="@hypit/render-hyperframes@1"/>
  <import as="example" from="@example/example-component@1"/>
  <import as="recipes" source="./recipes.svs"/>

  <script id="story">
    <showcase><HOST>A deterministic example surface for the package catalogue.</showcase>
  </script>

  <space:Canvas id="vertical" width="720" height="1280"/>
  <program:Clock id="clock" frame-rate="30"/>
  <space:Frame id="speech-frame" within={vertical} left="0%" top="0%" right="100%" bottom="100%"/>

  <wording:Value id="direction">A neutral catalogue card in a quiet studio.</wording:Value>
  <estimate:Speech id="showcase-duration" source={story.segment.showcase.speech} policy={recipes.speech.normal}/>
  <seedance:TextVideo id="take" model="mini" prompt={direction} duration={showcase-duration.duration} generate-audio="true"/>
  <pipeline:Normalize id="take-media" source={take.video} recipe={recipes.media.aroll} clock={clock}/>
  <whisperx:SemanticTake id="showcase-semantic" narrative={story} segment={story.segment.showcase} media={take-media.media} language="en"/>
  <speech:Track id="speech" visual-frame={speech-frame} visual-appearance={recipes.speech.visual} visual-z="0">
    <speech:Take source={showcase-semantic.take}/>
  </speech:Track>

  <example:Box id="box" semantic={speech.semantic}/>
  <film:Film id="main" canvas={vertical} semantic={speech.semantic} appearance={recipes.film.vertical}>
    <film:Track source={speech.visual}/>
    <film:Track source={speech.audio}/>
    <film:Track source={box.track}/>
  </film:Film>
  <render:Video id="final" composition={main.composition} semantic={speech.semantic}/>
</svml>
