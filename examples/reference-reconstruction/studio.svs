<?svml using="@hypit/svs@1"?>

<sheet version="1" id="studio">
  speech.normal {
    language: en;
    pace: normal;
    min: 4;
    max: 15;
    rounding: round;
  }

  speaker.host {
    composition-stability: soft-locked;
    camera-motion: none;
    edit-rhythm: continuous-take;
    performance: natural-explainer;
    gesture: natural;
  }

  film.vertical {
    background: #09090B;
  }

  speech.visual { fit: cover; }

  caption.primary {
    cue-min-words: 2;
    cue-max-words: 7;
    stack-order: 70;
    x: 0.5;
    y: 0.8;
    anchor-x: center;
    anchor-y: bottom;
    width: 0.9;
    size: 46;
    line-height: 1;
    align: center;
    fill: #FFFFFF;
    stroke-color: #09090B;
    stroke-width: 5;
    shadow-color: #000000;
    shadow-opacity: 0.6;
    shadow-x: 0;
    shadow-y: 3;
    shadow-blur: 8;
    background: #09090B66;
    padding: 8 16;
    radius: 10;
  }

  linerank.board {
    paper-background: #F7F7F4;
    rule-color: #D8DEE6;
    rule-gap: 64;
    title-size: 40;
    title-weight: 700;
    title-color: #111111;
    title-line-height: 1.15;
    number-size: 34;
    number-weight: 600;
    number-color: #222222;
    label-size: 38;
    label-weight: 500;
    label-color: #111111;
    label-line-height: 1.2;
    top-padding: 188;
    left-padding: 56;
    right-padding: 40;
    row-height: 74;
    row-gap: 12;
    number-width: 66;
    type-frames-per-char: 4;
    circle-color: #111111;
    circle-width: 4;
    circle-frames: 20;
    board-stack: 20;
    row-stack: 30;
    circle-stack: 40;
  }

  media.product {
    stack-order: 45;
    fit: contain;
    frame-paint: #111116;
    clip: rounded;
    radius: 24;
    border-width: 1;
    border-style: solid;
    border-color: #FFFFFF30;
    shadows: 0 10 24 0 #00000066;
  }

  motion.product {
    enter: slide;
    enter-frames: 6;
    enter-direction: up;
    enter-easing: ease-out;
    exit: fade;
    exit-frames: 6;
    exit-easing: ease-in;
  }

  media.thumb {
    stack-order: 42;
    fit: cover;
    frame-paint: #111116;
    clip: rounded;
    radius: 16;
    border-width: 1;
    border-style: solid;
    border-color: #FFFFFF30;
    shadows: 0 10 24 0 #00000066;
  }

  motion.thumb {
    enter: pop;
    enter-frames: 5;
    enter-easing: ease-out;
    exit: fade;
    exit-frames: 4;
    exit-easing: ease-in;
  }
</sheet>
