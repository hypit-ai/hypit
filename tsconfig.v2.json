{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    "rootDir": ".",
    "baseUrl": ".",
    "paths": {
      "@svml/protocol": ["packages/protocol/src/index.ts"],
      "@svml/core": ["packages/core/src/index.ts"],
      "@svml/contracts": ["packages/contracts/src/index.ts"],
      "@svml/driver-node": ["packages/driver-node/src/index.ts"],
      "@svml/script": ["packages/script/src/index.ts"],
      "@svml/text": ["packages/text/src/index.ts"],
      "@svml/speech-align": ["packages/speech-align/src/index.ts"],
      "@svml/whisperx": ["packages/whisperx/src/index.ts"],
      "@svml/caption": ["packages/caption/src/index.ts"],
      "@svml/speech-take": ["packages/speech-take/src/index.ts"],
      "@svml/elaborator": ["packages/elaborator/src/index.ts"],
      "@svml/realization": ["packages/realization/src/index.ts"],
      "@svml/video-fragments": ["packages/video-fragments/src/index.ts"]
    }
  },
  "include": ["packages/**/*.ts"],
  "exclude": ["dist", "node_modules", "packages/*/dist"]
}
