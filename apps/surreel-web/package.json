{
  "name": "@surreel/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.json --noEmit && vite build",
    "preview": "vite preview",
    "check": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "selftest": "bash scripts/self-test.sh",
    "e2e": "node scripts/e2e.mjs",
    "pack:hypit": "node scripts/pack-hypit-skills.mjs",
    "pack:cc": "node scripts/pack-cc-skills.mjs",
    "pack:skills": "node scripts/pack-hypit-skills.mjs && node scripts/pack-cc-skills.mjs",
    "deploy": "node scripts/pack-hypit-skills.mjs && node scripts/pack-cc-skills.mjs && vite build && wrangler deploy"
  },
  "dependencies": {
    "@phosphor-icons/react": "^2.1.10",
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.2",
    "jsdom": "^26.1.0",
    "typescript": "^5.9.2",
    "vite": "^7.1.5",
    "vitest": "^3.2.4",
    "wrangler": "^4.131.2"
  }
}
